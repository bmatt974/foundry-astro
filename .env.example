# Foundry CMS API base URL (no trailing slash).
FOUNDRY_API_URL=http://foundry-cms.test/api/v1

# Optional — preview token forwarded as X-Preview-Token. Set in
# dev/staging only; production should never serve drafts.
# FOUNDRY_PREVIEW_TOKEN=

# Multi-tenant routing dispatches by the HTTP Host header against
# WebsiteLocale.hostname rows in the backend. No FOUNDRY_WEBSITE_SLUG
# env var is needed — set up hostnames via `valet proxy` (see
# docs/multi-tenant-dev.md once phase 3 lands) and ensure a matching
# website_locales row exists in the backend.
