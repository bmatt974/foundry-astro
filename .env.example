# Foundry CMS API base URL (no trailing slash).
FOUNDRY_API_URL=http://foundry-cms.test/api/v1

# Optional — preview token forwarded as X-Preview-Token. Set in
# dev/staging only; production should never serve drafts.
# FOUNDRY_PREVIEW_TOKEN=

# Multi-tenant routing dispatches by the HTTP Host header against
# WebsiteLocale.hostname rows in the backend. No env var is needed at
# *runtime* — set up hostnames via `valet proxy` (see docs/multi-tenant-dev.md
# once phase 3 lands) and ensure a matching website_locales row exists.

# ─── Build-scope variables ─────────────────────────────────────
# `WEBSITE_BUILD_*` describes which website / locales / paths the
# current build covers. Implicitly all about Foundry; the `WEBSITE_`
# prefix distinguishes them from `FOUNDRY_API_*` (connection config).

# Required for both `npm run build` AND `npm run dev`. Astro's
# `prerender` export only accepts literal true/false (not conditional
# expressions), so getStaticPaths runs in dev too. Without this var
# set in dev, /fr/, /fr/colisee, etc. all 404 — only the `/preview/[id]`
# and `/preview/[locale]/[...]` routes (prerender = false) would
# resolve. Pass any hostname registered for the website to develop
# against.
#
# When set at build time, this hostname also scopes the build output:
# artefacts go to `dist/<hostname>/{client,server}/` instead of plain
# `dist/`. Lets multiple sites coexist locally — serve each with
# `npm run preview:static <hostname> [--port 4323]`.
WEBSITE_BUILD_HOSTNAME=site-a.foundry-astro.test

# Optional locale filter — comma-separated locale codes. When set,
# `getStaticPaths` emits only pages in those locales. Skip for a
# full-locale build of the website.
# WEBSITE_BUILD_LOCALES=fr,en

# Optional surgical filter — comma-separated `locale/path` keys.
# Entries ending in `/` target the locale landing (e.g. `fr/`).
# Astro wipes `dist/` on each build; deploy via `rclone copy`
# (overlay, never deletes existing files at the edge).
# WEBSITE_BUILD_PATHS=fr/colisee,en/colosseum,fr/
