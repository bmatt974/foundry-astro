---
import './styles.css';
import { css } from './tokens';

interface Props {
    title: string;
    description?: string | null;
    locale?: string;
}

const { title, description, locale = 'en' } = Astro.props;
// Pull theme tokens from the tenant context populated by middleware.
// Set as an inline `style` on <html> so its specificity beats the
// `:root` defaults from styles.css even when Vite's bundled stylesheet
// lands later in the cascade.
const themeConfig = Astro.locals.tenant?.themeConfig ?? {};
const inlineTokens = css(themeConfig);
---

<!doctype html>
<html lang={locale} style={inlineTokens || undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {description && <meta name="description" content={description} />}
        <title>{title}</title>
    </head>
    <body class="antialiased">
        <header class="brand-border border-b">
            <div class="brand-container flex items-center justify-between px-4 py-4">
                <a href="/" class="brand-text-muted text-sm font-medium hover:opacity-70">
                    ← All locales
                </a>
                <slot name="locale-switcher" />
            </div>
        </header>

        <main class="brand-container px-4 py-12">
            <slot />
        </main>
    </body>
</html>
