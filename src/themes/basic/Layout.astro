---
import { fetchMenu } from '../../lib/foundry';
import './styles.css';
import SiteFooter from './components/SiteFooter.astro';
import SiteHeader from './components/SiteHeader.astro';
import { css } from './tokens';

interface Props {
    title: string;
    description?: string | null;
    locale?: string;
}

const { title, description, locale = 'en' } = Astro.props;

// Pull theme tokens from the tenant context populated by middleware.
// Set as an inline `style` on <html> so its specificity beats the
// `:root` defaults from styles.css even when Vite's bundled stylesheet
// lands later in the cascade.
const tenant = Astro.locals.tenant;
const themeConfig = tenant?.themeConfig ?? {};
const inlineTokens = css(themeConfig);

// Pre-fetch the footer menu — memoised 60s per (host, locale,
// location) so every page render isn't a fresh round-trip.
const footerItems = tenant
    ? await fetchMenu('footer', locale, tenant.website.hostname)
    : [];
const websiteName = tenant?.website.name ?? '';

// Admin-supplied raw HTML injections from Foundry's `Website >
// Custom HTML injections` panel. Filtered per-position (head /
// body_start / body_end) and per-locale. Bodies are validated
// server-side at insert time — see `App\Rules\SafeHtmlInjection`.
const injections = tenant?.injections ?? [];
const injectionsAt = (pos: 'head' | 'body_start' | 'body_end') =>
    injections.filter((i) => i.position === pos && (!i.locale || i.locale === locale));
const headInjections = injectionsAt('head');
const bodyStartInjections = injectionsAt('body_start');
const bodyEndInjections = injectionsAt('body_end');
---

<!doctype html>
<html lang={locale} style={inlineTokens || undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <slot name="head" />
        {!Astro.slots.has('head') && description && (
            <meta name="description" content={description} />
        )}
        {headInjections.map((i) => <Fragment set:html={i.body} />)}
    </head>
    <body class="antialiased">
        {bodyStartInjections.map((i) => <Fragment set:html={i.body} />)}
        <SiteHeader websiteName={websiteName} currentLocale={locale}>
            <slot name="locale-switcher" />
        </SiteHeader>

        <main class="brand-container px-4 py-12">
            <slot />
        </main>

        <SiteFooter websiteName={websiteName} currentLocale={locale} items={footerItems} />
        {bodyEndInjections.map((i) => <Fragment set:html={i.body} />)}
    </body>
</html>
