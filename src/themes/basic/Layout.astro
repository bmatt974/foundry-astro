---
import { fetchMenu, type MenuItem } from '../../lib/foundry';
import './styles.css';
import SiteFooter from './components/SiteFooter.astro';
import SiteHeader from './components/SiteHeader.astro';

interface Props {
    title: string;
    description?: string | null;
    locale?: string;
    /** Override the fetched menus — used by `/dev/preview` to ship
     *  fully synthetic chrome that doesn't depend on what the
     *  current tenant happens to have seeded in its CMS. */
    headerItems?: MenuItem[];
    footerItems?: MenuItem[];
}

const { title, description, locale = 'en', headerItems: overrideHeader, footerItems: overrideFooter } = Astro.props;

// Per-site theme tokens are baked into the served CSS bundle by the
// `scripts/mimic-cms-assets` post-build pass (it calls `tokens.css()`
// and prepends a `:root { … }` block). Keeping them out of the HTML
// shaves ~460 bytes off every page and lets the browser cache one
// stylesheet for the whole site.
const tenant = Astro.locals.tenant;

// Pre-fetch header + footer menus in parallel — memoised 60s per
// (host, locale, location) so every page render isn't a fresh
// round-trip. The two overrides let callers (e.g. /dev/preview)
// short-circuit the CMS fetch and ship synthetic menus instead.
const [headerItems, footerItems] = (overrideHeader && overrideFooter)
    ? [overrideHeader, overrideFooter]
    : tenant
        ? await Promise.all([
            fetchMenu('header', locale, tenant.website.hostname),
            fetchMenu('footer', locale, tenant.website.hostname),
        ])
        : [[], []];
const websiteName = tenant?.website.name ?? '';

// Admin-supplied raw HTML injections — website-scope come from
// `tenant.injections` (cached host-wide), hub/page/pattern-scope
// come from `Astro.locals.pageInjections` set by the catch-all
// after the page resolves. Locale filtering applies only to
// website-scope rows (page-level rows are already scoped server-
// side). Bodies are validated server-side at insert time — see
// `App\Rules\SafeHtmlInjection`.
const websiteInjections = tenant?.injections ?? [];
const pageInjections = Astro.locals.pageInjections ?? [];
const injectionsAt = (pos: 'head' | 'body_start' | 'body_end') => [
    ...websiteInjections.filter((i) => i.position === pos && (!i.locale || i.locale === locale)),
    ...pageInjections.filter((i) => i.position === pos),
];
const headInjections = injectionsAt('head');
const bodyStartInjections = injectionsAt('body_start');
const bodyEndInjections = injectionsAt('body_end');
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <slot name="head" />
        {!Astro.slots.has('head') && description && (
            <meta name="description" content={description} />
        )}
        {headInjections.map((i) => <Fragment set:html={i.body} />)}
    </head>
    <body class="antialiased">
        {bodyStartInjections.map((i) => <Fragment set:html={i.body} />)}
        <SiteHeader websiteName={websiteName} currentLocale={locale} items={headerItems}>
            <slot name="locale-switcher" />
        </SiteHeader>

        <main class="brand-container px-4 py-12">
            <slot />
        </main>

        <SiteFooter websiteName={websiteName} currentLocale={locale} items={footerItems} />
        {bodyEndInjections.map((i) => <Fragment set:html={i.body} />)}
    </body>
</html>
