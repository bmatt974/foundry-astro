---
/**
 * The page's answer, right under its title: the ticket the API leads
 * with, its price and the one button, opened by the venue's own reason
 * to book. When that ticket is a partner's, the venue's own ticket is
 * named above it as the price to measure against, without a button. The strip further down keeps every pick, this card
 * only lifts the first above the fold. Renders nothing without a
 * recommendation.
 */
import type { leadTicket } from '../../../lib/blocks/ticket-shelves';
import { useTranslations, type TranslationKey } from '../../../lib/i18n/index';

interface Props {
    lead: ReturnType<typeof leadTicket>;
}

const { lead } = Astro.props;
const t = useTranslations(Astro.locals.locale ?? 'en', Astro.locals.wording ?? null);
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';

const cancelLabel = lead?.offer.features.includes('free_cancellation') ? t('tickets.feature.free_cancellation') : null;
const href = lead ? lead.offer.leadHref ?? `#offer-${lead.offer.id}` : null;
const slotLabel = lead ? t(`tickets.quickPicks.${lead.slot}` as TranslationKey) : '';
const label = lead && lead.slot === 'recommended' && lead.offer.language?.state === 'match'
    ? `${slotLabel} ${t('tickets.quickPicks.inYourLanguage')}`
    : slotLabel;
---

{lead && href && (
    <aside class="brand-border -mt-4 mb-8 rounded-xl border bg-white p-4 shadow-sm" data-lead-ticket>
        {/* What the ticket is for, first: the reader's reason, not the product's name. */}
        <p class="brand-text-primary text-lg font-semibold leading-snug">{label}</p>
        <div class="mt-3 flex items-start gap-3">
            {lead.offer.imageUrl && (
                <img src={lead.offer.imageUrl} alt="" width="80" height="80" class="h-20 w-20 shrink-0 rounded-lg object-cover" />
            )}
            <div class="min-w-0">
                <p class="font-semibold leading-snug">{lead.name}</p>
                <p class="brand-text-muted mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                    {lead.offer.ratingText && <span class="font-medium" style="color: var(--brand-accent-rating)">{lead.offer.ratingText}</span>}
                    {lead.offer.durationText && <span>{lead.offer.durationText}</span>}
                    {lead.offer.language?.badge && (
                        <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium" style="background-color: rgba(0,0,0,0.06); color: #4b5563">
                            {lead.offer.language.badge}
                        </span>
                    )}
                </p>
            </div>
        </div>
        <div class="mt-4 flex items-baseline justify-between gap-3">
            {lead.offer.priceText && <p class="text-2xl font-bold tabular-nums">{lead.offer.priceText}</p>}
            {cancelLabel && <p class="text-sm font-medium" style="color: var(--brand-accent-success)">{cancelLabel}</p>}
        </div>
        <a
            href={href}
            target={lead.offer.leadHref ? '_blank' : undefined}
            rel={lead.offer.leadHref ? outboundRel : undefined}
            class="brand-bg-primary mt-3 block w-full rounded-lg px-4 py-3 text-center text-base font-semibold text-white hover:opacity-90"
        >
            {t('tickets.card.book')}
        </a>
        {(lead.line || lead.official) && (
            <div class="brand-border brand-text-muted mt-4 space-y-1 border-t pt-3 text-xs">
                {lead.line && <p>{lead.line}</p>}
                {lead.official && (
                    <p data-lead-official>
                        {lead.official.name}{lead.official.offer.priceText && <span class="whitespace-nowrap tabular-nums"> · {lead.official.offer.priceText}</span>}
                        {lead.official.offer.salesOpen && <span> · {lead.official.offer.salesOpen}</span>}
                    </p>
                )}
            </div>
        )}
    </aside>
)}
