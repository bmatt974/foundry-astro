---
/**
 * Sub-page navigation footer — parent, children, siblings of the
 * current page. Drops any node whose slug is null/empty for the
 * current locale: those pages are not navigable (no translation,
 * or translation in draft) and surfacing them as broken links would
 * funnel readers to `/{locale}/` (the home).
 *
 * Filtering policy differs from `Breadcrumb`: the breadcrumb keeps
 * unreachable hubs visible as plain text so the structural chain is
 * preserved for the reader; the nav-footer is purely a "where to go
 * next" list, so unreachable entries have no place in it.
 */
import type { NavNode } from '../../../lib/foundry';

interface Props {
    locale: string;
    nav: {
        parent: NavNode | null;
        children: NavNode[];
        siblings: NavNode[];
    };
}

const { locale, nav } = Astro.props;

const hasSlug = (n: NavNode): boolean => typeof n.slug === 'string' && n.slug.length > 0;
const parent = nav.parent && hasSlug(nav.parent) ? nav.parent : null;
const children = nav.children.filter(hasSlug);
const siblings = nav.siblings.filter(hasSlug);
const hasContent = parent !== null || children.length > 0 || siblings.length > 0;
---

{hasContent && (
    <nav class="brand-border brand-text-muted mt-16 border-t pt-6 text-sm">
        {parent && (
            <p class="mb-2">
                ↑ <a href={`/${locale}/${parent.slug}`} class="brand-link">{parent.title}</a>
            </p>
        )}
        {children.length > 0 && (
            <div class="mb-4">
                <p class="mb-2 font-medium">Sous-pages</p>
                <ul class="list-disc pl-5">
                    {children.map((c) => (
                        <li>
                            <a href={`/${locale}/${c.slug}`} class="brand-link">{c.title}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}
        {siblings.length > 0 && (
            <div>
                <p class="mb-2 font-medium">À voir aussi</p>
                <ul class="list-disc pl-5">
                    {siblings.map((s) => (
                        <li>
                            <a href={`/${locale}/${s.slug}`} class="brand-link">{s.title}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </nav>
)}
