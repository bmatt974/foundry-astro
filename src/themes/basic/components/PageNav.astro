---
import type { NavNode } from '../../../lib/foundry';

interface Props {
    locale: string;
    nav: {
        parent: NavNode | null;
        children: NavNode[];
        siblings: NavNode[];
    };
}

const { locale, nav } = Astro.props;
const hasContent = nav.parent !== null || nav.children.length > 0 || nav.siblings.length > 0;
---

{hasContent && (
    <nav class="brand-border brand-text-muted mt-16 border-t pt-6 text-sm">
        {nav.parent && (
            <p class="mb-2">
                ↑ <a href={`/${locale}/${nav.parent.slug ?? ''}`} class="brand-link">{nav.parent.title}</a>
            </p>
        )}
        {nav.children.length > 0 && (
            <div class="mb-4">
                <p class="mb-2 font-medium">Sous-pages</p>
                <ul class="list-disc pl-5">
                    {nav.children.map((c) => (
                        <li>
                            <a href={`/${locale}/${c.slug ?? ''}`} class="brand-link">{c.title}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}
        {nav.siblings.length > 0 && (
            <div>
                <p class="mb-2 font-medium">À voir aussi</p>
                <ul class="list-disc pl-5">
                    {nav.siblings.map((s) => (
                        <li>
                            <a href={`/${locale}/${s.slug ?? ''}`} class="brand-link">{s.title}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </nav>
)}
