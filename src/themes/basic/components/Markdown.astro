---
/**
 * Render a markdown string to HTML through `marked` and wrap it in a
 * Tailwind `prose` container. Content is trusted (authored in the
 * Foundry CMS), so no sanitizer is applied — flip to a sanitizer like
 * DOMPurify if the source becomes user-generated.
 *
 * Pass `size="sm"` for embedded contexts (FAQ answers, key facts) where
 * the default `prose` typography is too large.
 */
import { basicMarked } from '../lib/markdown-renderer';
import { applyAssignedHeadingIds } from '../../../lib/toc';

interface Props {
    text: string | null | undefined;
    /** Page-walk-assigned ids for the h2/h3 in `text`, in order.
     *  Omitted (FAQ answers, key-facts prose): ids are stripped —
     *  every id on the page must come from the single page walk. */
    headingIds?: string[];
    size?: 'sm' | 'base' | 'lg';
    class?: string;
}

const { text, size = 'base', headingIds, class: className = '' } = Astro.props;

const proseSize = size === 'base' ? '' : `prose-${size}`;
const html = text ? applyAssignedHeadingIds(basicMarked.parse(text, { async: false }) as string, headingIds) : '';
---

{html && (
    <div class:list={['prose max-w-none', proseSize, className]} set:html={html} />
)}
