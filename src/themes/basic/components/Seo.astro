---
/**
 * SEO head for the basic theme — vanilla pass-through of `SeoCore`
 * with no engine-specific extras. The wrapper exists for symmetry
 * with the other themes (each exposes `theme.Seo`); the actual
 * emission is in `src/components/SeoCore.astro`.
 */
import type { Page } from '../../../lib/foundry';
import SeoCore from '../../../components/SeoCore.astro';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
}
---

<SeoCore {...Astro.props} />
