---
import type { PageBlock } from '../../../lib/foundry';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as { title?: string; body?: string };
---

<section class="my-8">
    {content.title && <h2 class="text-2xl font-semibold mb-3">{content.title}</h2>}
    <Markdown text={content.body} class="text-gray-800" />
</section>
