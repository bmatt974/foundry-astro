---
import type { PageBlock } from '../../../lib/foundry';
import { parseText } from '../../../lib/blocks/text';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, body, anchorId } = parseText(block);
---

<section class="my-8">
    {title && (
        <h2 id={anchorId} class="text-2xl font-semibold mb-3">{title}</h2>
    )}
    <Markdown text={body} class="text-gray-800" />
</section>
