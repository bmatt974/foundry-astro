---
/**
 * One ticket row inside `TicketsSimple.astro`. Internal to the basic
 * theme : other themes ship their own variant.
 *
 * Meta-search layout (the Skyscanner / Kayak pattern) : each
 * affiliated provider gets its own clickable line under the title,
 * carrying its brand-coloured dot, the cheapest price it offers
 * for THIS ticket, and a click-through. Editor's ordering
 * (`settings.affiliate_programs`) becomes visually meaningful —
 * leftmost provider lands first on every card.
 *
 * `headingLevel` controls the H_n tag the title renders with — set
 * by the parent layout's hierarchy decision so the article's heading
 * outline stays consistent.
 */
import type { ParsedTicket, TicketsSettings } from '../../../lib/blocks/tickets';
import { useTranslations } from '../../../lib/i18n/index';

interface Props {
    ticket: ParsedTicket;
    headingLevel: 3 | 4 | 5 | 6;
    /** Subset of the parent block's settings that affect the row's
     *  presentation. Passed in instead of read from props.block so
     *  the row stays decoupled from the wider block shape. */
    settings: Pick<TicketsSettings, 'providerIndicator' | 'showProviderArrow' | 'priceAsButton' | 'ctaLabel' | 'highlightTarget' | 'hidePriceOutliers' | 'rowLayout'>;
}

const { ticket, headingLevel, settings } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);

const TitleTag = `h${headingLevel}` as 'h3' | 'h4' | 'h5' | 'h6';

// Rating string from the parser comes pre-formatted with the star :
// "★ 4.6 (12 345)". We split it so the renderer paints the star in
// its own brand-accent span ; the rest stays neutral text.
// Inline colour (#f59e0b = amber-500) — Tailwind's JIT might purge
// a one-off `text-amber-500` from a fresh block.
const starlessRating = ticket.ratingText?.startsWith('★ ')
    ? ticket.ratingText.slice(2)
    : ticket.ratingText;

// Feature badges already filtered + labelled by the parser. Capped
// at 4 to keep the row dense ; the most product-defining flags
// (skip-the-line, free cancellation, audio guide) come first via
// `BADGE_FEATURE_ORDER` in the lib.
const visibleBadges = ticket.badges.slice(0, 4);

// Bundle hint — covered Places minus the hosting one. Signals
// "this is a multi-attraction pass" without saying it explicitly.
const secondaryPlaces = ticket.coveredPlaces.filter((p) => !p.isPrimary);
const hasBundleHint = ticket.isBundle && secondaryPlaces.length > 0;

// Aggregation disclosure : surface that the ticket-level rating's
// review count is the cumulative total across all surviving
// providers, not a single marketplace's score. Renders only when
// at least 2 providers contribute — single-provider tickets carry
// a Tripadvisor-style score with no aggregation to disclose.
const showAggregationHint = ticket.providers.length >= 2 && Boolean(starlessRating);
---

<li class="flex flex-col gap-3 p-4">
    <div class="space-y-2">
        {/* Title down-weighted on purpose — the conversion focus
            is the per-provider price line below, not the catalog
            title. Tailwind `!font-medium` overrides whatever
            heading-tag styling the theme's typography layer adds
            on top of h3 / h4 / etc. */}
        <TitleTag class="text-sm !font-medium leading-snug" style="color: #1f2937">{ticket.title}</TitleTag>

        {starlessRating && (
            <p class="flex items-center gap-1.5 text-sm" style="color: #1f2937">
                <span style="color: var(--brand-accent-rating)" aria-hidden="true">★</span>
                <span class="font-semibold">{starlessRating}</span>
                {ticket.durationText && (
                    <span class="brand-text-muted text-xs">· {ticket.durationText}</span>
                )}
            </p>
        )}

        {showAggregationHint && (
            <p class="brand-text-muted text-[11px]">
                {t('tickets.card.aggregatedAcross', { count: String(ticket.providers.length) })}
            </p>
        )}

        {!starlessRating && ticket.durationText && (
            <p class="brand-text-muted text-xs">{ticket.durationText}</p>
        )}

        {visibleBadges.length > 0 && (
            /* Ticket-header badges — 3-tier visual hierarchy :
               1. group_type (Private tour / Small group) :
                  soft brand-primary tint, categorical "what kind of
                  tour is this" tag. Lands FIRST in the row because
                  it's the highest-cardinality discriminator.
               2. official_ticket : solid brand-accent-success pill
                  with ✓ — heavy trust signal, "operator's own
                  inventory not a re-seller".
               3. Everything else : soft brand-accent-success tint —
                  features sweep (skip-the-line, free cancellation,
                  hotel pickup, audio guide, …). */
            <ul class="flex flex-wrap gap-1.5">
                {visibleBadges.map((badge) => {
                    if (badge.slug.startsWith('group_type:')) {
                        return (
                            <li
                                class="brand-text-primary inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold"
                                style="background-color: color-mix(in srgb, var(--brand-primary) 12%, transparent)"
                            >
                                {badge.label}
                            </li>
                        );
                    }
                    if (badge.slug === 'official_ticket') {
                        return (
                            <li
                                class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold text-white"
                                style="background-color: var(--brand-accent-success)"
                            >
                                <span aria-hidden="true">✓</span>
                                <span>{badge.label}</span>
                            </li>
                        );
                    }
                    return (
                        <li
                            class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium"
                            style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                        >
                            {badge.label}
                        </li>
                    );
                })}
            </ul>
        )}

        {hasBundleHint && (
            <p class="brand-text-muted text-xs italic">
                + {secondaryPlaces.map((p) => p.name).join(', ')}
            </p>
        )}
    </div>

    {ticket.providers.length > 0 && (
        <ul class="brand-border divide-y rounded-md border bg-gray-50">
            {ticket.providers
                .filter((provider) => !(settings.hidePriceOutliers && provider.isPriceOutlier))
                .map((provider) => {
                // Per-provider price stays terse — the column is
                // already labelled by visual position ("you can see
                // it's a price"). Dropping the "From" / "À partir
                // de" prefix saves horizontal room AND keeps the
                // commitment language lower (no "from" = no hint of
                // hidden upsells).
                const priceLabel = provider.cheapestPriceText ?? null;
                /* Inline colours fight the theme's global `<a>` rule
                   that would otherwise paint every text node inside
                   the row in the theme primary (salmon on basic).
                   Hierarchy : indicator → name → price → arrow */
                const labelColor = '#1f2937';
                const priceColor = '#111827';
                const arrowColor = '#6b7280';
                /* Highlight winner — subtle accent background +
                   target-specific badge. Light tint is derived from
                   the theme's `--brand-accent-success` via
                   color-mix() so themes only override one base
                   colour and the variants follow.
                   The parser already returns `highlightedAs = null`
                   when the ticket carries a single provider (no
                   discrimination possible) ; here we just propagate
                   that — both the badge AND the background disappear
                   together so we don't paint a green row with no
                   accompanying label. */
                const highlightLabelKey = provider.highlightedAs === 'best_rated'
                    ? 'tickets.card.bestRated'
                    : provider.highlightedAs === 'cheapest'
                        ? 'tickets.card.bestPrice'
                        : null;
                const rowBg = provider.highlightedAs
                    ? 'color-mix(in srgb, var(--brand-accent-success) 10%, transparent)'
                    : '';

                // Build the indicator according to the editor's
                // choice — `dot` / `favicon` / `logo` / `none`.
                // Each option falls back gracefully when the
                // matching asset is absent (e.g. an OTA without a
                // shipped logo on `Supplier::brandLogoPath()`).
                let indicator: any = null;
                if (settings.providerIndicator === 'dot' && provider.brandColor) {
                    indicator = (
                        <span
                            aria-hidden="true"
                            class="inline-block h-2 w-2 flex-shrink-0 rounded-full"
                            style={`background-color: ${provider.brandColor}`}
                        />
                    );
                } else if (settings.providerIndicator === 'favicon' && provider.faviconPath) {
                    // Favicon = mark only, square. Sized to ~28px to
                    // match the Google Maps "Visites et activités"
                    // panel — the favicon needs to read at a glance
                    // alongside a bold provider name without
                    // dominating the row.
                    indicator = (
                        <img
                            src={provider.faviconPath}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            class="h-7 w-7 flex-shrink-0 rounded-md object-contain"
                        />
                    );
                } else if (settings.providerIndicator === 'logo' && provider.logoPath) {
                    // Logo = mark + wordmark. Needs ~2× the favicon
                    // height for the wordmark (Tiqets, GetYourGuide,
                    // Musement) to actually read at row size.
                    indicator = (
                        <img
                            src={provider.logoPath}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            class="h-8 w-auto flex-shrink-0 object-contain"
                        />
                    );
                }

                /* Trivago pattern — price and CTA sit side-by-side as
                   two distinct elements, both vertically centered
                   against the 2-line left cluster :
                     [info?] 323 €    [Voir l'offre →]
                   The price is plain bold text (no button chrome),
                   the CTA is a self-contained button. Splitting them
                   matches the user's mental model : "what does it
                   cost" + "go see the offer" are two questions.

                   priceAsButton toggles the CTA between :
                     - solid (brand-bg-primary, white text) for high
                       conversion intent on all rows.
                     - outlined (brand-border + brand-text) for an
                       editorial-friendly default ; the highlighted
                       row STILL gets solid even in this mode so the
                       Best price call-to-action stays visually
                       louder than its neighbours (Trivago : winner
                       gets solid, others get outlined). */
                const priceTag = priceLabel ? (
                    <span class="text-base font-bold leading-none" style={`color: ${priceColor}`}>
                        {priceLabel}
                    </span>
                ) : null;

                /* The highlight stamp (Best price + Save %) doubles
                   as a CTA emphasis signal — a row carrying the
                   winner badge gets a SOLID button, others get the
                   outlined version. priceAsButton globally forces
                   solid on every row. */
                const hasStamp = Boolean(highlightLabelKey || provider.savingsText);
                const ctaSolid = settings.priceAsButton || hasStamp;
                const ctaButton = settings.ctaLabel ? (
                    ctaSolid ? (
                        <span class="brand-bg-primary inline-flex items-center gap-1 rounded-md px-3 py-2 text-xs font-semibold text-white">
                            <span>{settings.ctaLabel}</span>
                            {settings.showProviderArrow && <span aria-hidden="true">›</span>}
                        </span>
                    ) : (
                        <span
                            class="brand-text-primary inline-flex items-center gap-1 rounded-md border px-3 py-2 text-xs font-semibold"
                            style="border-color: var(--brand-primary)"
                        >
                            <span>{settings.ctaLabel}</span>
                            {settings.showProviderArrow && <span aria-hidden="true">›</span>}
                        </span>
                    )
                ) : (
                    settings.showProviderArrow && (
                        <span class="brand-text-primary text-base font-semibold" aria-hidden="true">›</span>
                    )
                );

                /* Per-provider trust signal — rating + review count
                   from that provider's own marketplace. On a single
                   line so the row stays scannable like a comparison
                   table (Viator · ★ 4.3 (290) · €24). The star is
                   pre-stripped from the parser string and rendered
                   in amber as the single chromatic accent. */
                const providerStarless = provider.cheapestRatingText?.startsWith('★ ')
                    ? provider.cheapestRatingText.slice(2)
                    : provider.cheapestRatingText;

                const inner = (
                    <div
                        class="relative flex items-center justify-between gap-3 p-2.5"
                        style={rowBg ? `background-color: ${rowBg}` : ''}
                    >
                        {/* LEFT cluster on 2 lines. Order driven by
                            settings.rowLayout :
                            - 'rating_first' (default) : name + rating
                              on line 1, annotation chips on line 2.
                              Identity → trust signal → features.
                            - 'badges_first' : name + annotation chips
                              on line 1, rating on line 2.
                              Badges-forward A/B variant — useful when
                              feature differentiation matters more
                              than rating prominence (eg. pages where
                              "free cancellation" is the conversion
                              hook). */}
                        {(() => {
                            const nameTag = (
                                <span class="truncate text-sm font-semibold" style={`color: ${labelColor}`}>
                                    {provider.label}
                                </span>
                            );
                            const outlierTag = provider.isPriceOutlier ? (
                                <span
                                    class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium"
                                    style="background-color: rgba(0,0,0,0.06); color: #6b7280"
                                >
                                    {t('tickets.card.differentPackage')}
                                </span>
                            ) : null;
                            const ratingTag = providerStarless ? (
                                <span class="inline-flex items-baseline gap-0.5 text-xs" style={`color: ${arrowColor}`}>
                                    <span style="color: var(--brand-accent-rating)" aria-hidden="true">★</span>
                                    <span>{providerStarless}</span>
                                </span>
                            ) : null;
                            const badgeTags = provider.annotationBadges.map((badge) => (
                                <span
                                    class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
                                    style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                                >
                                    {badge.label}
                                </span>
                            ));
                            const isBadgesFirst = settings.rowLayout === 'badges_first';
                            return (
                                <div class="flex min-w-0 items-start gap-2.5">
                                    {indicator}
                                    <div class="flex min-w-0 flex-col gap-1.5">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                            {nameTag}
                                            {outlierTag}
                                            {isBadgesFirst ? badgeTags : ratingTag}
                                        </div>
                                        {isBadgesFirst
                                            ? ratingTag
                                            : (badgeTags.length > 0 && (
                                                <div class="flex flex-wrap gap-1">{badgeTags}</div>
                                            ))}
                                    </div>
                                </div>
                            );
                        })()}
                        {/* RIGHT cluster — Trivago horizontal split :
                            [price] [CTA button]. The price sits left,
                            the CTA right. Both vertically centered
                            against the 2-line LEFT cluster. The CTA
                            is solid for highlighted rows + when
                            priceAsButton is on, outlined otherwise. */}
                        <div class="flex flex-shrink-0 items-center gap-4">
                            {priceTag}
                            {ctaButton}
                        </div>
                        {/* Floating deal zone — "stamp" pattern. The
                            badges sit absolute, partly above the row
                            (top: -8px) and partly outside its right
                            edge — like a postage stamp affixed at the
                            corner of an envelope, pokes out both ways.
                            The price stays vertically centered in the
                            row because the badges don't participate
                            in the layout flow. Future promo codes
                            (active vouchers, limited-time discounts)
                            join the same row so the visitor reads the
                            full offer in one glance. pointer-events:
                            none keeps the row's outer <a> click target
                            intact under the stamp. */}
                        {hasStamp && (
                            <div
                                class="pointer-events-none absolute z-10 flex items-center justify-end gap-1"
                                style="top: -9px; right: -6px"
                            >
                                {highlightLabelKey && (
                                    <span
                                        class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold shadow-sm"
                                        style="background-color: var(--brand-accent-success); color: white"
                                    >
                                        {t(highlightLabelKey)}
                                    </span>
                                )}
                                {provider.savingsText && (
                                    <span
                                        class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold shadow-sm"
                                        style="border-color: var(--brand-accent-success); color: var(--brand-accent-success); background-color: white"
                                    >
                                        {provider.savingsText}
                                    </span>
                                )}
                            </div>
                        )}
                    </div>
                );

                return (
                    <li>
                        {provider.cheapestHref ? (
                            <a
                                href={provider.cheapestHref}
                                class="block no-underline transition hover:bg-white"
                                referrerpolicy="origin"
                                aria-label={`${provider.label}${priceLabel ? ` · ${priceLabel}` : ''}`}
                            >
                                {inner}
                            </a>
                        ) : (
                            inner
                        )}
                    </li>
                );
            })}
        </ul>
    )}
</li>
