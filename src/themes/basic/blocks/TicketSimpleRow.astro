---
/**
 * One ticket row inside `TicketsSimple.astro`. Internal to the basic
 * theme : other themes ship their own variant.
 *
 * Meta-search layout (the Skyscanner / Kayak pattern) : each
 * affiliated provider gets its own clickable line under the title,
 * carrying its brand-coloured dot, the cheapest price it offers
 * for THIS ticket, and a click-through. Editor's ordering
 * (`settings.affiliate_programs`) becomes visually meaningful —
 * leftmost provider lands first on every card.
 *
 * `headingLevel` controls the H_n tag the title renders with — set
 * by the parent layout's hierarchy decision so the article's heading
 * outline stays consistent.
 */
import {
    ratingStarless,
    type ParsedTicket,
    type TicketsSettings,
} from '../../../lib/blocks/tickets';
import { useTranslations } from '../../../lib/i18n/index';

interface Props {
    ticket: ParsedTicket;
    headingLevel: 3 | 4 | 5 | 6;
    /** Subset of the parent block's settings that affect the row's
     *  presentation. Passed in instead of read from props.block so
     *  the row stays decoupled from the wider block shape. */
    settings: Pick<TicketsSettings, 'providerIndicator' | 'showProviderArrow' | 'priceAsButton' | 'ctaLabel' | 'rowLayout' | 'showPhotos'>;
}

const { ticket, headingLevel, settings } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';

const TitleTag = `h${headingLevel}` as 'h3' | 'h4' | 'h5' | 'h6';

// Rating string from the parser comes pre-formatted with the star
// ("★ 4.6 (12 345)") — strip it so the renderer paints the star in
// its own brand-accent span and the rest reads as neutral text.
const starlessRating = ratingStarless(ticket.ratingText);

// Feature badges already filtered + labelled by the parser. Capped
// at 4 to keep the row dense ; the most product-defining flags
// (skip-the-line, free cancellation, audio guide) come first via
// `BADGE_FEATURE_ORDER` in the lib.
const visibleBadges = ticket.badges.slice(0, 4);

// Bundle hint — covered Places minus the hosting one. Signals
// "this is a multi-attraction pass" without saying it explicitly.
const secondaryPlaces = ticket.coveredPlaces.filter((p) => !p.isPrimary);
const hasBundleHint = ticket.isBundle && secondaryPlaces.length > 0;

// Aggregation disclosure : surface that the ticket-level rating's
// review count is the cumulative total across all surviving
// providers, not a single marketplace's score. Renders only when
// at least 2 providers contribute — single-provider tickets carry
// a Tripadvisor-style score with no aggregation to disclose.
const showAggregationHint = ticket.providers.length >= 2 && Boolean(starlessRating);
---

<li id={`ticket-${ticket.id}`} class="flex flex-col gap-3 p-4">
    {/* Top info cluster — title + meta + badges, with an optional
        cover thumbnail to the LEFT when `show_photos` is on. The
        thumbnail acts as a visual anchor for the ticket without
        the per-row "banner photo" pattern that would dominate the
        editorial-lean variant. On narrow viewports we keep the
        thumbnail beside the title (smaller w-20 vs w-28 desktop) so
        the ticket stays scannable at a glance — no responsive
        stacking that would push the info below the fold. */}
    <div class="flex items-center gap-3 sm:gap-4">
        {settings.showPhotos && ticket.coverImage && (
            <img
                src={ticket.coverImage}
                alt=""
                loading="lazy"
                class="tt-simple-thumb brand-border h-40 w-32 flex-shrink-0 rounded-md border object-cover sm:h-36 sm:w-44"
            />
        )}
        <div class="min-w-0 flex-1 space-y-2">
            {/* Title weight matched to the price (text-base bold) so the
                two visual anchors of the card carry the same hierarchy :
                "what is this ticket" + "what does it cost" read together.
                Capped to 2 lines on narrow viewports so a long product
                title doesn't dominate the card and push the price + CTA
                below the fold. */}
            <TitleTag class="tt-simple-title text-base !font-bold leading-snug" style="color: #1f2937">{ticket.title}</TitleTag>

        {/* Single meta line — rating, duration AND all 3-tier
            badges share one flex-wrap row. Reads as one continuous
            descriptor band : "what's good (rating) · how long ·
            what kind + trust + features". The aggregation hint
            drops to a discreet sub-line below since it's
            methodological disclosure, not card content. */}
        {(starlessRating || ticket.durationText || visibleBadges.length > 0) && (
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm" style="color: #1f2937">
                {starlessRating && (
                    <span class="inline-flex items-center gap-1">
                        <span style="color: var(--brand-accent-rating)" aria-hidden="true">★</span>
                        <span>{starlessRating}</span>
                    </span>
                )}
                {ticket.durationText && (
                    <span class="brand-text-muted text-xs">· {ticket.durationText}</span>
                )}
                {/* 3-tier badges :
                    1. group_type (Private / Small group) →
                       soft brand-primary tint (categorical type)
                    2. official_ticket → solid green ✓ pill (trust)
                    3. features → soft green tint (sweep) */}
                {visibleBadges.map((badge) => {
                    if (badge.slug.startsWith('group_type:')) {
                        return (
                            <span
                                class="brand-text-primary inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold"
                                style="background-color: color-mix(in srgb, var(--brand-primary) 12%, transparent)"
                            >
                                {badge.label}
                            </span>
                        );
                    }
                    if (badge.slug === 'official_ticket') {
                        return (
                            <span
                                class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold text-white"
                                style="background-color: var(--brand-accent-success)"
                            >
                                <span aria-hidden="true">✓</span>
                                <span>{badge.label}</span>
                            </span>
                        );
                    }
                    return (
                        <span
                            class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium"
                            style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                        >
                            {badge.label}
                        </span>
                    );
                })}
            </div>
        )}

        {showAggregationHint && (
            /* Methodological disclosure — clarifies that the (review)
               count above is the cumulative total across surviving
               providers, not a single marketplace's score. Sized at
               text-xs (12px) so it reads as legible fine-print
               without competing with the main rating + duration line. */
            <p class="brand-text-muted text-xs">
                {t('tickets.card.aggregatedAcross', { count: String(ticket.providers.length) })}
            </p>
        )}

            {hasBundleHint && (
                <p class="brand-text-muted text-xs italic">
                    + {secondaryPlaces.map((p) => p.name).join(', ')}
                </p>
            )}
        </div>
    </div>

    {ticket.providers.length > 0 && (
        <ul class="brand-border divide-y rounded-md border bg-gray-50">
            {/* `ticket.providers` is the API-filtered set (the
                aggregator already drops outliers when
                hide_price_outliers fires, applies min_reliable_reviews,
                etc.). The renderer is bare and iterates exactly what
                the backend kept — no client-side re-filtering. */}
            {ticket.providers.map((provider) => {
                // Per-provider price stays terse — the column is
                // already labelled by visual position ("you can see
                // it's a price"). Dropping the "From" / "À partir
                // de" prefix saves horizontal room AND keeps the
                // commitment language lower (no "from" = no hint of
                // hidden upsells).
                const priceLabel = provider.cheapestPriceText ?? null;
                /* Inline colours fight the theme's global `<a>` rule
                   that would otherwise paint every text node inside
                   the row in the theme primary (salmon on basic).
                   Hierarchy : indicator → name → price → arrow */
                const labelColor = '#1f2937';
                const priceColor = '#111827';
                const arrowColor = '#6b7280';
                /* Highlight winner — subtle accent background +
                   target-specific badge. Light tint is derived from
                   the theme's `--brand-accent-success` via
                   color-mix() so themes only override one base
                   colour and the variants follow.
                   The parser already returns `highlightedAs = null`
                   when the ticket carries a single provider (no
                   discrimination possible) ; here we just propagate
                   that — both the badge AND the background disappear
                   together so we don't paint a green row with no
                   accompanying label. */
                const highlightLabelKey = provider.highlightedAs === 'best_rated'
                    ? 'tickets.card.bestRated'
                    : provider.highlightedAs === 'cheapest'
                        ? 'tickets.card.bestPrice'
                        : null;
                const rowBg = provider.highlightedAs
                    ? 'color-mix(in srgb, var(--brand-accent-success) 10%, transparent)'
                    : '';

                // Build the indicator according to the editor's
                // choice — `dot` / `favicon` / `logo` / `none`.
                // Each option falls back gracefully when the
                // matching asset is absent (e.g. an OTA without a
                // shipped logo on `Supplier::brandLogoPath()`).
                let indicator: any = null;
                if (settings.providerIndicator === 'dot' && provider.brandColor) {
                    indicator = (
                        <span
                            aria-hidden="true"
                            class="inline-block h-2 w-2 flex-shrink-0 rounded-full"
                            style={`background-color: ${provider.brandColor}`}
                        />
                    );
                } else if (settings.providerIndicator === 'favicon' && provider.faviconPath) {
                    // Favicon = mark only, square. Sized small (20px)
                    // so the supplier reads as a quiet identifier
                    // beside the price — the *price* should be the
                    // row's visual hook, not the brand mark.
                    indicator = (
                        <img
                            src={provider.faviconPath}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            class="h-5 w-5 flex-shrink-0 rounded-md object-contain"
                        />
                    );
                } else if (settings.providerIndicator === 'logo' && provider.logoPath) {
                    // Logo = mark + wordmark. Slightly taller than
                    // the favicon (24px) so the wordmark (Tiqets,
                    // GetYourGuide, Musement) stays legible, but
                    // capped so the price still dominates the row.
                    indicator = (
                        <img
                            src={provider.logoPath}
                            alt=""
                            aria-hidden="true"
                            loading="lazy"
                            class="h-6 w-auto flex-shrink-0 object-contain"
                        />
                    );
                }

                /* Trivago pattern — price and CTA sit side-by-side as
                   two distinct elements, both vertically centered
                   against the 2-line left cluster :
                     [info?] 323 €    [Voir l'offre →]
                   The price is plain bold text (no button chrome),
                   the CTA is a self-contained button. Splitting them
                   matches the user's mental model : "what does it
                   cost" + "go see the offer" are two questions.

                   priceAsButton toggles the CTA between :
                     - solid (brand-bg-primary, white text) for high
                       conversion intent on all rows.
                     - outlined (brand-border + brand-text) for an
                       editorial-friendly default ; the highlighted
                       row STILL gets solid even in this mode so the
                       Best price call-to-action stays visually
                       louder than its neighbours (Trivago : winner
                       gets solid, others get outlined). */
                /* Price as the visual anchor of the row : `text-lg`
                   (18px) on mobile bumps it above the CTA's bold
                   12-13px so the value reads as the primary signal,
                   not the action. On desktop we revert to `text-base`
                   (16px) since the row is denser and matches the
                   simple card's typography elsewhere. */
                const priceTag = priceLabel ? (
                    <span class="text-lg font-bold leading-none sm:text-base" style={`color: ${priceColor}`}>
                        {priceLabel}
                    </span>
                ) : null;

                /* The highlight stamp (Best price + Save %) doubles
                   as a CTA emphasis signal — a row carrying the
                   winner badge gets a SOLID button, others get the
                   outlined version. priceAsButton globally forces
                   solid on every row. */
                const hasStamp = Boolean(highlightLabelKey || provider.savingsText);
                const ctaSolid = settings.priceAsButton || hasStamp;
                /* Every row gets a visible CTA — even when the
                   editor leaves settings.ctaLabel empty we fall
                   back to a generic "Voir l'offre" label so the
                   visitor always has an explicit tap target. The
                   row's anchor still wraps the whole card, but a
                   missing CTA hurt scannability ("where do I
                   click ?") in user testing. */
                const effectiveCtaLabel = settings.ctaLabel || t('tickets.card.viewOffer');
                const ctaButton = ctaSolid ? (
                    <span class="brand-bg-primary inline-flex min-w-28 items-center justify-center gap-1 rounded-md px-4 py-2 text-sm font-semibold text-white">
                        <span>{effectiveCtaLabel}</span>
                        {settings.showProviderArrow && <span aria-hidden="true">›</span>}
                    </span>
                ) : (
                    <span
                        class="brand-text-primary inline-flex min-w-28 items-center justify-center gap-1 rounded-md border px-4 py-2 text-sm font-semibold"
                        style="border-color: var(--brand-primary)"
                    >
                        <span>{effectiveCtaLabel}</span>
                        {settings.showProviderArrow && <span aria-hidden="true">›</span>}
                    </span>
                );

                /* Per-provider trust signal — rating + review count
                   from that provider's own marketplace. On a single
                   line so the row stays scannable like a comparison
                   table (Viator · ★ 4.3 (290) · €24). The star is
                   pre-stripped from the parser string and rendered
                   in amber as the single chromatic accent. */
                const providerStarless = ratingStarless(provider.cheapestRatingText);

                const inner = (
                    /* Mobile-first : stack the left cluster (provider
                       identity + rating + badges) ABOVE the right
                       cluster (price + CTA) so the provider name has
                       the full row width — no truncation. Above sm:
                       (≥640px) switch to horizontal split-row layout
                       (left vs right cluster on the same line) for
                       the desktop Trivago pattern. */
                    <div
                        class="relative flex flex-col gap-2 p-3 sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:p-2.5"
                        style={rowBg ? `background-color: ${rowBg}` : ''}
                    >
                        {/* LEFT cluster on 2 lines. Order driven by
                            settings.rowLayout :
                            - 'rating_first' (default) : name + rating
                              on line 1, annotation chips on line 2.
                            - 'badges_first' : name + annotation chips
                              on line 1, rating on line 2. */}
                        {(() => {
                            const nameTag = (
                                <span class="text-sm font-semibold sm:truncate" style={`color: ${labelColor}`}>
                                    {provider.label}
                                </span>
                            );
                            const outlierTag = provider.isPriceOutlier ? (
                                <span
                                    class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium"
                                    style="background-color: rgba(0,0,0,0.06); color: #6b7280"
                                >
                                    {t('tickets.card.differentPackage')}
                                </span>
                            ) : null;
                            const ratingTag = providerStarless ? (
                                <span class="inline-flex items-baseline gap-0.5 text-xs" style={`color: ${arrowColor}`}>
                                    <span style="color: var(--brand-accent-rating)" aria-hidden="true">★</span>
                                    <span>{providerStarless}</span>
                                </span>
                            ) : null;
                            const badgeTags = provider.annotationBadges.map((badge) => (
                                <span
                                    class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
                                    style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                                >
                                    {badge.label}
                                </span>
                            ));
                            const isBadgesFirst = settings.rowLayout === 'badges_first';
                            /* Mobile : identity column carries name +
                               rating + badges stacked vertically. Desktop :
                               the in-cluster badge slot is hidden
                               (`sm:hidden`) and the badges render in the
                               sibling CENTER cluster between identity and
                               price+CTA — fills the otherwise empty space
                               on the wider row. */
                            return (
                                <div class="flex min-w-0 items-start gap-2.5">
                                    {indicator}
                                    <div class="flex min-w-0 flex-col gap-0.5">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                            {nameTag}
                                            {outlierTag}
                                            {isBadgesFirst ? <span class="sm:hidden">{badgeTags}</span> : ratingTag}
                                        </div>
                                        {isBadgesFirst
                                            ? ratingTag
                                            : (badgeTags.length > 0 && (
                                                <div class="flex flex-wrap gap-1 sm:hidden">{badgeTags}</div>
                                            ))}
                                    </div>
                                </div>
                            );
                        })()}

                        {/* CENTER cluster — desktop only. Annotation
                            badges (Instant confirmation, Mobile ticket,
                            Free cancellation, etc.) sit in the empty
                            horizontal space between identity and the
                            price+CTA. Visible on sm+ ; mobile keeps them
                            inside the identity column. */}
                        {provider.annotationBadges.length > 0 && (
                            <div class="hidden flex-1 flex-wrap items-center justify-start gap-1 sm:flex">
                                {provider.annotationBadges.map((badge) => (
                                    <span
                                        class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
                                        style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                                    >
                                        {badge.label}
                                    </span>
                                ))}
                            </div>
                        )}

                        {/* RIGHT cluster — Trivago horizontal split :
                            [price] [CTA button]. Always right-anchored
                            (`justify-end`). The CTA is solid for
                            highlighted rows + when priceAsButton is on,
                            outlined otherwise. */}
                        <div class="flex w-full items-center justify-end gap-5 sm:w-auto sm:flex-shrink-0 sm:gap-6">
                            {priceTag}
                            {ctaButton}
                        </div>
                        {/* Deal zone — Best price + Save % badges.
                            Mobile : `order-first` lifts the stamps
                            ABOVE identity+price as a value signal
                            visitors see first. Desktop : switch to
                            the "postage stamp" pattern, absolute
                            in the row's top-right corner partly
                            poking out above + to the right of the
                            row's rounded border (sm:absolute +
                            sm:order-none). */}
                        {hasStamp && (
                            <div
                                class="tt-simple-stamp pointer-events-none order-first flex items-center gap-1 sm:absolute sm:order-none sm:z-10 sm:justify-end"
                            >
                                {highlightLabelKey && (
                                    <span
                                        class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold shadow-sm"
                                        style="background-color: var(--brand-accent-success); color: white"
                                    >
                                        {t(highlightLabelKey)}
                                    </span>
                                )}
                                {provider.savingsText && (
                                    <span
                                        class="inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-semibold shadow-sm"
                                        style="border-color: var(--brand-accent-success); color: var(--brand-accent-success); background-color: white"
                                    >
                                        {provider.savingsText}
                                    </span>
                                )}
                            </div>
                        )}
                    </div>
                );

                return (
                    /* Zebra striping — even rows get white, odd rows
                       keep the parent ul's gray-50. Highlighted row's
                       inline rowBg overrides both via specificity, so
                       the Best price tint always wins. Hover unifies
                       all rows back to white for a clean focus state. */
                    <li class="even:bg-white">
                        {provider.cheapestHref ? (
                            <a
                                href={provider.cheapestHref}
                                target="_blank"
                                rel={outboundRel}
                                class="block no-underline transition hover:bg-white"
                                aria-label={`${provider.label}${priceLabel ? ` · ${priceLabel}` : ''}`}
                            >
                                {inner}
                            </a>
                        ) : (
                            inner
                        )}
                        {provider.alternateSources.length > 0 && (
                            /* Skyscanner-style progressive disclosure :
                               the row shows the provider's CHEAPEST
                               listing ; its other listings for the same
                               ticket collapse behind "+N more options"
                               as compact price + name mini-rows. Sits
                               OUTSIDE the row's <a> wrapper (no nested
                               anchors). */
                            <details class="bg-white px-4 py-2.5">
                                <summary class="brand-text-muted cursor-pointer list-none text-xs underline [&::-webkit-details-marker]:hidden">
                                    {provider.alternateSources.length === 1
                                        ? t('tickets.card.moreFromProviderOne', { provider: provider.label })
                                        : t('tickets.card.moreFromProvider', { count: String(provider.alternateSources.length), provider: provider.label })} ›
                                </summary>
                                <ul class="mt-2 space-y-1.5">
                                    {provider.alternateSources.map((alt) => (
                                        /* Each mini-row must EARN its price gap
                                           against the cheapest above : these are
                                           different products of the same provider
                                           (not the same room at N vendors à la
                                           Skyscanner), so TITLE leads and the
                                           per-listing rating justifies a 69 €
                                           line under a 29 € winner. Price sits
                                           RIGHT — same column as the main
                                           provider rows, one price grammar for
                                           the whole component. Underlined title
                                           carries the click affordance. */
                                        <li>
                                            <a
                                                href={alt.href ?? provider.cheapestHref ?? '#'}
                                                target="_blank"
                                                rel={outboundRel}
                                                class="flex items-baseline gap-2 text-xs no-underline"
                                            >
                                                <span class="min-w-0 truncate underline">{alt.title ?? provider.label}</span>
                                                {alt.ratingText && (
                                                    <span class="brand-text-muted shrink-0">{alt.ratingText}</span>
                                                )}
                                                <span class="brand-text-primary ml-auto shrink-0 font-semibold">{alt.priceText ?? '—'}</span>
                                                <span class="brand-text-muted shrink-0" aria-hidden="true">›</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </details>
                        )}
                    </li>
                );
            })}
        </ul>
    )}
</li>

<style>
    /* Cap long product titles to 2 lines so the price + CTA stay
       above the fold on narrow viewports. The full title remains
       in the DOM for SEO + a11y — only the visual is clipped. */
    .tt-simple-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Per-provider deal stamp — "postage stamp" pattern on desktop.
       The Tailwind `sm:absolute sm:order-none` flips the element
       into absolute positioning above sm: ; the `top`/`right`
       offsets push it partly outside the row's rounded border for
       the "stamp affixed to the corner" look. Mobile leaves the
       element in normal flex flow (`order-first` lifts it ABOVE the
       identity cluster so the value signal reads first). */
    @media (min-width: 640px) {
        .tt-simple-stamp {
            top: -9px;
            right: -6px;
        }
    }
</style>
