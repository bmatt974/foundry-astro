---
/**
 * Tickets — basic theme dispatcher.
 *
 * Reads `block.variant` and delegates to the matching layout
 * component. Each variant is a SEPARATE `.astro` file in this
 * directory so the visual surface can A/B-test layouts on the same
 * data without forking classification (which lives in
 * `lib/blocks/tickets.ts`).
 *
 * Variants :
 *   - `'simple'`              → TicketsSimple   (stripped-down rows)
 *   - `'table'`               → TicketsTable    (features × tickets
 *                                                comparison matrix)
 *   - `'compare'`             → TicketsCompare  (one row per format
 *                                                bucket, features as
 *                                                columns — 4-row
 *                                                meta-search layout)
 *   - default / null / other  → TicketsRich     (full 4-bucket card
 *                                                grid + chips +
 *                                                threshold sub-sections)
 *
 * Source of truth for the data model :
 *   /docs/strategy/tickets/data-model.md (foundry)
 */
import type { PageBlock } from '../../../lib/foundry';
import { parseTicketsBlock, type ParsedBucket } from '../../../lib/blocks/tickets';
import { groupBundleTickets } from '../../../lib/tickets/bundle-subgroups';
import { groupAccessTickets } from '../../../lib/tickets/access-subgroups';
import { useTranslations } from '../../../lib/i18n/index';
import TicketCard from './TicketCard.astro';
import TicketsSimple from './TicketsSimple.astro';
import TicketsTable from './TicketsTable.astro';
import TicketsCompare from './TicketsCompare.astro';
import TicketsQuickPicks from './TicketsQuickPicks.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const isSimple = block.variant === 'simple';
const isTable = block.variant === 'table';
const isCompare = block.variant === 'compare';
const isCustomVariant = isSimple || isTable || isCompare;

const locale = Astro.locals.locale ?? 'en';
const linkProxyPath = Astro.locals.tenant?.experiments?.link_proxy_path ?? 'go';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);

// Parsed unconditionally : the rich layout consumes the buckets, and
// EVERY variant (simple / table / compare included) needs
// `parsed.quickPicks` for the verdict strip above the comparator.
// Child variants re-parse internally — pure CPU, acceptable at SSG /
// dev time.
const parsed = parseTicketsBlock(block, locale, linkProxyPath, wording);
const buckets = parsed.buckets;
const totalCount = parsed.totalCount;

// The "details ↓" anchor targets `id="ticket-{id}"` on each row —
// shipped by TicketSimpleRow (simple) and TicketCard (rich). Table /
// compare don't carry per-ticket anchors yet, so their strip stays
// CTA-only rather than shipping dead links.
const supportsAnchors = isSimple || !isCustomVariant;

/** Drop buckets with zero tickets — keeps the page tight on small
 *  Places where (e.g.) Special access carries nothing yet. */
const visibleBuckets = buckets.filter((b) => b.tickets.length > 0);

const groupHeaderLabel = t('tickets.filter.groupHeader');
const experienceHeaderLabel = t('tickets.filter.experienceHeader');

/** Max tickets a bundle sub-group shows before the tail collapses
 *  behind a "Show N more offers" disclosure. */
const BUNDLE_GROUP_CAP = 6;
---

<TicketsQuickPicks picks={parsed.quickPicks} settings={parsed.settings} showDetailsAnchor={supportsAnchors} />

{isSimple && <TicketsSimple block={block} />}
{isTable && <TicketsTable block={block} />}
{isCompare && <TicketsCompare block={block} />}

{!isCustomVariant && totalCount > 0 && (
    <section class="my-10 space-y-12">
        {visibleBuckets.map((bucket: ParsedBucket) => {
            /* Bundle bucket gets its own sub-axis : the aggregator
               classifies each ticket as city `card`, `day_trip`,
               `bus`, `cruise` or `combo`. When the bucket carries ≥ 2
               sub-types we surface sub-headers ("Pass & cartes",
               "Bus touristique"...) so a 15-item Passes & Combos
               list reads as scannable groups instead of a wall of
               similar-looking cards. Single-subtype buckets render
               flat (no redundant sub-header above a flat list). */
            const bundleGroups = bucket.format === 'bundle' ? groupBundleTickets(bucket.tickets) : [];
            const showBundleSubsections = bundleGroups.length > 1;
            /* Access bucket gets the same sub-axis treatment :
               Officiel / Avec audio guide / Coupe-file. Classified
               server-side from the ticket's feature pivot. */
            const accessGroups = bucket.format === 'access' ? groupAccessTickets(bucket.tickets) : [];
            const showAccessSubsections = accessGroups.length > 1;
            return (
            <article aria-labelledby={`tickets-bucket-${bucket.format}`}>
                <header class="mb-5">
                    <h2 id={`tickets-bucket-${bucket.format}`} class="brand-text-primary text-2xl font-semibold tracking-tight">
                        {bucket.header}
                    </h2>
                    {parsed?.settings.showFilters && (bucket.groupChips.length > 1 || bucket.experienceChips.length > 1) && (
                        <div class="mt-3 space-y-2">
                            {bucket.groupChips.length > 1 && (
                                <div class="flex flex-wrap items-center gap-2 text-xs">
                                    <span class="brand-text-muted font-semibold uppercase tracking-wider">{groupHeaderLabel}</span>
                                    {bucket.groupChips.map((chip) => (
                                        <span class="brand-border inline-flex items-center gap-1 rounded-full border bg-white px-2.5 py-1">
                                            {chip.label}
                                            <span class="brand-text-muted">·</span>
                                            <span class="brand-text-muted">{chip.count}</span>
                                        </span>
                                    ))}
                                </div>
                            )}
                            {bucket.experienceChips.length > 1 && (
                                <div class="flex flex-wrap items-center gap-2 text-xs">
                                    <span class="brand-text-muted font-semibold uppercase tracking-wider">{experienceHeaderLabel}</span>
                                    {bucket.experienceChips.map((chip) => (
                                        <span class="brand-border inline-flex items-center gap-1 rounded-full border bg-white px-2.5 py-1">
                                            {chip.label}
                                            <span class="brand-text-muted">·</span>
                                            <span class="brand-text-muted">{chip.count}</span>
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>
                    )}
                </header>

                {bucket.format === 'bundle' ? (
                    /* Bundle bucket sub-axis : Pass & cartes / Excursions /
                       Bus touristique / Croisières / Combos. Groups are
                       capped — the tail of an oversized group collapses
                       behind a native <details> so 13 combos stop owning
                       the page's scroll. Sub-headers only render when ≥ 2
                       sub-types survive. */
                    <div class="space-y-8">
                        {bundleGroups.map((group) => {
                            const visibleTickets = group.tickets.slice(0, BUNDLE_GROUP_CAP);
                            const overflowTickets = group.tickets.slice(BUNDLE_GROUP_CAP);
                            return (
                                <section aria-labelledby={showBundleSubsections ? `tickets-sub-${bucket.format}-${group.subtype}` : undefined}>
                                    {showBundleSubsections && (
                                        <h3 id={`tickets-sub-${bucket.format}-${group.subtype}`} class="brand-text-primary mb-3 text-lg font-semibold">
                                            {t(`tickets.bundleSubtype.${group.subtype}`)} <span class="brand-text-muted ml-1 text-sm font-normal">({group.tickets.length})</span>
                                        </h3>
                                    )}
                                    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                        {visibleTickets.map((ticket) => (
                                            <TicketCard ticket={ticket} showPhotos={parsed.settings.showPhotos} />
                                        ))}
                                    </ul>
                                    {overflowTickets.length > 0 && (
                                        <details class="mt-3">
                                            <summary class="brand-text-muted cursor-pointer list-none text-sm underline [&::-webkit-details-marker]:hidden">
                                                {t('tickets.bucket.showMore', { count: String(overflowTickets.length) })} ›
                                            </summary>
                                            <ul class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                                {overflowTickets.map((ticket) => (
                                                    <TicketCard ticket={ticket} showPhotos={parsed.settings.showPhotos} />
                                                ))}
                                            </ul>
                                        </details>
                                    )}
                                </section>
                            );
                        })}
                    </div>
                ) : showAccessSubsections ? (
                    /* Access bucket sub-axis : Officiel / Avec audio
                       guide / Coupe-file. */
                    <div class="space-y-8">
                        {accessGroups.map((group) => (
                            <section aria-labelledby={`tickets-sub-${bucket.format}-${group.subtype}`}>
                                <h3 id={`tickets-sub-${bucket.format}-${group.subtype}`} class="brand-text-primary mb-3 text-lg font-semibold">
                                    {t(`tickets.accessSubtype.${group.subtype}`)} <span class="brand-text-muted ml-1 text-sm font-normal">({group.tickets.length})</span>
                                </h3>
                                <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                    {group.tickets.map((ticket) => (
                                        <TicketCard ticket={ticket} showPhotos={parsed.settings.showPhotos} />
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>
                ) : bucket.groupSubsections.length > 0 ? (
                    <div class="space-y-8">
                        {bucket.groupSubsections.map((sub) => (
                            <section aria-labelledby={`tickets-sub-${bucket.format}-${sub.slug}`}>
                                <h3 id={`tickets-sub-${bucket.format}-${sub.slug}`} class="brand-text-primary mb-3 text-lg font-semibold">
                                    {sub.label} <span class="brand-text-muted ml-1 text-sm font-normal">({sub.tickets.length})</span>
                                </h3>
                                <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                    {sub.tickets.map((ticket) => (
                                        <TicketCard ticket={ticket} showPhotos={parsed.settings.showPhotos} />
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>
                ) : bucket.experienceSubsections.length > 0 ? (
                    <div class="space-y-8">
                        {bucket.experienceSubsections.map((sub) => (
                            <section aria-labelledby={`tickets-sub-${bucket.format}-${sub.slug}`}>
                                <h3 id={`tickets-sub-${bucket.format}-${sub.slug}`} class="brand-text-primary mb-3 text-lg font-semibold">
                                    {sub.label} <span class="brand-text-muted ml-1 text-sm font-normal">({sub.tickets.length})</span>
                                </h3>
                                <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                    {sub.tickets.map((ticket) => (
                                        <TicketCard ticket={ticket} showPhotos={parsed.settings.showPhotos} />
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>
                ) : (
                    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {bucket.tickets.map((ticket) => (
                            <TicketCard ticket={ticket} showPhotos={parsed.settings.showPhotos} />
                        ))}
                    </ul>
                )}
            </article>
            );
        })}

    </section>
)}
