---
/**
 * Tickets — basic theme dispatcher.
 *
 * Reads `block.variant` and delegates to the matching layout
 * component. Each variant is a SEPARATE `.astro` file in this
 * directory so the visual surface can A/B-test layouts on the same
 * data without forking classification (which lives in
 * `lib/blocks/tickets.ts`).
 *
 * Variants :
 *   - `'simple'`              → TicketsSimple   (stripped-down rows)
 *   - `'table'`               → TicketsTable    (features × tickets
 *                                                comparison matrix)
 *   - `'compare'`             → TicketsCompare  (one row per format
 *                                                bucket, features as
 *                                                columns — 4-row
 *                                                meta-search layout)
 *   - default / null / other  → TicketsRich     (full 4-bucket card
 *                                                grid + chips +
 *                                                threshold sub-sections)
 *
 * Source of truth for the data model :
 *   /docs/strategy/tickets/data-model.md (foundry)
 */
import type { PageBlock } from '../../../lib/foundry';
import { parseTicketsBlock, type ParsedBucket } from '../../../lib/blocks/tickets';
import { useTranslations } from '../../../lib/i18n/index';
import TicketCard from './TicketCard.astro';
import TicketsSimple from './TicketsSimple.astro';
import TicketsTable from './TicketsTable.astro';
import TicketsCompare from './TicketsCompare.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const isSimple = block.variant === 'simple';
const isTable = block.variant === 'table';
const isCompare = block.variant === 'compare';
const isCustomVariant = isSimple || isTable || isCompare;

const locale = Astro.locals.locale ?? 'en';
const linkProxyPath = Astro.locals.tenant?.experiments?.link_proxy_path ?? 'go';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);

// `parsed` is only used by the rich layout below ; skip the work
// when we'll delegate to a child variant immediately.
const parsed = isCustomVariant
    ? null
    : parseTicketsBlock(block, locale, linkProxyPath, wording);
const buckets = parsed?.buckets ?? [];
const totalCount = parsed?.totalCount ?? 0;

/** Drop buckets with zero tickets — keeps the page tight on small
 *  Places where (e.g.) Special access carries nothing yet. */
const visibleBuckets = buckets.filter((b) => b.tickets.length > 0);

const groupHeaderLabel = t('tickets.filter.groupHeader');
const experienceHeaderLabel = t('tickets.filter.experienceHeader');
---

{isSimple && <TicketsSimple block={block} />}
{isTable && <TicketsTable block={block} />}
{isCompare && <TicketsCompare block={block} />}

{!isCustomVariant && totalCount > 0 && (
    <section class="my-10 space-y-12">
        {visibleBuckets.map((bucket: ParsedBucket) => (
            <article aria-labelledby={`tickets-bucket-${bucket.format}`}>
                <header class="mb-5">
                    <h2 id={`tickets-bucket-${bucket.format}`} class="brand-text-primary text-2xl font-semibold tracking-tight">
                        {bucket.header}
                    </h2>
                    {parsed?.settings.showFilters && (bucket.groupChips.length > 1 || bucket.experienceChips.length > 1) && (
                        <div class="mt-3 space-y-2">
                            {bucket.groupChips.length > 1 && (
                                <div class="flex flex-wrap items-center gap-2 text-xs">
                                    <span class="brand-text-muted font-semibold uppercase tracking-wider">{groupHeaderLabel}</span>
                                    {bucket.groupChips.map((chip) => (
                                        <span class="brand-border inline-flex items-center gap-1 rounded-full border bg-white px-2.5 py-1">
                                            {chip.label}
                                            <span class="brand-text-muted">·</span>
                                            <span class="brand-text-muted">{chip.count}</span>
                                        </span>
                                    ))}
                                </div>
                            )}
                            {bucket.experienceChips.length > 1 && (
                                <div class="flex flex-wrap items-center gap-2 text-xs">
                                    <span class="brand-text-muted font-semibold uppercase tracking-wider">{experienceHeaderLabel}</span>
                                    {bucket.experienceChips.map((chip) => (
                                        <span class="brand-border inline-flex items-center gap-1 rounded-full border bg-white px-2.5 py-1">
                                            {chip.label}
                                            <span class="brand-text-muted">·</span>
                                            <span class="brand-text-muted">{chip.count}</span>
                                        </span>
                                    ))}
                                </div>
                            )}
                        </div>
                    )}
                </header>

                {bucket.groupSubsections.length > 0 ? (
                    <div class="space-y-8">
                        {bucket.groupSubsections.map((sub) => (
                            <section aria-labelledby={`tickets-sub-${bucket.format}-${sub.slug}`}>
                                <h3 id={`tickets-sub-${bucket.format}-${sub.slug}`} class="brand-text-primary mb-3 text-lg font-semibold">
                                    {sub.label} <span class="brand-text-muted text-sm font-normal">({sub.tickets.length})</span>
                                </h3>
                                <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                    {sub.tickets.map((ticket) => (
                                        <TicketCard ticket={ticket} />
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>
                ) : bucket.experienceSubsections.length > 0 ? (
                    <div class="space-y-8">
                        {bucket.experienceSubsections.map((sub) => (
                            <section aria-labelledby={`tickets-sub-${bucket.format}-${sub.slug}`}>
                                <h3 id={`tickets-sub-${bucket.format}-${sub.slug}`} class="brand-text-primary mb-3 text-lg font-semibold">
                                    {sub.label} <span class="brand-text-muted text-sm font-normal">({sub.tickets.length})</span>
                                </h3>
                                <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                    {sub.tickets.map((ticket) => (
                                        <TicketCard ticket={ticket} />
                                    ))}
                                </ul>
                            </section>
                        ))}
                    </div>
                ) : (
                    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {bucket.tickets.map((ticket) => (
                            <TicketCard ticket={ticket} />
                        ))}
                    </ul>
                )}
            </article>
        ))}

    </section>
)}
