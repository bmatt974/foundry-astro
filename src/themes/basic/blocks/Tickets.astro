---
/**
 * Tickets — basic theme dispatcher.
 *
 * Since the dynamic-block chantier the API composes the `{meta,
 * quick_picks, shelves}` payload at SERVE time for every venue page, so
 * this dispatcher only knows the shelves family. `block.variant` picks
 * the DISPOSITION inside TicketsShelves: rows (simple/default), cards,
 * table (also the legacy `compare`), detailed (also the legacy `rich`).
 *
 * A `picks_only` payload is the picks strip alone (TicketsPicks).
 *
 * A payload without a `shelves` key — a destination page's empty block,
 * or malformed content — renders nothing rather than a guess.
 */
import type { PageBlock } from '../../../lib/foundry';
import { isShelvesPayload, parseShelvesBlock } from '../../../lib/blocks/ticket-shelves';
import TicketsShelves from './TicketsShelves.astro';
import TicketsPicks from './TicketsPicks.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;

const isShelves = isShelvesPayload(block.content);
/* A picks-only block (`picks_only`) is the strip on its own, above the
   page's full comparator: it renders the picks, never the shelves. */
const parsed = isShelves
    ? parseShelvesBlock(block, Astro.locals.locale ?? 'en', Astro.locals.wording ?? null, Astro.locals.tenant?.experiments?.link_proxy_path ?? 'go')
    : null;
const shelfLayout = block.variant === 'table' || block.variant === 'compare'
    ? 'table' as const
    : block.variant === 'cards'
        ? 'cards' as const
        : block.variant === 'rich' || block.variant === 'detailed'
            ? 'detailed' as const
            : 'rows' as const;
---

{parsed?.picksOnly
    ? <TicketsPicks parsed={parsed} standalone />
    : isShelves && <TicketsShelves block={block} layout={shelfLayout} />}
