---
/**
 * Tickets — `variant = 'table'`.
 *
 * Features × Tickets comparison table : columns = tickets, rows =
 * dimensions (price, duration, rating, group type, feature presence).
 * Best for editorial "Top 3 tours" comparisons where the visitor
 * needs to pick BETWEEN distinct products (not the same product at
 * different providers — that's the simple variant's per-row
 * provider list).
 *
 * One `<table>` per surviving bucket : Admission / Guided / Special
 * access / Bundle are different product categories, mixing them in
 * one table makes the comparison meaningless ("does a private guided
 * tour cost more than a standard admission" isn't an actual question
 * the visitor asks). Headers carry the bucket label so the matrix
 * stays scoped.
 *
 * Feature rows are auto-filtered to the slugs that AT LEAST ONE
 * ticket carries — pointless to render a "Hotel pickup" row of
 * "— — —" across all columns. Same for the group_type row : only
 * surfaces when at least one ticket has a non-default value.
 *
 * Source of truth for the underlying data model :
 *   /docs/strategy/tickets/data-model.md (foundry)
 */
import {
    parseTicketsBlock,
    type ParsedBucket,
    buildBucketContext,
    groupTypeLabel,
    ratingStarless,
    supplierHomepage,
    ticketHasFeature,
} from '../../../lib/blocks/tickets';
import { useTranslations } from '../../../lib/i18n/index';
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const linkProxyPath = Astro.locals.tenant?.experiments?.link_proxy_path ?? 'go';
const wording = Astro.locals.wording ?? null;
/* Site-wide rel chain for affiliate CTAs — resolved server-side
   from `websites.settings.outbound_links.rel_mode`. Defaults to
   `nofollow` so a tenant with no setting (or no tenant at all in
   isolated component tests) renders the dominant SERP pattern. */
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';
const t = useTranslations(locale, wording);

const parsed = parseTicketsBlock(block, locale, linkProxyPath, wording);
const { totalCount, heading, layout, settings } = parsed;
const visibleBuckets = parsed.buckets.filter((b: ParsedBucket) => b.tickets.length > 0);

// Same heading hierarchy logic as TicketsSimple — the block's
// `heading_level` describes the OUTERMOST tag. Per-bucket layouts
// drop the top heading and let SubHeading act as it instead.
const topLevel = settings.headingLevel;

const TopHeading = `h${topLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
const SubHeading = `h${topLevel}` as 'h2' | 'h3' | 'h4' | 'h5';

const filtersAreActive
    = settings.filterFormat.length > 0
    || settings.filterGroupType.length > 0
    || settings.filterExperienceType.length > 0;

const ctaLabel = settings.ctaLabel ?? t('tickets.card.book');

/* Bucket render contexts (feature rows, providers, per-cell stamps)
   are built by `buildBucketContext` in lib/blocks/tickets — every
   theme implementing the table variant shares the same comparison
   semantics. */
const contexts = visibleBuckets.map((bucket) => buildBucketContext(bucket, settings));

const featurePresent = t('tickets.table.featurePresent');
const featureAbsent = t('tickets.table.featureAbsent');
---

{totalCount === 0 && filtersAreActive && (
    <section class="tickets-table my-8">
        <div class="brand-border rounded-lg border bg-white p-6 text-center">
            <p class="brand-text-muted text-sm">{t('tickets.bucket.empty')}</p>
        </div>
    </section>
)}

{visibleBuckets.length > 0 && (
    <section class="tickets-table my-8">
        {layout === 'single' && heading !== '' && (
            <TopHeading class="brand-text-primary mb-4 text-xl font-semibold tracking-tight">
                {heading}
            </TopHeading>
        )}

        <div class="space-y-10">
            {contexts.map(({ bucket, relevantFeatures, showGroupTypeRow, showRatingRow, showDurationRow, providers, stamps, primaryWinners, stampPriority }) => (
                <article aria-labelledby={`tickets-table-${bucket.format}`}>
                    {layout !== 'single' && (
                        <SubHeading
                            id={`tickets-table-${bucket.format}`}
                            class="brand-text-primary mb-4 text-lg font-semibold tracking-tight"
                        >
                            {bucket.label} <span class="brand-text-muted text-sm font-normal">({bucket.tickets.length})</span>
                        </SubHeading>
                    )}

                    {/* Mobile : swipe carousel — one ticket per card,
                        scroll-snap on the X axis. The "features ×
                        tickets" matrix becomes "per-ticket stack" so
                        the visitor sees ONE option at a time, swipes
                        to compare. No JS — CSS scroll-snap handles
                        snapping, the peek (85vw) hints there's more
                        to the right.

                        Sits above the desktop table (hidden sm:block
                        below) so progressive enhancement degrades to
                        the table on larger viewports. */}
                    <div class="tt-mobile-deck -mx-4 px-4 sm:hidden">
                        <ul class="tt-mobile-track flex snap-x snap-mandatory gap-3 overflow-x-auto pb-3">
                            {bucket.tickets.map((ticket) => {
                                const winnerSlug = primaryWinners.get(ticket.id);
                                const winnerProvider = winnerSlug ? ticket.providers.find((p) => p.slug === winnerSlug) : null;
                                const winnerStamps = winnerSlug ? stamps.get(ticket.id)?.get(winnerSlug) : undefined;
                                const winningCriterion = winnerStamps
                                    ? stampPriority.find((s) => winnerStamps.has(s)) ?? null
                                    : null;
                                const winnerSnapshot = winningCriterion === 'best_rated'
                                    ? winnerProvider?.perspectives.bestRated
                                    : winningCriterion === 'most_reviewed'
                                        ? winnerProvider?.perspectives.mostReviewed
                                        : winnerProvider?.perspectives.cheapest;
                                const cardCover = winnerSnapshot?.coverImage ?? winnerProvider?.coverImage ?? ticket.coverImage;
                                const cardHref = winnerSnapshot?.href ?? winnerProvider?.cheapestHref ?? ticket.primaryCtaHref;
                                const cardRating = ratingStarless(ticket.ratingText);
                                /* Sort providers cheapest first — matches the
                                   compare variant's meta-search stack so the
                                   visitor lands on the best price immediately. */
                                const sortedProviders = [...ticket.providers].sort((a, b) => {
                                    const aHas = a.cheapestPriceFloor !== null;
                                    const bHas = b.cheapestPriceFloor !== null;
                                    if (aHas && bHas) return (a.cheapestPriceFloor as number) - (b.cheapestPriceFloor as number);
                                    if (aHas) return -1;
                                    if (bHas) return 1;
                                    return 0;
                                });
                                return (
                                    <li class="tt-mobile-card brand-border shrink-0 snap-center overflow-hidden rounded-lg border bg-white">
                                        {cardCover && (
                                            <div class="relative">
                                                <img
                                                    src={cardCover}
                                                    alt={ticket.title}
                                                    loading="lazy"
                                                    class="aspect-[16/9] w-full object-cover"
                                                />
                                            </div>
                                        )}
                                        <div class="p-4">
                                            <h4 class="text-base font-bold leading-snug text-gray-900">
                                                {cardHref ? (
                                                    <a href={cardHref} target="_blank" rel={outboundRel} class="no-underline" style="color: inherit">
                                                        {ticket.title}
                                                    </a>
                                                ) : (
                                                    ticket.title
                                                )}
                                            </h4>

                                            {(cardRating || ticket.durationText || showGroupTypeRow) && (
                                                <p class="brand-text-muted mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                                                    {cardRating && (
                                                        <span class="inline-flex items-center gap-1">
                                                            <span class="tt-text-rating" aria-hidden="true">★</span>
                                                            <span>{cardRating}</span>
                                                        </span>
                                                    )}
                                                    {ticket.durationText && <span>· {ticket.durationText}</span>}
                                                    {showGroupTypeRow && ticket.groupType !== 'standard' && (
                                                        <span>· {groupTypeLabel(ticket.groupType, t)}</span>
                                                    )}
                                                </p>
                                            )}

                                            {relevantFeatures.length > 0 && (
                                                <ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 text-xs">
                                                    {relevantFeatures.map((slug) => {
                                                        const present = ticketHasFeature(ticket, slug);
                                                        return (
                                                            <li class:list={['flex items-center gap-1.5', !present && 'brand-text-muted']}>
                                                                <span aria-hidden="true">{present ? '✅' : '❌'}</span>
                                                                <span class="truncate">{t(`tickets.feature.${slug}` as never)}</span>
                                                            </li>
                                                        );
                                                    })}
                                                </ul>
                                            )}

                                            {sortedProviders.length > 0 && (
                                                <ul class="brand-border mt-4 divide-y rounded-md border bg-gray-50 text-xs">
                                                    {sortedProviders.map((provider, idx) => {
                                                        const isPrimary = idx === 0;
                                                        const providerRating = ratingStarless(provider.cheapestRatingText);
                                                        return (
                                                            <li class="flex items-center justify-between gap-2 p-2.5">
                                                                <div class="min-w-0">
                                                                    <p class="truncate font-semibold text-gray-900">{provider.label}</p>
                                                                    {providerRating && (
                                                                        <p class="brand-text-muted text-[11px]">
                                                                            <span class="tt-text-rating" aria-hidden="true">★</span> {providerRating}
                                                                        </p>
                                                                    )}
                                                                </div>
                                                                <div class="flex items-center gap-2">
                                                                    {provider.cheapestPriceText && (
                                                                        <span class="text-sm font-bold text-gray-900">{provider.cheapestPriceText}</span>
                                                                    )}
                                                                    {provider.cheapestHref && (
                                                                        <a
                                                                            href={provider.cheapestHref}
                                                                            target="_blank"
                                                                            rel={outboundRel}
                                                                            class:list={[
                                                                                'inline-block whitespace-nowrap rounded-md px-3 py-1.5 text-xs font-semibold',
                                                                                isPrimary
                                                                                    ? 'brand-bg-primary text-white'
                                                                                    : 'brand-border brand-text-primary border bg-white',
                                                                            ]}
                                                                        >
                                                                            {settings.ctaLabel || t('tickets.card.book')}
                                                                        </a>
                                                                    )}
                                                                </div>
                                                            </li>
                                                        );
                                                    })}
                                                </ul>
                                            )}
                                        </div>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>

                    {/* Horizontal scroll on narrow viewports — the
                        matrix is naturally wide once you have 4+
                        columns. The wrapper creates the horizontal
                        scroll context ; vertical sticky goes against
                        the viewport. Cells become sticky in 2 axes :
                        - thead row sticky at top: 0 (vertical scroll
                          preserves the ticket identities)
                        - first column sticky at left: 0 (horizontal
                          scroll preserves the feature labels)
                        - top-left corner cell sticks BOTH and carries
                          the highest z-index so it covers the
                          intersection cleanly. Box-shadow replaces
                          borders because border-collapse + sticky
                          interact badly (borders bleed through). */}
                    <div class="brand-border tickets-table-scroll hidden overflow-x-auto rounded-lg border bg-white sm:block">
                        <table
                            class="tt-table w-full text-sm"
                            style={`min-width: ${180 + bucket.tickets.length * 200}px`}
                        >
                            {/* Fixed column widths via <colgroup> — first
                                column holds the row labels (140px), the
                                rest divide the remaining width equally
                                so every ticket reads at the same visual
                                weight.
                                The table's `min-width` enforces a 200px
                                MINIMUM per ticket column : with many
                                tickets in a bucket, the wrapper's
                                overflow-x kicks in instead of squishing
                                the columns into unreadable slivers
                                (8-line titles, prices smashed together,
                                etc.). */}
                            <colgroup>
                                {/* First col width is set via the
                                    `.tickets-table-scroll col:first-
                                    child` rule. Ticket cols share the
                                    rest equally — the per-col width is
                                    dynamic so it stays inline
                                    (computed from the bucket length
                                    at render time). */}
                                <col />
                                {bucket.tickets.map(() => (
                                    <col style={`width: ${100 / bucket.tickets.length}%`} />
                                ))}
                            </colgroup>
                            <thead>
                                <tr>
                                    {/* Top-left corner — sticks BOTH
                                        axes. Highest z-index so it
                                        overlays the row labels AND
                                        the column headers when
                                        scrolling either way. */}
                                    <th scope="col" class="tt-sticky-corner bg-gray-50 p-3"></th>
                                    {bucket.tickets.map((ticket) => {
                                        /* Resolve the URL the column header
                                           should link to — the primary winner's
                                           listing for this ticket. Falls back
                                           to the ticket's primary CTA when no
                                           winner was awarded (e.g. single-
                                           provider tickets that skip the
                                           stamps pass). */
                                        const winnerSlug = primaryWinners.get(ticket.id);
                                        const winnerProvider = winnerSlug ? ticket.providers.find((p) => p.slug === winnerSlug) : null;
                                        /* Resolve the winning criterion (the
                                           first stamp in `stampPriority` that
                                           this cell carries) so we can pull
                                           the image + URL from the matching
                                           PERSPECTIVE — the listing that
                                           actually won the criterion. */
                                        const winnerStamps = winnerSlug ? stamps.get(ticket.id)?.get(winnerSlug) : undefined;
                                        const winningCriterion = winnerStamps
                                            ? stampPriority.find((s) => winnerStamps.has(s)) ?? null
                                            : null;
                                        const winnerSnapshot = winningCriterion === 'best_rated'
                                            ? winnerProvider?.perspectives.bestRated
                                            : winningCriterion === 'most_reviewed'
                                                ? winnerProvider?.perspectives.mostReviewed
                                                : winnerProvider?.perspectives.cheapest;
                                        /* Image + URL come from the same
                                           snapshot. Falls back to the
                                           provider's coverImage / cheapestHref
                                           when perspectives aren't shipped
                                           (legacy payload, no winner). */
                                        const headerHref = winnerSnapshot?.href ?? winnerProvider?.cheapestHref ?? ticket.primaryCtaHref;
                                        const headerCover = winnerSnapshot?.coverImage ?? winnerProvider?.coverImage ?? ticket.coverImage;
                                        const innerHeader = (
                                            <>
                                                {headerCover ? (
                                                    <img
                                                        src={headerCover}
                                                        alt={ticket.title}
                                                        loading="lazy"
                                                        width="192"
                                                        height="112"
                                                        class="mx-auto mb-2 h-[112px] w-[192px] rounded object-cover"
                                                    />
                                                ) : (
                                                    <div
                                                        class="mx-auto mb-2 h-[112px] w-[192px] rounded bg-gray-100"
                                                        aria-hidden="true"
                                                    />
                                                )}
                                                <div class="text-sm font-bold leading-snug">{ticket.title}</div>
                                            </>
                                        );
                                        return (
                                            <th
                                                scope="col"
                                                class="tt-sticky-col-header min-w-[180px] bg-white p-3 text-center align-top text-gray-800"
                                            >
                                                {headerHref ? (
                                                    <a
                                                        href={headerHref}
                                                        target="_blank"
                                                        rel={outboundRel}
                                                        class="tt-header-link block no-underline"
                                                       
                                                        aria-label={ticket.title}
                                                    >
                                                        {innerHeader}
                                                    </a>
                                                ) : (
                                                    innerHeader
                                                )}
                                            </th>
                                        );
                                    })}
                                </tr>
                            </thead>
                            <tbody>
                                {/* Price row — the visual anchor.
                                    Cheapest from the surviving
                                    providers, bold + text-base to
                                    match the simple variant's price
                                    treatment. */}
                                <tr>
                                    <th scope="row" class="brand-text-muted bg-gray-50 p-3 text-left text-xs font-medium uppercase tracking-wider">
                                        {t('tickets.table.priceFrom')}
                                    </th>
                                    {bucket.tickets.map((ticket) => (
                                        <td class="p-3 text-center align-middle">
                                            <span class="text-base text-gray-900">
                                                {ticket.priceText ?? '—'}
                                            </span>
                                        </td>
                                    ))}
                                </tr>

                                {showDurationRow && (
                                    <tr>
                                        <th scope="row" class="brand-text-muted bg-gray-50 p-3 text-left text-xs font-medium uppercase tracking-wider">
                                            {t('tickets.table.duration')}
                                        </th>
                                        {bucket.tickets.map((ticket) => (
                                            <td class="brand-text-muted p-3 text-center align-middle text-sm">
                                                {ticket.durationText ?? featureAbsent}
                                            </td>
                                        ))}
                                    </tr>
                                )}

                                {showRatingRow && (
                                    <tr>
                                        <th scope="row" class="brand-text-muted bg-gray-50 p-3 text-left text-xs font-medium uppercase tracking-wider">
                                            {t('tickets.table.rating')}
                                        </th>
                                        {bucket.tickets.map((ticket) => {
                                            const r = ratingStarless(ticket.ratingText);
                                            /* Methodological disclosure — same
                                               rule as the simple variant : when
                                               the rating is the cumulative
                                               aggregate across 2+ providers we
                                               make that explicit in a 10px
                                               sub-line so the visitor doesn't
                                               read the (review) count as a
                                               single marketplace's score. */
                                            const showAggregationHint = ticket.providers.length >= 2 && Boolean(r);
                                            return (
                                                <td class="p-3 text-center align-middle text-sm text-gray-800">
                                                    {r ? (
                                                        <span class="inline-flex flex-col items-center gap-0.5">
                                                            <span class="inline-flex items-baseline gap-1">
                                                                <span class="tt-text-rating" aria-hidden="true">★</span>
                                                                <span>{r}</span>
                                                            </span>
                                                            {showAggregationHint && (
                                                                <span class="brand-text-muted text-[10px]">
                                                                    {t('tickets.card.aggregatedAcross', { count: String(ticket.providers.length) })}
                                                                </span>
                                                            )}
                                                        </span>
                                                    ) : (
                                                        <span class="brand-text-muted">{featureAbsent}</span>
                                                    )}
                                                </td>
                                            );
                                        })}
                                    </tr>
                                )}

                                {showGroupTypeRow && (
                                    /* Group-type row only fires when
                                       AT LEAST ONE ticket has a
                                       non-standard value — otherwise
                                       a row of "Standard / Standard /
                                       Standard" wastes vertical space
                                       without informing the choice. */
                                    <tr>
                                        <th scope="row" class="brand-text-muted bg-gray-50 p-3 text-left text-xs font-medium uppercase tracking-wider">
                                            {t('tickets.table.groupType')}
                                        </th>
                                        {bucket.tickets.map((ticket) => (
                                            <td class="p-3 text-center align-middle text-sm text-gray-800">
                                                {groupTypeLabel(ticket.groupType, t)}
                                            </td>
                                        ))}
                                    </tr>
                                )}

                                {/* Feature rows — auto-filtered to
                                    slugs at least one ticket carries.
                                    Each cell : ✓ if present, — if
                                    absent. The label uses the same
                                    `tickets.feature.*` dictionary as
                                    the simple variant's chips. */}
                                {relevantFeatures.map((slug) => (
                                    <tr>
                                        <th scope="row" class="brand-text-muted bg-gray-50 p-3 text-left text-xs font-medium">
                                            {t(`tickets.feature.${slug}` as any)}
                                        </th>
                                        {bucket.tickets.map((ticket) => {
                                            const has = ticketHasFeature(ticket, slug);
                                            return (
                                                <td class="p-3 align-middle text-center text-sm">
                                                    {has ? (
                                                        <span class="tt-text-success" aria-label={featurePresent}>{featurePresent}</span>
                                                    ) : (
                                                        <span class="brand-text-muted" aria-label={featureAbsent}>{featureAbsent}</span>
                                                    )}
                                                </td>
                                            );
                                        })}
                                    </tr>
                                ))}

                                {/* Section header — "Voir les disponibilités"
                                    spans the full table to mark the
                                    transition from ticket attributes
                                    (top) to per-provider availability
                                    (below). The label moves OUT of the
                                    individual price buttons so each cell
                                    stays tight and the action verb
                                    reads only once at the section
                                    level, not on every CTA. */}
                                {providers.length > 0 && (
                                    /* "Voir les disponibilités" section
                                       header — the inner div uses :
                                         - position: sticky ; left: 0   →
                                           pinned to the wrapper viewport
                                           left edge.
                                         - width: 100cqi                →
                                           exactly the wrapper visible
                                           inline size (container query
                                           unit, scope set on the
                                           wrapper).
                                         - text-align: center            →
                                           centers the label inside the
                                           viewport-wide frame.
                                       Effect : the gray bar + label
                                       always span and centre the
                                       VISIBLE area, no matter how far
                                       the user has scrolled
                                       horizontally. The outer td still
                                       provides the table-cell anchor
                                       so the row participates in flow
                                       between feature rows and provider
                                       rows. */
                                    <tr>
                                        <td
                                            colspan={bucket.tickets.length + 1}
                                            class="tt-section-host"
                                        >
                                            <div class="tt-section-bar brand-text-muted text-center text-[11px] font-semibold uppercase tracking-wider">
                                                {ctaLabel}
                                            </div>
                                        </td>
                                    </tr>
                                )}
                                {/* Provider rows — one per unique OTA in
                                    the bucket. LEFT col carries the brand
                                    identity (favicon + name), each cell
                                    shows that provider's price for the
                                    corresponding ticket as a solid CTA
                                    button. Cells where the provider
                                    doesn't sell that ticket render a
                                    discreet text link to the OTA's
                                    catalogue homepage — keeps the
                                    visitor on a path to that brand even
                                    when this exact product is absent. */}
                                {providers.map((provider) => (
                                    <tr>
                                        <th scope="row" class="bg-gray-50 p-3 text-left">
                                            <span class="flex items-center gap-2">
                                                {/* providerIndicator switch — same
                                                    semantic as the simple variant
                                                    so the editor's choice flows
                                                    across both variants. Each
                                                    branch gracefully degrades :
                                                    `dot` needs brandColor, `favicon`
                                                    needs faviconPath, `logo` needs
                                                    logoPath ; falls back to no
                                                    indicator when the asset is
                                                    missing for this supplier. */}
                                                {settings.providerIndicator === 'dot' && provider.brandColor && (
                                                    <span
                                                        aria-hidden="true"
                                                        class="inline-block h-2.5 w-2.5 flex-shrink-0 rounded-full"
                                                        style={`background-color: ${provider.brandColor}`}
                                                    />
                                                )}
                                                {settings.providerIndicator === 'favicon' && provider.faviconPath && (
                                                    <img
                                                        src={provider.faviconPath}
                                                        alt=""
                                                        loading="lazy"
                                                        width="28"
                                                        height="28"
                                                        class="h-7 w-7 flex-shrink-0 rounded-md object-contain"
                                                    />
                                                )}
                                                {settings.providerIndicator === 'logo' && provider.logoPath && (
                                                    <img
                                                        src={provider.logoPath}
                                                        alt=""
                                                        loading="lazy"
                                                        class="h-8 w-auto flex-shrink-0 object-contain"
                                                    />
                                                )}
                                                <span class="truncate text-sm font-semibold text-gray-800">
                                                    {provider.label}
                                                </span>
                                            </span>
                                        </th>
                                        {bucket.tickets.map((ticket) => {
                                            const offer = ticket.providers.find((p) => p.slug === provider.slug);
                                            if (offer && offer.cheapestHref) {
                                                /* Per-provider rating sits
                                                   ABOVE the price button, in
                                                   fine print. The star is
                                                   rendered in amber as the
                                                   single chromatic accent ;
                                                   stripping the parser's
                                                   leading "★ " lets the star
                                                   get its own coloured span.
                                                   Rating above the CTA mirrors
                                                   the editorial reading order
                                                   "trust signal → action". */
                                                const providerRating = ratingStarless(offer.cheapestRatingText);
                                                const cellStamps = stamps.get(ticket.id)?.get(provider.slug);
                                                const isPrimaryWinner = primaryWinners.get(ticket.id) === provider.slug;
                                                return (
                                                    <td class="px-2 pt-2 pb-4 align-middle">
                                                        <div class="flex flex-col items-center justify-center gap-2">
                                                            {/* Stamps above the
                                                                rating so the
                                                                visitor scans
                                                                "why this is the
                                                                pick" → "what's
                                                                its score" →
                                                                "what's the price"
                                                                top to bottom. */}
                                                            {/* Stamps iterate the editor's
                                                                `stampPriority` — the priority
                                                                list doubles as render order so a
                                                                custom ordering also re-orders
                                                                the visible chips (leftmost =
                                                                primary criterion). Stamps absent
                                                                from `stampPriority` were already
                                                                dropped at parse-time, so they
                                                                never reach this loop. */}
                                                            {cellStamps && cellStamps.size > 0 && (
                                                                <span class="flex flex-wrap justify-center gap-1">
                                                                    {stampPriority.map((stamp) => {
                                                                        if (!cellStamps.has(stamp)) return null;
                                                                        if (stamp === 'best_price') {
                                                                            return <span class="tt-stamp tt-stamp-price">{t('tickets.table.stampBestPrice')}</span>;
                                                                        }
                                                                        if (stamp === 'best_rated') {
                                                                            return <span class="tt-stamp tt-stamp-rated">{t('tickets.table.stampBestRated')}</span>;
                                                                        }
                                                                        if (stamp === 'best_value') {
                                                                            return <span class="tt-stamp tt-stamp-value">{t('tickets.table.stampBestValue')}</span>;
                                                                        }
                                                                        if (stamp === 'most_reviewed') {
                                                                            return <span class="tt-stamp tt-stamp-reviewed">{t('tickets.table.stampMostReviewed')}</span>;
                                                                        }
                                                                        return null;
                                                                    })}
                                                                </span>
                                                            )}
                                                            {providerRating && (
                                                                <span class="inline-flex items-baseline gap-1 text-xs text-gray-800">
                                                                    <span class="tt-text-rating" aria-hidden="true">★</span>
                                                                    <span>{providerRating}</span>
                                                                </span>
                                                            )}
                                                            {/* ONLY the primary winner cell per
                                                                column gets the SOLID brand CTA —
                                                                the cell whose highest-priority
                                                                stamp tops the editor's stamp
                                                                priority list. Other cells (even
                                                                those carrying secondary stamps)
                                                                render outlined. Mirrors the
                                                                ContentEgg pattern : one winner
                                                                per column, no tie. */}
                                                            {isPrimaryWinner ? (
                                                                <a
                                                                    href={offer.cheapestHref}
                                                                    target="_blank"
                                                                    rel={outboundRel}
                                                                    class="brand-bg-primary tt-cta-price inline-flex items-center justify-center rounded-md text-base text-white no-underline"
                                                                   
                                                                    aria-label={`${provider.label} — ${offer.cheapestPriceText ?? ''}`}
                                                                >
                                                                    {offer.cheapestPriceText}
                                                                </a>
                                                            ) : (
                                                                <a
                                                                    href={offer.cheapestHref}
                                                                    target="_blank"
                                                                    rel={outboundRel}
                                                                    class="tt-cta-price-outlined text-base"
                                                                   
                                                                    aria-label={`${provider.label} — ${offer.cheapestPriceText ?? ''}`}
                                                                >
                                                                    {offer.cheapestPriceText}
                                                                </a>
                                                            )}
                                                        </div>
                                                    </td>
                                                );
                                            }
                                            /* No offer for this ticket — discreet
                                               fallback link to the provider's
                                               catalogue, in case the visitor
                                               wants to browse their wider
                                               inventory. Muted styling so the
                                               row's actual offers (other cells)
                                               stay the visual anchor. */
                                            const homepage = supplierHomepage(provider.slug);
                                            return (
                                                <td class="p-2 text-center align-middle">
                                                    {homepage ? (
                                                        <a
                                                            href={homepage}
                                                            target="_blank"
                                                            rel={outboundRel}
                                                            class="brand-text-muted inline-block text-[11px] underline-offset-2 hover:underline"
                                                        >
                                                            {provider.label} ›
                                                        </a>
                                                    ) : (
                                                        <span class="brand-text-muted text-[11px]">{featureAbsent}</span>
                                                    )}
                                                </td>
                                            );
                                        })}
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </article>
            ))}
        </div>
    </section>
)}

<style>
    /* Sticky-cell behaviour for the comparison matrix.
       The wrapper `<div.tickets-table-scroll>` is the horizontal
       scroll context (overflow-x: auto). The viewport handles the
       vertical scroll because no parent has overflow-y set.

       Each tbody first-column `<th scope="row">` sticks to the
       wrapper's left edge during horizontal scroll. Each thead `<th>`
       sticks to the viewport top during vertical scroll. The cell
       sitting at the intersection (already styled inline on the
       template) carries the highest z-index so it covers both axes.

       Box-shadow stands in for borders because border-collapse:
       separate doesn't propagate <tr> borders, and sticky cells
       render ABOVE adjacent cells — a border on a non-sticky
       neighbour would get hidden when the sticky cell scrolls over
       it. Box-shadow lives on the sticky cell itself, so it stays
       anchored on scroll. */
    /* Container-query scope on the wrapper so the section-header
       inner div can size to the visible viewport via 100cqi —
       lets a single element be both sticky to the wrapper left
       edge AND span exactly the visible width, centering its
       label inside that frame regardless of horizontal scroll
       position. */
    .tickets-table-scroll {
        container-type: inline-size;
    }

    /* Mobile swipe-carousel : one ticket per card, scroll-snap on
       the X axis. The peek (~85vw) hints there's more to the right
       so the visitor swipes naturally — no JS, no dots indicator
       (the horizontal scroll IS the indicator). Hide the scrollbar
       on iOS / Android default browsers ; desktop never reaches
       this layout (hidden above sm:). */
    .tt-mobile-track {
        scrollbar-width: none;
        -ms-overflow-style: none;
        scroll-padding: 0 1rem;
    }
    .tt-mobile-track::-webkit-scrollbar {
        display: none;
    }
    .tt-mobile-card {
        width: 85vw;
        max-width: 22rem;
    }
    .tickets-table-scroll tbody th[scope='row'] {
        position: sticky;
        left: 0;
        z-index: 1;
        box-shadow:
            inset 0 -1px 0 rgba(0, 0, 0, 0.06),
            inset -1px 0 0 rgba(0, 0, 0, 0.06);
    }
    .tickets-table-scroll tbody td {
        box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.06);
    }
    /* Zebra striping — odd rows get gray-50, even rows get white.
       Applies to BOTH the sticky first-column <th> AND the body
       <td> so the band spans the full row width without breaking
       at the sticky boundary. */
    .tickets-table-scroll tbody tr:nth-child(odd) th[scope='row'],
    .tickets-table-scroll tbody tr:nth-child(odd) td {
        background-color: rgb(249 250 251); /* gray-50 */
    }
    .tickets-table-scroll tbody tr:nth-child(even) th[scope='row'],
    .tickets-table-scroll tbody tr:nth-child(even) td {
        background-color: white;
    }
    /* Last row drops the bottom box-shadow — the wrapper's outer
       border already closes the table on that edge. */
    .tickets-table-scroll tbody tr:last-child th[scope='row'] {
        box-shadow: inset -1px 0 0 rgba(0, 0, 0, 0.06);
    }
    .tickets-table-scroll tbody tr:last-child td {
        box-shadow: none;
    }

    /* Reusable sticky patterns — extracted so the JSX stays free of
       inline `style="..."` clutter. */
    .tt-sticky-corner {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 3;
        box-shadow:
            inset 0 -1px 0 rgba(0, 0, 0, 0.08),
            inset -1px 0 0 rgba(0, 0, 0, 0.06);
    }
    .tt-sticky-col-header {
        position: sticky;
        top: 0;
        z-index: 2;
        box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.08);
    }

    /* Section header "Voir les disponibilités" — the outer <td>
       hosts an inner sticky <div> that sizes to the wrapper's
       visible inline size (100cqi) so the bar + label stay
       centered in the viewport during horizontal scroll. The host
       td drops its zebra background + box-shadow so only the
       inner bar paints. */
    .tt-section-host {
        padding: 0;
        background-color: transparent !important;
        box-shadow: none !important;
    }
    .tt-section-bar {
        position: sticky;
        left: 0;
        width: 100cqi;
        padding: 0.5rem 0.75rem;
        background-color: rgb(243 244 246);
        box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.08);
    }

    /* CTA price button — beats the theme rules
       `a.brand-bg-primary { font-weight: 500; padding: 0.75rem 1.5rem }`
       via a more specific selector. Tighter padding fits the
       table density ; bold price reads as the conversion anchor. */
    .tickets-table-scroll a.brand-bg-primary.tt-cta-price {
        font-weight: 800;
        padding: 0.5rem 0.75rem;
    }

    /* Column header link — wraps cover + title and points at the
       primary winner's URL. Subtle hover state signals the
       clickability without competing with the per-cell CTAs below.
       The image scales slightly on hover (ContentEgg-style) so the
       affordance reads before the visitor reaches for the CTA. */
    .tickets-table-scroll .tt-header-link {
        color: inherit;
        transition: opacity 0.15s ease;
    }
    .tickets-table-scroll .tt-header-link:hover {
        opacity: 0.85;
    }
    .tickets-table-scroll .tt-header-link img {
        transition: transform 0.2s ease;
    }
    .tickets-table-scroll .tt-header-link:hover img {
        transform: scale(1.02);
    }

    /* Outlined CTA variant — used on cells without a stamp so the
       winning provider (which carries a stamp + solid CTA) stays
       the visual anchor of each column. Mirrors the simple variant's
       dichotomy : highlighted row solid, others outlined. */
    .tickets-table-scroll .tt-cta-price-outlined {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid var(--brand-primary);
        color: var(--brand-primary);
        background-color: transparent;
        text-decoration: none;
        line-height: 1.25;
    }

    /* Brand accent helpers — bridges the theme's CSS custom
       properties into Tailwind-style class usage in the JSX. */
    .tt-text-rating { color: var(--brand-accent-rating); }
    .tt-text-success { color: var(--brand-accent-success); }

    /* First column (row labels) fixed width — applied via CSS
       rather than inline so the <col> stays markup-only. Sized
       for the longest provider name shipped today
       ("GetYourGuide" = 12 chars) + favicon (28px) + gap + cell
       padding without truncation. */
    .tickets-table-scroll col:first-child {
        width: 180px;
    }

    /* Table-level static rules. The dynamic `min-width` is the only
       value that still varies per render (bucket size) — that one
       stays inline. */
    .tt-table {
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
    }

    /* Per-column comparison stamps. Mirrors the simple variant's
       dichotomy : "Best price" lands SOLID (deal anchor, matches
       the simple variant's primary stamp) while the rest stay
       OUTLINED with their accent colour as border + text. Reads
       softer than 4 competing solid pills and keeps Best price as
       the primary visual signal in each cell. */
    .tt-stamp {
        display: inline-flex;
        align-items: center;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 600;
        line-height: 1;
        white-space: nowrap;
        background-color: transparent;
        border: 1px solid currentColor;
    }
    .tt-stamp-price {
        background-color: var(--brand-accent-success);
        border-color: var(--brand-accent-success);
        color: white;
    }
    .tt-stamp-rated {
        color: var(--brand-accent-rating);
    }
    .tt-stamp-value {
        color: var(--brand-primary);
    }
    .tt-stamp-reviewed {
        color: rgb(75 85 99); /* gray-600 */
        border-color: rgb(209 213 219); /* gray-300 */
    }
</style>
