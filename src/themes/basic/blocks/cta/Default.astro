---
/**
 * Default CTA variant — tinted pill with a primary button. The
 * historical rendering that shipped before the variant system
 * existed; kept as the fallback so unknown variant values still
 * render something usable.
 *
 * Reads the seeded `--radius-card` / `--radius-button` vars from
 * `<html style="…">` so two sister sites on the same variant
 * still ship visibly distinct pills.
 */
import type { PageBlock } from '../../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as {
    label?: string;
    url?: string;
    description?: string;
};
---

<section
    class="cta cta--default my-8 p-6 text-center"
    style="background: color-mix(in srgb, var(--brand-primary) 8%, transparent); border-radius: var(--radius-card, 0.5rem);"
>
    {content.description && (
        <p class="brand-text-muted mb-4">{content.description}</p>
    )}
    {content.url && content.label && (
        <a
            href={content.url}
            class="brand-bg-primary inline-block px-6 py-3 font-medium text-white hover:opacity-90"
            style="border-radius: var(--radius-button, 0.375rem);"
        >
            {content.label}
        </a>
    )}
</section>
