---
import type { PageBlock } from '../../../lib/foundry';
import { parseFaq } from '../../../lib/blocks/faq';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, items, anchorId } = parseFaq(block);
---

{items.length > 0 && (
    <section class="my-8">
        {title && (
            <h2 id={anchorId} class="text-2xl font-semibold mb-4">{title}</h2>
        )}
        <div class="divide-y divide-gray-200 rounded-lg border border-gray-200">
            {items.map((qa) => (
                <details class="group p-4">
                    <summary class="cursor-pointer font-medium text-gray-900 group-open:mb-2">
                        {qa.question}
                    </summary>
                    <Markdown text={qa.answer} size="sm" class="text-gray-700" />
                </details>
            ))}
        </div>
    </section>
)}
