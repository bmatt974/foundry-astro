---
/**
 * One ticket card, rendered as one row per OFFER — `variant = 'offers'`.
 *
 * `TicketSimpleRow` aggregates by SELLER, which is the right shape when a
 * seller backs one listing and the wrong one otherwise: on the Colosseum
 * block that left 3 rows of 54 able to name themselves, and 19 rows
 * speaking for products that genuinely differ. One Viator row stood for a
 * 1 h English tour, a 2 h tour and a 1 h 30 one, and showed a single price
 * for the three.
 *
 * Here a row IS a listing. It carries what the API composed for it — the
 * variant label, the language badge — and nothing else claims to describe
 * it. Rows are not merged on a shared label: two offers labelled "2 h" at
 * 25 € and 99 € are not the same product, and only the group they sit in
 * is proven.
 *
 * Half the rows carry no label, and that is an answer rather than a gap:
 * they are admissions and passes, where seller and price ARE the product.
 */
import type { ParsedTicket, TicketSource } from '../../../lib/blocks/tickets';
import { ratingStarless } from '../../../lib/blocks/tickets';
import { useTranslations } from '../../../lib/i18n/index';

interface Props {
    ticket: ParsedTicket;
    headingLevel: 3 | 4 | 5 | 6;
}

const { ticket, headingLevel } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';

const TitleTag = `h${headingLevel}` as 'h3' | 'h4' | 'h5' | 'h6';

/* Cheapest first: the row order IS the comparison the card exists to
   make. Offers with no price sink to the bottom rather than sorting as
   free. */
const offers: TicketSource[] = [...ticket.sources].sort((a, b) => {
    const left = a.priceText === null ? Number.POSITIVE_INFINITY : 0;
    const right = b.priceText === null ? Number.POSITIVE_INFINITY : 0;
    return left - right;
});

const cardRating = ratingStarless(ticket.ratingText);
---

<li id={`ticket-${ticket.id}`} class="flex flex-col gap-3 p-4">
    <div class="space-y-1.5">
        <TitleTag class="text-base !font-bold leading-snug" style="color: #1f2937">{ticket.title}</TitleTag>

        {(cardRating || ticket.badges.length > 0) && (
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-sm" style="color: #1f2937">
                {cardRating && (
                    <span class="inline-flex items-center gap-1">
                        <span style="color: var(--brand-accent-rating)" aria-hidden="true">★</span>
                        <span>{cardRating}</span>
                    </span>
                )}
                {ticket.badges.slice(0, 4).map((badge) => (
                    <span
                        class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium"
                        style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                    >
                        {badge.label}
                    </span>
                ))}
            </div>
        )}

        {/* Languages every offer on this card speaks, then how many speak
            the visitor's — both composed API-side, printed verbatim. */}
        {ticket.languageNames.length > 0 && (
            <p class="brand-text-muted text-xs">
                {ticket.languageNames.map((language) => language.name).join(' · ')}
            </p>
        )}
        {ticket.languageNote && (
            <p class="brand-text-muted text-xs font-medium">{ticket.languageNote}</p>
        )}
    </div>

    <ul class="brand-border divide-y rounded-md border bg-gray-50">
        {offers.map((offer) => (
            <li class="flex flex-col gap-2 p-3 sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:p-2.5">
                <div class="flex min-w-0 flex-col gap-0.5">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                        {/* The label names the PRODUCT. When the API sends
                            none, nothing distinguishes this listing from its
                            siblings beyond who sells it and for how much —
                            which the row already says. */}
                        {offer.variantLabel ? (
                            <span class="font-semibold" style="color: #1f2937">{offer.variantLabel}</span>
                        ) : (
                            <span class="font-semibold" style="color: #1f2937">{offer.providerLabel}</span>
                        )}
                        {offer.language?.badge && (
                            <span
                                class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
                                style="background-color: rgba(0,0,0,0.06); color: #4b5563"
                            >
                                {offer.language.badge}
                            </span>
                        )}
                    </span>
                    <span class="brand-text-muted flex flex-wrap items-center gap-x-2 text-xs">
                        {offer.variantLabel && <span>{offer.providerLabel}</span>}
                        {offer.ratingText && <span>{offer.ratingText}</span>}
                    </span>
                </div>

                <div class="flex items-center justify-between gap-3 sm:justify-end">
                    {offer.priceText && (
                        <span class="text-sm font-semibold tabular-nums" style="color: #111827">{offer.priceText}</span>
                    )}
                    {offer.href && (
                        <a
                            href={offer.href}
                            target="_blank"
                            rel={outboundRel}
                            class="brand-bg-primary inline-flex items-center justify-center rounded-md px-3 py-1.5 text-xs font-medium text-white hover:opacity-90"
                        >
                            {t('tickets.card.book')}
                        </a>
                    )}
                </div>
            </li>
        ))}
    </ul>
</li>
