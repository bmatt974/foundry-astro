---
/**
 * Tickets — the picks strip ("Nos billets conseillés"): one ticket per
 * buying intent, then one per kind of ticket, each linked to its row
 * in the comparator. The API elects every winner; this component only
 * resolves them against the rows the payload ships and labels the
 * slugs.
 *
 * Two homes: the top of the comparator (`standalone` false), or a block
 * of its own above the page's full comparator (`standalone`: the
 * payload's `picks_only`), which then carries the block heading and the
 * strip prints no second title.
 */
import { zonedHref } from '../../../lib/affiliate';
import OfferLink from '../../../components/OfferLink.astro';
import { KNOWN_PICK_SLOTS, type ParsedShelf, type ParsedShelves, type ShelfOffer } from '../../../lib/blocks/ticket-shelves';
import { useTranslations, type TranslationKey } from '../../../lib/i18n/index';
import { serializeJsonLd } from '../../../lib/seo';

interface Props {
    parsed: ParsedShelves;
    standalone?: boolean;
}

const { parsed, standalone = false } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const t = useTranslations(locale, Astro.locals.wording ?? null);
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';

/** Picks resolved against the rows they point at; a pick whose offer
 *  fell out of the page renders nothing. */
const rowById = new Map<number, ShelfOffer>(
    parsed.shelves.flatMap((shelf: ParsedShelf) => shelf.offers.map((offer) => [offer.id, offer])),
);
const picks = parsed.quickPicks.flatMap((pick) => {
    const offer = rowById.get(pick.offerId);
    return offer && pick.slots.length > 0 ? [{ ...pick, offer, name: pick.title ?? offer.title }] : [];
});
/** The price scale opens the strip; a pick it already shows is not
 *  listed a second time below. */
const tiers = standalone ? parsed.tiers : [];
const tieredIds = new Set(tiers.map((tier) => tier.offer.id));
const listedPicks = picks.filter((pick) => !tieredIds.has(pick.offer.id));
const categoryPicks = parsed.categoryPicks.flatMap((pick) => {
    const offer = rowById.get(pick.offerId);
    return offer ? [{ ...pick, offer, name: pick.title ?? offer.title }] : [];
});

/** An API-added slot the dictionaries do not know degrades to its bare
 *  slug instead of leaking a raw translation key path. */
function pickSlotLabel(slot: string, offer?: ShelfOffer): string {
    const label = KNOWN_PICK_SLOTS.includes(slot)
        ? t(`tickets.quickPicks.${slot}` as TranslationKey)
        : slot;

    /* The recommendation carries its REASON when the reason is the
       language. Measured 2026-09-17 on the Acropolis: the resolver
       had just dropped an English-guided tour at 30,60 € for a French
       audio guide at 39,00 €, and the judge read "dearer and worse
       rated" because nothing on the page said why. A verdict without
       its motive is indistinguishable from a bad verdict. */
    /* "Le mieux noté" is chosen among the offers in the reader's
       language when one is rated (2026-11-19): without the suffix, it
       reads false beside a better-rated English tour. */
    return ['recommended', 'best_rated'].includes(slot) && offer?.language?.state === 'match'
        ? `${label} ${t('tickets.quickPicks.inYourLanguage')}`
        : label;
}

/* schema.org ItemList — the picks strip literally answers "what's the
 * cheapest / best ticket?", the exact shape AI Overviews / Perplexity
 * cite. Gated on the per-site `jsonld_level` experiment axis (list
 * markup is beyond article-only postures), URLs are self-referential
 * page anchors, NEVER the affiliate links — structured data must not
 * leak the monetisation layer. */
const jsonldLevel = Astro.locals.tenant?.experiments?.jsonld_level ?? 'none';
const emitSchema = picks.length > 0 && jsonldLevel !== 'none' && jsonldLevel !== 'article_only';
const itemListJson = emitSchema
    ? serializeJsonLd({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: t('tickets.quickPicks.title'),
        itemListElement: picks.map((pick, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: `${pick.slots.map((slot) => pickSlotLabel(slot, pick.offer)).join(' · ')} : ${pick.name}`,
            url: `${Astro.url.origin}${Astro.url.pathname}#offer-${pick.offer.id}`,
        })),
    })
    : null;

const BlockHeading = `h${parsed.headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
/* Inside the comparator the strip is a sidebar to the shelves; on its
   own it IS the block's content, and an <aside> would tell readers and
   extractors (Readability, Trafilatura) to skip it. */
const Strip = standalone ? 'div' : 'aside';
const hasPicks = picks.length > 0 || categoryPicks.length > 0 || tiers.length > 0;
---

{hasPicks && (
    <section id={standalone ? 'ticket-picks' : undefined} class={standalone ? 'tickets-picks my-8' : undefined}>
        {itemListJson && <script type="application/ld+json" is:inline set:html={itemListJson} />}
        {standalone && (
            <BlockHeading class="text-2xl font-semibold mb-3">
                {parsed.heading}
            </BlockHeading>
        )}
        {/* Inside the comparator the strip is boxed off from the shelves;
            on its own it is a plain block, the page's summary above it
            being the one framed. */}
        <Strip aria-label={standalone ? undefined : t('tickets.quickPicks.title')} class={standalone ? 'my-3' : 'brand-border my-5 rounded-lg border bg-gray-50 p-4'}>
            {!standalone && (
                <p class="brand-text-muted mb-2 text-xs font-semibold uppercase tracking-wider">
                    {t('tickets.quickPicks.title')}
                </p>
            )}
            {tiers.length > 0 && (
                <ol class={`mb-4 grid gap-3 ${tiers.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2'}`} data-price-tiers>
                    {tiers.map((tier) => (
                        <li
                            class={`relative flex flex-col rounded-xl border bg-white p-4 ${tier.tier === 'best' ? 'shadow-sm' : 'brand-border'}`}
                            style={tier.tier === 'best' ? 'border-color: var(--brand-primary); border-width: 2px' : undefined}
                            data-price-tier={tier.tier}
                        >
                            <OfferLink href={tier.href} zone="card" rel={outboundRel} label={tier.name} />
                            <p class={`text-xs font-semibold uppercase tracking-wider ${tier.tier === 'best' ? 'brand-text-primary' : 'brand-text-muted'}`}>
                                {t(`tickets.priceTiers.${tier.tier}` as TranslationKey)}
                            </p>
                            <p class="mt-2 text-sm font-semibold leading-snug"><OfferLink href={tier.href} zone="title" rel={outboundRel} class="[color:inherit] no-underline hover:underline">{tier.name}</OfferLink></p>
                            <p class="brand-text-muted mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                                {tier.offer.ratingText && <span>{tier.offer.ratingText}</span>}
                                {tier.offer.durationText && <span>{tier.offer.durationText}</span>}
                                {tier.offer.language?.badge && (
                                    <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium" style="background-color: rgba(0,0,0,0.06); color: #4b5563">
                                        {tier.offer.language.badge}
                                    </span>
                                )}
                            </p>
                            {tier.option && (
                                <p class="brand-text-muted mt-1 text-xs opacity-80">{t('tickets.quickPicks.option', { option: tier.option })}</p>
                            )}
                            <div class="mt-auto flex items-center justify-between gap-3 pt-3 sm:flex-col sm:items-stretch">
                                {tier.offer.priceText && <p class="text-xl font-bold tabular-nums">{tier.offer.priceText}</p>}
                                <a
                                    href={zonedHref(tier.href, 'button') ?? `#offer-${tier.offer.id}`}
                                    target={tier.href ? '_blank' : undefined}
                                    rel={tier.href ? outboundRel : undefined}
                                    class={`relative z-[1] rounded-lg px-4 py-2 text-center text-sm font-semibold hover:opacity-90 ${tier.tier === 'best' ? 'brand-bg-primary text-white' : 'brand-border brand-text-primary border'}`}
                                >
                                    {t('tickets.card.book')}
                                </a>
                            </div>
                        </li>
                    ))}
                </ol>
            )}
            {listedPicks.length > 0 && (
                <ul class="space-y-1.5">
                    {listedPicks.map((pick) => (
                        <li class="flex flex-wrap items-baseline gap-x-2 text-sm">
                            <span class="font-semibold" style="color: #1f2937">
                                {pick.slots.map((slot) => pickSlotLabel(slot, pick.offer)).join(' · ')}
                            </span>
                            <a href={zonedHref(pick.offer.pickHref, 'title') ?? `#offer-${pick.offer.id}`} target={pick.offer.pickHref ? '_blank' : undefined} rel={pick.offer.pickHref ? outboundRel : undefined} class="brand-text-muted underline decoration-dotted">
                                {pick.name}
                            </a>
                            {pick.offer.priceText && (
                                <span class="brand-text-muted tabular-nums">{pick.offer.priceText}</span>
                            )}
                            {pick.option && (
                                <span class="brand-text-muted text-xs opacity-80">{t('tickets.quickPicks.option', { option: pick.option })}</span>
                            )}
                            {pick.reason && (
                                <span class="brand-text-muted basis-full text-xs">{pick.reason}</span>
                            )}
                            {pick.offer.salesOpen && (
                                <span class="brand-text-muted basis-full text-xs">{pick.offer.salesOpen}</span>
                            )}
                        </li>
                    ))}
                </ul>
            )}
            {categoryPicks.length > 0 && (
                <>
                    <p class={`brand-text-muted mb-2 text-xs font-semibold uppercase tracking-wider${listedPicks.length > 0 ? ' mt-4' : ''}`}>
                        {t('tickets.quickPicks.byCategory')}
                    </p>
                    <ul class="space-y-1.5">
                        {categoryPicks.map((pick) => (
                            <li class="flex flex-wrap items-baseline gap-x-2 text-sm">
                                <span class="font-semibold" style="color: #1f2937">
                                    {pick.inPageLanguage
                                        ? `${t(`tickets.shelf.${pick.shelf}` as TranslationKey)} ${t('tickets.quickPicks.inYourLanguage')}`
                                        : t(`tickets.shelf.${pick.shelf}` as TranslationKey)}
                                </span>
                                <a href={zonedHref(pick.offer.pickHref, 'title') ?? `#offer-${pick.offer.id}`} target={pick.offer.pickHref ? '_blank' : undefined} rel={pick.offer.pickHref ? outboundRel : undefined} class="brand-text-muted underline decoration-dotted">
                                    {pick.name}
                                </a>
                                {pick.offer.priceText && (
                                    <span class="brand-text-muted tabular-nums">{pick.offer.priceText}</span>
                                )}
                                {pick.option && (
                                    <span class="brand-text-muted text-xs opacity-80">{t('tickets.quickPicks.option', { option: pick.option })}</span>
                                )}
                            </li>
                        ))}
                    </ul>
                </>
            )}
        </Strip>
    </section>
)}
