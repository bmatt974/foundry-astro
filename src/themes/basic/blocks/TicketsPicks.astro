---
/**
 * Tickets — the picks strip ("Nos choix en bref"): one ticket per
 * buying intent, then one per kind of ticket, each linked to its row
 * in the comparator. The API elects every winner; this component only
 * resolves them against the rows the payload ships and labels the
 * slugs.
 *
 * Two homes: the top of the comparator (`standalone` false), or a block
 * of its own above the page's full comparator (`standalone`: the
 * payload's `picks_only`), which then carries the block heading and the
 * strip prints no second title.
 */
import type { ParsedShelf, ParsedShelves, ShelfOffer } from '../../../lib/blocks/ticket-shelves';
import { useTranslations, type TranslationKey } from '../../../lib/i18n/index';
import { serializeJsonLd } from '../../../lib/seo';

interface Props {
    parsed: ParsedShelves;
    standalone?: boolean;
}

const { parsed, standalone = false } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const t = useTranslations(locale, Astro.locals.wording ?? null);

/** Picks resolved against the rows they point at; a pick whose offer
 *  fell out of the page renders nothing. */
const rowById = new Map<number, ShelfOffer>(
    parsed.shelves.flatMap((shelf: ParsedShelf) => shelf.offers.map((offer) => [offer.id, offer])),
);
const picks = parsed.quickPicks.flatMap((pick) => {
    const offer = rowById.get(pick.offerId);
    return offer && pick.slots.length > 0 ? [{ ...pick, offer }] : [];
});
const categoryPicks = parsed.categoryPicks.flatMap((pick) => {
    const offer = rowById.get(pick.offerId);
    return offer ? [{ ...pick, offer }] : [];
});

/** Slots the dictionaries know; an API-added slot degrades to its bare
 *  slug instead of leaking a raw translation key path. */
const KNOWN_PICK_SLOTS = ['recommended', 'cheapest', 'best_rated', 'most_complete', 'family', 'unusual'];
function pickSlotLabel(slot: string, offer?: ShelfOffer): string {
    const label = KNOWN_PICK_SLOTS.includes(slot)
        ? t(`tickets.quickPicks.${slot}` as TranslationKey)
        : slot;

    /* The recommendation carries its REASON when the reason is the
       language. Measured 2026-09-17 on the Acropolis: the resolver
       had just dropped an English-guided tour at 30,60 € for a French
       audio guide at 39,00 €, and the judge read "dearer and worse
       rated" because nothing on the page said why. A verdict without
       its motive is indistinguishable from a bad verdict. */
    return slot === 'recommended' && offer?.language?.state === 'match'
        ? `${label} — ${t('tickets.quickPicks.inYourLanguage')}`
        : label;
}

/* schema.org ItemList — the picks strip literally answers "what's the
 * cheapest / best ticket?", the exact shape AI Overviews / Perplexity
 * cite. Gated on the per-site `jsonld_level` experiment axis (list
 * markup is beyond article-only postures), URLs are self-referential
 * page anchors, NEVER the affiliate links — structured data must not
 * leak the monetisation layer. */
const jsonldLevel = Astro.locals.tenant?.experiments?.jsonld_level ?? 'none';
const emitSchema = picks.length > 0 && jsonldLevel !== 'none' && jsonldLevel !== 'article_only';
const itemListJson = emitSchema
    ? serializeJsonLd({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: t('tickets.quickPicks.title'),
        itemListElement: picks.map((pick, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: `${pick.slots.map((slot) => pickSlotLabel(slot, pick.offer)).join(' · ')} : ${pick.offer.title}`,
            url: `${Astro.url.origin}${Astro.url.pathname}#offer-${pick.offer.id}`,
        })),
    })
    : null;

const BlockHeading = `h${parsed.headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5';
/* Inside the comparator the strip is a sidebar to the shelves; on its
   own it IS the block's content, and an <aside> would tell readers and
   extractors (Readability, Trafilatura) to skip it. */
const Strip = standalone ? 'div' : 'aside';
const hasPicks = picks.length > 0 || categoryPicks.length > 0;
---

{hasPicks && (
    <section id={standalone ? 'ticket-picks' : undefined} class={standalone ? 'tickets-picks my-8' : undefined}>
        {itemListJson && <script type="application/ld+json" is:inline set:html={itemListJson} />}
        {standalone && (
            <BlockHeading class="brand-text-primary mt-10 mb-4 text-2xl font-bold tracking-tight">
                {parsed.heading}
            </BlockHeading>
        )}
        <Strip aria-label={standalone ? undefined : t('tickets.quickPicks.title')} class="brand-border my-5 rounded-lg border bg-gray-50 p-4">
            {!standalone && (
                <p class="brand-text-muted mb-2 text-xs font-semibold uppercase tracking-wider">
                    {t('tickets.quickPicks.title')}
                </p>
            )}
            {picks.length > 0 && (
                <ul class="space-y-1.5">
                    {picks.map((pick) => (
                        <li class="flex flex-wrap items-baseline gap-x-2 text-sm">
                            <span class="font-semibold" style="color: #1f2937">
                                {pick.slots.map((slot) => pickSlotLabel(slot, pick.offer)).join(' · ')}
                            </span>
                            <a href={`#offer-${pick.offer.id}`} class="brand-text-muted underline decoration-dotted">
                                {pick.offer.title}
                            </a>
                            {pick.offer.priceText && (
                                <span class="brand-text-muted tabular-nums">{pick.offer.priceText}</span>
                            )}
                        </li>
                    ))}
                </ul>
            )}
            {categoryPicks.length > 0 && (
                <>
                    <p class={`brand-text-muted mb-2 text-xs font-semibold uppercase tracking-wider${picks.length > 0 ? ' mt-4' : ''}`}>
                        {t('tickets.quickPicks.byCategory')}
                    </p>
                    <ul class="space-y-1.5">
                        {categoryPicks.map((pick) => (
                            <li class="flex flex-wrap items-baseline gap-x-2 text-sm">
                                <span class="font-semibold" style="color: #1f2937">
                                    {t(`tickets.shelf.${pick.shelf}` as TranslationKey)}
                                </span>
                                <a href={`#offer-${pick.offer.id}`} class="brand-text-muted underline decoration-dotted">
                                    {pick.offer.title}
                                </a>
                                {pick.offer.priceText && (
                                    <span class="brand-text-muted tabular-nums">{pick.offer.priceText}</span>
                                )}
                            </li>
                        ))}
                    </ul>
                </>
            )}
        </Strip>
    </section>
)}
