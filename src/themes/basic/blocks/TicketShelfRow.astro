---
/**
 * One shelf row = one LISTING, speaking only for itself.
 *
 * The price leads the eye and the title names the product — the offer's
 * own localized title, never a computed label. The badges beside it are
 * the axes that used to partition cards (zones, experience, group type,
 * bundle subtype), demoted to row facts.
 *
 * Editor knobs honoured here: provider indicator (favicon / dot / logo /
 * none), photos, price-as-button, CTA label and arrow, the highlight
 * chip the shelf computed. Chrome discipline holds: slugs map to labels
 * through the dictionaries; the language badge and every zone name
 * arrive composed by the API.
 */
import { shelfBadgeLabels, type ShelfOffer, type ShelfSettings, type TicketShelfSlug } from '../../../lib/blocks/ticket-shelves';
import { useTranslations } from '../../../lib/i18n/index';

interface Props {
    offer: ShelfOffer;
    shelf: TicketShelfSlug;
    settings: ShelfSettings;
    /** Zones the section header already states — not repeated per row. */
    omitZones?: string[];
}

const { offer, shelf, settings, omitZones = [] } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';

const badges = shelfBadgeLabels(offer, shelf, t, omitZones);

/** Combos worth a mention: venues beyond this page's own group. */
const coveredNames = offer.coveredPlaces.map((place) => place.name).slice(0, 3);

/* The chip is an API verdict carried by the row — the front dresses it. */
const highlightLabel = offer.highlight === 'best_price'
    ? t('tickets.card.bestPrice')
    : offer.highlight === 'best_rated' ? t('tickets.card.bestRated') : null;

const ctaLabel = settings.ctaLabel ?? t('tickets.card.book');
const arrow = settings.showProviderArrow ? ' →' : '';
const showThumbnail = settings.showPhotos && offer.imageUrl !== null;
---

<li id={`offer-${offer.id}`} class="flex flex-col gap-2 p-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
    <div class="flex min-w-0 items-start gap-3">
        {showThumbnail && (
            <img
                src={offer.imageUrl}
                alt=""
                loading="lazy"
                class="hidden h-14 w-14 shrink-0 rounded-md object-cover sm:block"
            />
        )}
        <div class="flex min-w-0 flex-col gap-1">
            <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <span class="text-sm font-semibold leading-snug" style="color: #1f2937">{offer.title}</span>
                {highlightLabel && (
                    <span
                        class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide"
                        style="background-color: color-mix(in srgb, var(--brand-accent-rating) 15%, transparent); color: var(--brand-accent-rating)"
                    >
                        {highlightLabel}
                    </span>
                )}
                {offer.language?.badge && (
                    <span
                        class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
                        style="background-color: rgba(0,0,0,0.06); color: #4b5563"
                    >
                        {offer.language.badge}
                    </span>
                )}
            </span>

            <span class="brand-text-muted flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
                {settings.providerIndicator === 'favicon' && offer.providerFaviconPath && (
                    <img src={offer.providerFaviconPath} alt="" loading="lazy" class="h-3.5 w-3.5 rounded-sm" />
                )}
                {settings.providerIndicator === 'logo' && offer.providerLogoPath && (
                    <img src={offer.providerLogoPath} alt={offer.providerLabel} loading="lazy" class="h-3.5 max-w-16 object-contain" />
                )}
                {settings.providerIndicator === 'dot' && (
                    <span
                        class="inline-block h-2 w-2 rounded-full"
                        style={`background-color: ${offer.providerBrandColor ?? '#9ca3af'}`}
                        aria-hidden="true"
                    ></span>
                )}
                {settings.providerIndicator !== 'logo' && <span>{offer.providerLabel}</span>}
                {offer.ratingText && <span>{offer.ratingText}</span>}
                {offer.durationText && <span>{offer.durationText}</span>}
                {badges.map((badge) => (
                    <span
                        class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium"
                        style="background-color: color-mix(in srgb, var(--brand-accent-success) 12%, transparent); color: var(--brand-accent-success)"
                    >
                        {badge}
                    </span>
                ))}
            </span>

            {coveredNames.length > 0 && (
                <span class="brand-text-muted text-xs">+ {coveredNames.join(' · ')}</span>
            )}
        </div>
    </div>

    <div class="flex shrink-0 items-center justify-between gap-3 sm:justify-end">
        {settings.priceAsButton && offer.href ? (
            <a
                href={offer.href}
                target="_blank"
                rel={outboundRel}
                class="brand-bg-primary inline-flex items-center justify-center rounded-md px-3 py-1.5 text-xs font-semibold tabular-nums text-white hover:opacity-90"
            >
                {offer.priceText ?? ctaLabel}{arrow}
            </a>
        ) : (
            <>
                {offer.priceText && (
                    <span class="text-sm font-semibold tabular-nums" style="color: #111827">{offer.priceText}</span>
                )}
                {offer.href && (
                    <a
                        href={offer.href}
                        target="_blank"
                        rel={outboundRel}
                        class="brand-bg-primary inline-flex items-center justify-center rounded-md px-3 py-1.5 text-xs font-medium text-white hover:opacity-90"
                    >
                        {ctaLabel}{arrow}
                    </a>
                )}
            </>
        )}
    </div>
</li>
