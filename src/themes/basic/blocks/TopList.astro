---
/**
 * Top-N list of places (POIs, attractions, etc.). The most common
 * block type by far on SERP-driven sites — see `culture-a-rome` which
 * stacks 20 of these. Renders as a responsive grid of cards so the
 * page reads like a real "top 10" article.
 *
 * Content shape (PlacesTopListSource output):
 *   { heading: string, items: Array<{ place_id, name, type, image }> }
 *
 * Future extensions handled gracefully by optional chaining:
 * `description`, `rank`, `url`, `coordinates`. When the backend starts
 * emitting them they'll surface without further frontend changes.
 */
import type { PageBlock } from '../../../lib/foundry';
import { imageSrcset, imageUrl } from '../../../lib/image';

interface Item {
    place_id?: number;
    name?: string;
    type?: string;
    image?: string | null;
    description?: string;
    url?: string;
    rank?: number;
}

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as { heading?: string; items?: Item[] };
const items = (content.items ?? []).filter((item) => item && (item.name || item.place_id));
---

{items.length > 0 && (
    <section class="my-10">
        {content.heading && (
            <h2 class="brand-text-primary mb-5 text-2xl font-semibold tracking-tight">
                {content.heading}
            </h2>
        )}
        <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((item) => (
                <li class="brand-border group overflow-hidden rounded-lg border bg-white shadow-sm transition hover:shadow-md">
                    {item.image ? (
                        <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                            <img
                                src={imageUrl(item.image, { width: 480 })}
                                srcset={imageSrcset(item.image, [320, 480, 800, 1200])}
                                sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
                                alt={item.name ?? ''}
                                loading="lazy"
                                width="480"
                                height="360"
                                class="h-full w-full object-cover transition group-hover:scale-105"
                            />
                        </div>
                    ) : (
                        <div class="brand-border aspect-[4/3] border-b bg-gray-50" aria-hidden="true">
                            <div class="brand-text-muted flex h-full items-center justify-center text-xs uppercase tracking-wider">
                                {item.type ?? 'place'}
                            </div>
                        </div>
                    )}
                    <div class="p-4">
                        {item.type && (
                            <p class="brand-text-muted mb-1 text-xs uppercase tracking-wider">
                                {item.type.replace(/_/g, ' ')}
                            </p>
                        )}
                        <h3 class="text-base font-semibold leading-snug">
                            {item.url ? (
                                <a href={item.url} class="brand-link">{item.name}</a>
                            ) : (
                                item.name
                            )}
                        </h3>
                        {item.description && (
                            <p class="brand-text-muted mt-2 text-sm leading-relaxed">
                                {item.description}
                            </p>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    </section>
)}
