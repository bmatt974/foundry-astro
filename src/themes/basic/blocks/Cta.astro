---
/**
 * CTA block dispatcher — picks the variant component to render based
 * on `block.variant`. One variant = one file under `./cta/`. Adding
 * a new variant = drop a file, register it in the map below.
 *
 * Unknown / null variants fall back to `Default` — backwards-
 * compatible with every existing block in the DB.
 */
import type { PageBlock } from '../../../lib/foundry';
import Bordered from './cta/Bordered.astro';
import Default from './cta/Default.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;

const variants = {
    default: Default,
    bordered: Bordered,
} as const;

const variant = block.variant && block.variant in variants
    ? block.variant as keyof typeof variants
    : 'default';
const Variant = variants[variant];
---

<Variant block={block} />
