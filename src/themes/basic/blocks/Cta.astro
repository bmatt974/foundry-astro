---
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as {
    label?: string;
    url?: string;
    description?: string;
};
---

<section class="my-8 rounded-lg p-6 text-center" style="background: color-mix(in srgb, var(--brand-primary) 8%, transparent);">
    {content.description && (
        <p class="brand-text-muted mb-4">{content.description}</p>
    )}
    {content.url && content.label && (
        <a
            href={content.url}
            class="brand-bg-primary inline-block rounded-md px-6 py-3 font-medium text-white hover:opacity-90"
        >
            {content.label}
        </a>
    )}
</section>
