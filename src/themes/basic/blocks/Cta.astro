---
/**
 * CTA block with variant-driven rendering. The `block.variant` field
 * comes from the CMS (`page_blocks.variant`) and picks which visual
 * treatment to apply — same content, different layout. Themes are
 * responsible for declaring every variant they support; unknown
 * variants fall back to `default`.
 *
 * Variants in the basic theme:
 *
 *   - `default`         : filled tint pill (brand-color background at
 *                         8% opacity) with a primary button — the
 *                         pattern this block used before the variant
 *                         system was introduced.
 *   - `bordered`        : html5up Editorial–style: bordered card with
 *                         no fill, button-driven. Static-site feel.
 *
 * Seeded tokens (`--radius-card`, `--radius-button`, `--shadow-card`)
 * come from `tokens.ts` and vary per website slug — so two sister
 * sites on the same theme + variant still ship visually distinct
 * cards.
 */
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as {
    label?: string;
    url?: string;
    description?: string;
};
const variant = block.variant ?? 'default';
---

{variant === 'bordered' ? (
    <section
        class="cta cta--bordered my-8 border p-6 text-center"
        style="border-radius: var(--radius-card, 0.5rem); box-shadow: var(--shadow-card, 0 1px 2px 0 rgba(0,0,0,0.05));"
    >
        {content.description && (
            <p class="brand-text-muted mb-4">{content.description}</p>
        )}
        {content.url && content.label && (
            <a
                href={content.url}
                class="brand-text-primary inline-block border-2 px-6 py-3 font-medium hover:opacity-80"
                style="border-color: currentColor; border-radius: var(--radius-button, 0.375rem);"
            >
                {content.label}
            </a>
        )}
    </section>
) : (
    <section
        class="cta cta--default my-8 p-6 text-center"
        style={`background: color-mix(in srgb, var(--brand-primary) 8%, transparent); border-radius: var(--radius-card, 0.5rem);`}
    >
        {content.description && (
            <p class="brand-text-muted mb-4">{content.description}</p>
        )}
        {content.url && content.label && (
            <a
                href={content.url}
                class="brand-bg-primary inline-block px-6 py-3 font-medium text-white hover:opacity-90"
                style="border-radius: var(--radius-button, 0.375rem);"
            >
                {content.label}
            </a>
        )}
    </section>
)}
