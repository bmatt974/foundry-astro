---
/**
 * CTA — basic theme markup. Generic html5up-ish "card with button"
 * pattern, no CMS-specific class names. Anchored to the seeded
 * design tokens (`--radius-card`, `--radius-button`, `--shadow-card`)
 * so two sister sites on the same theme still ship visibly distinct
 * cards.
 */
import type { PageBlock } from '../../../lib/foundry';
import { isExternalUrl, parseCta } from '../../../lib/blocks/cta';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const cta = parseCta(block);
---

{cta && (
    <section
        class="cta my-8 p-6 text-center"
        style="background: color-mix(in srgb, var(--brand-primary) 8%, transparent); border-radius: var(--radius-card, 0.5rem);"
    >
        {cta.description && (
            <p class="brand-text-muted mb-4">{cta.description}</p>
        )}
        <a
            href={cta.url}
            class="brand-bg-primary inline-block px-6 py-3 font-medium text-white hover:opacity-90"
            style="border-radius: var(--radius-button, 0.375rem);"
            {...(isExternalUrl(cta.url) && { rel: 'noopener', target: '_blank' })}
        >
            {cta.label}
        </a>
    </section>
)}
