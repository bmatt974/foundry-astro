---
import type { PageBlock } from '../../../lib/foundry';
import { parseImage } from '../../../lib/blocks/image';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const image = parseImage(block);
---

{image && (
    <figure class="content-image">
        <img
            src={image.src}
            srcset={image.srcset ?? undefined}
            sizes={image.srcset ? '(max-width: 760px) 100vw, 720px' : undefined}
            alt={image.alt}
            width={image.width ?? undefined}
            height={image.height ?? undefined}
            loading="lazy"
            decoding="async"
        />
        {(image.caption || image.credit) && (
            <figcaption>
                {image.caption}
                {image.credit && <small class="content-image__credit"> — {image.credit}</small>}
            </figcaption>
        )}
    </figure>
)}
