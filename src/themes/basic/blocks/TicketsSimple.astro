---
/**
 * Tickets — `variant = 'simple'`.
 *
 * Editorial-friendly layout : sits naturally inside an article's
 * flow of content blocks (text / faq / top_list). The renderer
 * reads `settings.heading_level` (default 3) and
 * `settings.heading_text` to integrate with the surrounding
 * heading hierarchy, and `settings.filter_*` to scope the inventory
 * to a slice (private only, photo only, family + workshop, …).
 *
 * Two layouts driven by `parsed.layout` :
 *   - 'single'      : one heading + flat list (filter narrowed to
 *                     one bucket OR editor authored a custom title)
 *   - 'per-bucket'  : each surviving bucket gets its own H_n header
 *                     (no top heading)
 *
 * No images, no badges, no chip filters — keeps the block visually
 * lean inside text-heavy pages. Richer variants ship as siblings
 * dispatched by `Tickets.astro`. Per-row meta (rating, duration,
 * bundle coverage hint) lives in `TicketSimpleRow.astro`.
 */
import {
    parseTicketsBlock,
    type ParsedBucket,
    type ParsedTicket,
} from '../../../lib/blocks/tickets';
import { groupBundleTickets } from '../../../lib/tickets/bundle-subgroups';
import { groupAccessTickets } from '../../../lib/tickets/access-subgroups';
import { useTranslations } from '../../../lib/i18n/index';
import { formatDate } from '../../../lib/format';
import type { PageBlock } from '../../../lib/foundry';
import TicketSimpleRow from './TicketSimpleRow.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const linkProxyPath = Astro.locals.tenant?.experiments?.link_proxy_path ?? 'go';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);

const parsed = parseTicketsBlock(block, locale, linkProxyPath, wording);
const { totalCount, layout, settings } = parsed;
const visibleBuckets = parsed.buckets.filter((b: ParsedBucket) => b.tickets.length > 0);

// The block's top heading is painted by the DISPATCHER (Tickets.astro)
// at H_N — above the entry note and the quick-picks strip, for every
// variant. Levels inside this variant nest under it :
//   single     : TicketHeading at H_(N+1).
//   per-bucket : SubHeading at H_(N+1), TicketHeading at H_(N+2).
const topLevel = settings.headingLevel;
const subLevel = Math.min(topLevel + 1, 6);
const ticketLevel = (layout === 'single'
    ? Math.min(topLevel + 1, 6)
    : Math.min(topLevel + 2, 6)) as 3 | 4 | 5 | 6;

const SubHeading = `h${subLevel}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

// Flat list when 'single' layout — concatenate every bucket's
// tickets in display order so the format hierarchy doesn't leak.
const flatTickets = layout === 'single'
    ? visibleBuckets.flatMap((b) => b.tickets)
    : [];

const filtersAreActive
    = settings.filterFormat.length > 0
    || settings.filterGroupType.length > 0
    || settings.filterExperienceType.length > 0;

/** Max tickets a bundle sub-group shows before the tail collapses
 *  behind a "Show N more offers" disclosure. */
const BUNDLE_GROUP_CAP = 6;

/* "Tarifs mis à jour le {date}" — dated price observations are a
 * legal requirement for FR price comparators, and honest expectation
 * management everywhere else. Hidden until the window-price refresher
 * has covered this Place. */
const pricesCheckedOn = parsed.pricesCheckedAt !== null
    ? formatDate(parsed.pricesCheckedAt, locale)
    : null;
---

{totalCount === 0 && filtersAreActive && (
    <section class="tickets-simple my-8">
        <div class="brand-border rounded-lg border bg-white p-6 text-center">
            <p class="brand-text-muted text-sm">{t('tickets.bucket.empty')}</p>
        </div>
    </section>
)}

{visibleBuckets.length > 0 && (
    <section class="tickets-simple my-8">
        {layout === 'single' ? (
            <ul class="brand-border divide-y rounded-lg border bg-white">
                {flatTickets.map((ticket) => (
                    <TicketSimpleRow ticket={ticket} headingLevel={ticketLevel} settings={settings} />
                ))}
            </ul>
        ) : (
            <div class="space-y-8">
                {visibleBuckets.map((bucket: ParsedBucket) => {
                    /* Bundle bucket sub-axis : the aggregator classifies
                       each Bundle ticket as `card` / `day_trip` /
                       `bus` / `cruise` / `combo`. When ≥ 2 sub-types
                       are present we paint sub-headers so the 15+
                       Passes & Combos list reads as scannable groups.
                       Single-subtype buckets render flat (no
                       redundant sub-header above a flat list). The
                       bucket header itself keeps the TOTAL count
                       (16 = sum of sub-groups). */
                    const bundleGroups = bucket.format === 'bundle' ? groupBundleTickets(bucket.tickets) : [];
                    const showBundleSubsections = bundleGroups.length > 1;
                    /* Access bucket sub-axis : Officiel / Avec audio
                       guide / Coupe-file. Classified server-side from
                       the feature pivot. Single-subtype buckets render
                       flat (no redundant h4 above a flat list). */
                    const accessGroups = bucket.format === 'access' ? groupAccessTickets(bucket.tickets) : [];
                    const showAccessSubsections = accessGroups.length > 1;
                    return (
                        <article aria-labelledby={`tickets-simple-${bucket.format}`}>
                            <SubHeading
                                id={`tickets-simple-${bucket.format}`}
                                class="brand-text-primary mb-4 text-lg font-semibold tracking-tight"
                            >
                                {bucket.label} <span class="brand-text-muted ml-1 text-sm font-normal">({bucket.tickets.length})</span>
                            </SubHeading>
                            {bucket.format === 'bundle' ? (
                                /* Bundle groups are capped : the tail of an
                                   oversized group (13 combos on a tier-1
                                   Place) collapses behind a native
                                   <details> so the bucket stops owning the
                                   page's scroll. Sub-headers only render
                                   when ≥ 2 sub-types survive — single-
                                   subtype buckets stay visually flat but
                                   still get the cap. */
                                <div class="space-y-6">
                                    {bundleGroups.map((group) => {
                                        const visibleTickets = group.tickets.slice(0, BUNDLE_GROUP_CAP);
                                        const overflowTickets = group.tickets.slice(BUNDLE_GROUP_CAP);
                                        return (
                                            <section aria-labelledby={showBundleSubsections ? `tickets-simple-sub-${bucket.format}-${group.subtype}` : undefined}>
                                                {showBundleSubsections && (
                                                    <h4 id={`tickets-simple-sub-${bucket.format}-${group.subtype}`} class="brand-text-primary mb-2 text-base font-semibold">
                                                        {t(`tickets.bundleSubtype.${group.subtype}`)} <span class="brand-text-muted ml-1 text-sm font-normal">({group.tickets.length})</span>
                                                    </h4>
                                                )}
                                                <ul class="brand-border divide-y rounded-lg border bg-white">
                                                    {visibleTickets.map((ticket) => (
                                                        <TicketSimpleRow ticket={ticket} headingLevel={ticketLevel} settings={settings} />
                                                    ))}
                                                </ul>
                                                {overflowTickets.length > 0 && (
                                                    <details class="mt-2">
                                                        <summary class="brand-text-muted cursor-pointer list-none text-sm underline [&::-webkit-details-marker]:hidden">
                                                            {t('tickets.bucket.showMore', { count: String(overflowTickets.length) })} ›
                                                        </summary>
                                                        <ul class="brand-border mt-2 divide-y rounded-lg border bg-white">
                                                            {overflowTickets.map((ticket) => (
                                                                <TicketSimpleRow ticket={ticket} headingLevel={ticketLevel} settings={settings} />
                                                            ))}
                                                        </ul>
                                                    </details>
                                                )}
                                            </section>
                                        );
                                    })}
                                </div>
                            ) : showAccessSubsections ? (
                                <div class="space-y-6">
                                    {accessGroups.map((group) => (
                                        <section aria-labelledby={`tickets-simple-sub-${bucket.format}-${group.subtype}`}>
                                            <h4 id={`tickets-simple-sub-${bucket.format}-${group.subtype}`} class="brand-text-primary mb-2 text-base font-semibold">
                                                {t(`tickets.accessSubtype.${group.subtype}`)} <span class="brand-text-muted ml-1 text-sm font-normal">({group.tickets.length})</span>
                                            </h4>
                                            <ul class="brand-border divide-y rounded-lg border bg-white">
                                                {group.tickets.map((ticket) => (
                                                    <TicketSimpleRow ticket={ticket} headingLevel={ticketLevel} settings={settings} />
                                                ))}
                                            </ul>
                                        </section>
                                    ))}
                                </div>
                            ) : (
                                <ul class="brand-border divide-y rounded-lg border bg-white">
                                    {bucket.tickets.map((ticket) => (
                                        <TicketSimpleRow ticket={ticket} headingLevel={ticketLevel} settings={settings} />
                                    ))}
                                </ul>
                            )}
                        </article>
                    );
                })}
            </div>
        )}

        {pricesCheckedOn && (
            <p class="brand-text-muted mt-4 text-xs italic">
                {t('tickets.compare.pricesUpdated')}{' '}<time datetime={parsed.pricesCheckedAt}>{pricesCheckedOn}</time>
            </p>
        )}
    </section>
)}
