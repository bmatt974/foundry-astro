---
import { type ResolvedAuthor } from '../../../lib/author';
import type { PageTranslation } from '../../../lib/foundry';
import { formatDate } from '../../../lib/format';
import { useTranslations } from '../../../lib/i18n';
import AuthorByline from './AuthorByline.astro';
import Markdown from './Markdown.astro';

interface Props {
    translation: PageTranslation | null;
    publishedAt?: string | null;
    updatedAt?: string | null;
    /** Used when translation has no title — e.g. work-in-progress preview pages. */
    fallbackTitle?: string;
    authors?: ResolvedAuthor[];
}

const { translation: t, publishedAt = null, updatedAt = null, fallbackTitle, authors = [] } = Astro.props;
const title = t?.title ?? fallbackTitle ?? 'Untitled';
const locale = Astro.locals.locale ?? 'en';
const tr = useTranslations(locale, Astro.locals.wording);
const publishedAbs = formatDate(publishedAt, locale);
const updatedAbs = formatDate(updatedAt, locale);
const showUpdated = !!updatedAbs && updatedAbs !== publishedAbs;
const showMeta = !!publishedAbs || showUpdated || authors.length > 0;
---

<header class="brand-border mb-10 border-b pb-6">
    {t?.eyebrow && (
        <p class="brand-text-primary mb-2 text-sm font-medium uppercase tracking-wide">
            {t.eyebrow}
        </p>
    )}
    <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
    {t?.subtitle && <p class="brand-text-muted mt-3 text-xl">{t.subtitle}</p>}
    {showMeta && (
        <p class="brand-text-muted mt-3 text-xs">
            {publishedAbs && publishedAt && (
                <time datetime={publishedAt}>
                    {tr('pageMeta.publishedOn')} {publishedAbs}
                </time>
            )}
            {showUpdated && publishedAbs && <span>{' • '}</span>}
            {showUpdated && (
                <time datetime={updatedAt ?? undefined}>
                    {tr('pageMeta.updatedOn')} {updatedAbs}
                </time>
            )}
            {authors.length > 0 && (publishedAbs || showUpdated) && <span>{' • '}</span>}
            {authors.length > 0 && (
                <AuthorByline authors={authors} locale={locale} inline />
            )}
        </p>
    )}
    {t?.intro && <Markdown text={t.intro} size="lg" class="mt-6" />}
</header>
