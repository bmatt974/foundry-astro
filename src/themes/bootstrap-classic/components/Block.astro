---
/**
 * Dispatches a block to the per-type component for this theme. Adding a
 * new block_type means dropping a component file under `../blocks/` and
 * registering it in `blockComponents`. Unknown types fall back to
 * <Default /> so the page still renders.
 *
 * This component is theme-internal — pages reach it via `theme.Block`
 * (see `src/themes/registry.ts`). Each theme owns its own Block.astro
 * so the markup can differ wildly across themes.
 */
import type { PageBlock } from '../../../lib/foundry';
import Text from '../blocks/Text.astro';
import KeyFacts from '../blocks/KeyFacts.astro';
import Faq from '../blocks/Faq.astro';
import Cta from '../blocks/Cta.astro';
import Comparison from '../blocks/Comparison.astro';
import MetaSearch from '../blocks/MetaSearch.astro';
import Section from '../blocks/Section.astro';
import TopList from '../blocks/TopList.astro';
import Image from '../blocks/Image.astro';
import Gallery from '../blocks/Gallery.astro';
import Default from '../blocks/Default.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;

const blockComponents: Partial<Record<string, any>> = {
    text: Text,
    summary: Text,
    key_facts: KeyFacts,
    faq: Faq,
    cta: Cta,
    section: Section,
    top_list: TopList,
    comparison: Comparison,
    meta_search: MetaSearch,
    image: Image,
    gallery: Gallery,
};

const Component = blockComponents[block.block_type] ?? Default;
---

<Component block={block} />
