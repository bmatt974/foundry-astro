---
import type { PageBlock } from '../../../lib/foundry';
import { parseImage } from '../../../lib/blocks/image';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const image = parseImage(block);
---

{image && (
    <figure class="figure d-block my-4">
        <img
            src={image.src}
            srcset={image.srcset ?? undefined}
            sizes={image.srcset ? '(max-width: 767px) 100vw, 730px' : undefined}
            alt={image.alt}
            width={image.width ?? undefined}
            height={image.height ?? undefined}
            class="figure-img img-fluid rounded"
            loading="lazy"
            decoding="async"
        />
        {(image.caption || image.credit) && (
            <figcaption class="figure-caption">
                {image.caption}
                {image.credit && <span class="text-muted"> · {image.credit}</span>}
            </figcaption>
        )}
    </figure>
)}
