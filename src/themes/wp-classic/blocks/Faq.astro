---
import type { PageBlock } from '../../../lib/foundry';
import { parseFaq } from '../../../lib/blocks/faq';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, items, anchorId } = parseFaq(block);
---

{items.length > 0 && (
    <section class="wp-block-group wp-block-group--faq">
        {title && (
            <h2 id={anchorId} class="wp-block-heading">{title}</h2>
        )}
        <div class="wp-block-details-group">
            {items.map((qa) => (
                <details class="wp-block-details">
                    <summary>{qa.question}</summary>
                    <div class="wp-block-details__answer">
                        <Markdown text={qa.answer} />
                    </div>
                </details>
            ))}
        </div>
    </section>
)}
