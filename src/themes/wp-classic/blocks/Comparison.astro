---
import type { PageBlock } from '../../../lib/foundry';
import { parseComparison } from '../../../lib/blocks/comparison';
import { useTranslations, type TranslationKey } from '../../../lib/i18n/index';
import { formatDate, formatRelativeDate } from '../../../lib/format';
import { anchorIdFor } from '../../../lib/toc';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const locale = Astro.locals.locale ?? 'en';
const linkProxyPath = Astro.locals.tenant?.experiments?.link_proxy_path ?? 'go';
const outboundRel = Astro.locals.tenant?.website?.outbound_links?.rel ?? 'nofollow';
const wording = Astro.locals.wording ?? null;
const t = useTranslations(locale, wording);
const { heading, rows, labels } = parseComparison(block.content, locale, linkProxyPath, (bucket) =>
    t(`tickets.shelf.${bucket}` as TranslationKey),
);
const publishedAt = Astro.locals.pagePublishedAt ?? null;
const relativeUpdated = formatRelativeDate(publishedAt, locale);
const absoluteUpdated = formatDate(publishedAt, locale);
---

{rows.length > 0 && (
    <section class="wp-block-group wp-block-group--comparison">
        {heading && <h2 id={anchorIdFor(block, heading)} class="wp-block-heading">{heading}</h2>}

        <figure class="wp-block-table wp-block-comparison-table">
            <table>
                <thead>
                    <tr>
                        <th scope="col">{labels.headers.type}</th>
                        <th scope="col" class="has-text-align-center">{labels.headers.coupeFile}</th>
                        <th scope="col" class="has-text-align-center">{labels.headers.audioGuide}</th>
                        <th scope="col" class="has-text-align-center">{labels.headers.liveGuide}</th>
                        <th scope="col" class="has-text-align-center">{labels.headers.freeCancellation}</th>
                        <th scope="col" class="has-text-align-right">{labels.headers.price}</th>
                        <th scope="col">{labels.headers.cta}</th>
                    </tr>
                </thead>
                <tbody>
                    {rows.map((row) => (
                        <tr>
                            <td>
                                <strong>{row.label}</strong>
                                {row.title && <div class="wp-block-comparison-table__detail">{row.title}</div>}
                                {row.extras > 0 && (
                                    <em class="wp-block-comparison-table__extras">{labels.moreOptions(row.extras)}</em>
                                )}
                            </td>
                            <td class="has-text-align-center">{row.features.coupeFile ? '✅' : '❌'}</td>
                            <td class="has-text-align-center">{row.features.audioGuide ? '✅' : '❌'}</td>
                            <td class="has-text-align-center">{row.features.liveGuide ? '✅' : '❌'}</td>
                            <td class="has-text-align-center">{row.features.freeCancellation ? '✅' : '❌'}</td>
                            <td class="has-text-align-right">
                                {row.priceText && <strong>{row.priceText}</strong>}
                                {row.providerLabel && <div class="wp-block-comparison-table__provider">{row.providerLabel}</div>}
                                {row.ratingText && <div class="wp-block-comparison-table__rating">{row.ratingText}</div>}
                            </td>
                            <td>
                                {row.ctaHref && (
                                    <a href={row.ctaHref} target="_blank" rel={outboundRel} class="wp-block-button__link">
                                        {labels.cta}
                                    </a>
                                )}
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
            {relativeUpdated && publishedAt && (
                <figcaption class="wp-element-caption wp-block-comparison-table__updated">
                    {labels.pricesUpdatedPrefix}{' '}
                    <time datetime={publishedAt} title={absoluteUpdated ?? undefined}>
                        {relativeUpdated}
                    </time>
                </figcaption>
            )}
        </figure>
    </section>
)}
