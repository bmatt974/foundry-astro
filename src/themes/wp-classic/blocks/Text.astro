---
import type { PageBlock } from '../../../lib/foundry';
import { parseText } from '../../../lib/blocks/text';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, body, anchorId } = parseText(block);
---

<article class="wp-block-group wp-block-group--text">
    {title && (
        <h2 id={anchorId} class="wp-block-heading">{title}</h2>
    )}
    <Markdown text={body} />
</article>
