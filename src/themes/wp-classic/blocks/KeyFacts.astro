---
import type { PageBlock } from '../../../lib/foundry';
import { parseKeyFacts } from '../../../lib/blocks/key-facts';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, facts, freeForm, anchorId } = parseKeyFacts(block);
const hasContent = facts.length > 0 || freeForm.length > 0;
---

{hasContent && (
    <aside class="wp-block-key-facts">
        {title && (
            <h2 id={anchorId} class="wp-block-heading wp-block-key-facts__title">{title}</h2>
        )}
        <ul class="wp-block-columns">
            {facts.map((f) => (
                <li class="wp-block-column">
                    <p class="wp-block-column__label">{f.label}</p>
                    <p class="wp-block-column__value">{f.value}</p>
                </li>
            ))}
            {freeForm.map((line) => (
                <li class="wp-block-column"><p class="wp-block-column__value">{line}</p></li>
            ))}
        </ul>
    </aside>
)}
