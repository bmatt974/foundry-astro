---
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as {
    title?: string;
    facts?: Array<{ label: string; value: string } | string>;
};
const facts = content.facts ?? [];
---

<aside class="wp-block-key-facts">
    {content.title && <h2 class="wp-block-heading wp-block-key-facts__title">{content.title}</h2>}
    {facts.length > 0 && (
        <ul class="wp-block-columns">
            {facts.map((f) =>
                typeof f === 'string' ? (
                    <li class="wp-block-column"><p class="wp-block-column__value">{f}</p></li>
                ) : (
                    <li class="wp-block-column">
                        <p class="wp-block-column__label">{f.label}</p>
                        <p class="wp-block-column__value">{f.value}</p>
                    </li>
                ),
            )}
        </ul>
    )}
</aside>
