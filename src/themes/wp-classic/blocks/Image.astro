---
import type { PageBlock } from '../../../lib/foundry';
import { parseImage } from '../../../lib/blocks/image';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const image = parseImage(block);
---

{image && (
    <figure class="wp-block-image size-large">
        <img
            src={image.src}
            srcset={image.srcset ?? undefined}
            sizes={image.srcset ? '(max-width: 780px) 100vw, 750px' : undefined}
            alt={image.alt}
            width={image.width ?? undefined}
            height={image.height ?? undefined}
            loading="lazy"
            decoding="async"
        />
        {(image.caption || image.credit) && (
            <figcaption class="wp-element-caption">
                {image.caption}
                {image.credit && <em> — {image.credit}</em>}
            </figcaption>
        )}
    </figure>
)}
