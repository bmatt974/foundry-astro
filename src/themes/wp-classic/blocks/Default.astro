---
/**
 * Fallback renderer for unmapped block types in wp-classic. Names the
 * missing type and keeps the raw payload one click away in a collapsed
 * <details> — a tickets payload dumped open buried the whole page under
 * its own JSON. Replace by registering a real component in
 * `components/Block.astro` once you build it.
 */
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
---

<section class="wp-block-default">
    <p class="wp-block-default__label">
        Unsupported block type: <code class="wp-inline-code">{block.block_type}</code>
        {block.cluster_block_key && <> (<code class="wp-inline-code">{block.cluster_block_key}</code>)</>}
    </p>
    <details class="wp-block-default__details">
        <summary class="wp-block-default__label">Show raw payload</summary>
        <pre class="wp-block-default__payload">{JSON.stringify(block.content, null, 2)}</pre>
    </details>
    {block.children.length > 0 && (
        <p class="wp-block-default__label">…and {block.children.length} nested children</p>
    )}
</section>
