---
/**
 * TopList — wp-classic theme. WP block-template class names so the
 * source reads like WordPress core's query-loop / post-template
 * blocks. Parsing lives in `lib/blocks/toplist.ts`.
 */
import type { PageBlock } from '../../../lib/foundry';
import { humaniseType, parseTopList } from '../../../lib/blocks/toplist';
import { imageSrcset, imageUrl } from '../../../lib/image';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { heading, items } = parseTopList(block);
---

{items.length > 0 && (
    <section class="wp-block-group wp-block-group--top-list">
        {heading && <h2 class="wp-block-heading">{heading}</h2>}
        <ul class="wp-block-post-template wp-block-post-template--top-list">
            {items.map((item) => (
                <li class="wp-block-post wp-block-post--place">
                    {item.image ? (
                        <figure class="wp-block-post-featured-image">
                            <img
                                src={imageUrl(item.image, { width: 480 })}
                                srcset={imageSrcset(item.image, [320, 480, 800, 1200])}
                                sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
                                alt={item.name}
                                loading="lazy"
                                width="480"
                                height="360"
                            />
                        </figure>
                    ) : (
                        <div class="wp-block-post-featured-image wp-block-post-featured-image--placeholder" aria-hidden="true">
                            <span>{item.type ?? 'place'}</span>
                        </div>
                    )}
                    <div class="wp-block-post__body">
                        {item.type && <p class="wp-block-post-terms">{humaniseType(item.type)}</p>}
                        <h3 class="wp-block-post-title">
                            {item.url ? (
                                <a href={item.url} class="wp-block-post-title__link">{item.name}</a>
                            ) : (
                                item.name
                            )}
                        </h3>
                        {item.description && (
                            <p class="wp-block-post-excerpt">{item.description}</p>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    </section>
)}
