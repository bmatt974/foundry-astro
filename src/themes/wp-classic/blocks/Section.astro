---
import type { PageBlock } from '../../../lib/foundry';
import { parseSection } from '../../../lib/blocks/section';
import Block from '../components/Block.astro';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, body, anchorId, bodyHeadingIds, hasChildren } = parseSection(block);
---
{(title || body || hasChildren) && (
    <section class="wp-block-group wp-block-group--section">
        {title && (
            <h2 id={anchorId} class="wp-block-heading">{title}</h2>
        )}
        {body && <Markdown text={body} headingIds={bodyHeadingIds} />}
        {hasChildren && (
            <div class="wp-block-group__inner">
                {block.children.map((child) => <Block block={child} />)}
            </div>
        )}
    </section>
)}
