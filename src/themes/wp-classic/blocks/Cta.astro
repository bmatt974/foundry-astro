---
/**
 * CTA — WordPress block-theme markup. Matches the exact structure
 * the WordPress core button block emits since WP 5.8:
 *
 *   <div class="wp-block-buttons is-content-justification-center">
 *     <div class="wp-block-button">
 *       <a class="wp-block-button__link wp-element-button" …>…</a>
 *     </div>
 *   </div>
 *
 * If a description is provided we ship it as a regular paragraph
 * block above the button — that's how the Gutenberg editor authors
 * "intro text + button" sequences in practice.
 */
import type { PageBlock } from '../../../lib/foundry';
import { isExternalUrl, parseCta } from '../../../lib/blocks/cta';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const cta = parseCta(block);
---

{cta && (
    <>
        {cta.description && (
            <p class="wp-block-paragraph has-text-align-center">{cta.description}</p>
        )}
        <div class="wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex is-content-justification-center">
            <div class="wp-block-button">
                <a
                    class="wp-block-button__link wp-element-button"
                    href={cta.url}
                    {...(isExternalUrl(cta.url) && { rel: 'noopener', target: '_blank' })}
                >
                    {cta.label}
                </a>
            </div>
        </div>
    </>
)}
