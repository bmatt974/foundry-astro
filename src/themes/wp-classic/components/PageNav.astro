---
import type { NavNode } from '../../../lib/foundry';

interface Props {
    locale: string;
    nav: {
        parent: NavNode | null;
        children: NavNode[];
        siblings: NavNode[];
    };
}

const { locale, nav } = Astro.props;
const hasContent = nav.parent !== null || nav.children.length > 0 || nav.siblings.length > 0;
---

{hasContent && (
    <nav class="wp-block-post-navigation" aria-label="Page navigation">
        {nav.parent && (
            <div class="wp-block-post-navigation__group">
                <p class="wp-block-post-navigation__heading">↑ Parent</p>
                <p>
                    <a href={`/${locale}/${nav.parent.slug ?? ''}`} class="wp-block-link">
                        {nav.parent.title}
                    </a>
                </p>
            </div>
        )}
        {nav.children.length > 0 && (
            <div class="wp-block-post-navigation__group">
                <p class="wp-block-post-navigation__heading">Sous-pages</p>
                <ul class="wp-block-post-navigation__list">
                    {nav.children.map((c) => (
                        <li><a href={`/${locale}/${c.slug ?? ''}`} class="wp-block-link">{c.title}</a></li>
                    ))}
                </ul>
            </div>
        )}
        {nav.siblings.length > 0 && (
            <div class="wp-block-post-navigation__group">
                <p class="wp-block-post-navigation__heading">À voir aussi</p>
                <ul class="wp-block-post-navigation__list">
                    {nav.siblings.map((s) => (
                        <li><a href={`/${locale}/${s.slug ?? ''}`} class="wp-block-link">{s.title}</a></li>
                    ))}
                </ul>
            </div>
        )}
    </nav>
)}
