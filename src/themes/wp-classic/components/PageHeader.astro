---
import type { PageTranslation } from '../../../lib/foundry';
import Markdown from './Markdown.astro';

interface Props {
    translation: PageTranslation | null;
    fallbackTitle?: string;
}

const { translation: t, fallbackTitle } = Astro.props;
const title = t?.title ?? fallbackTitle ?? 'Untitled';
---

<header class="entry-header">
    {t?.eyebrow && <p class="entry-eyebrow">{t.eyebrow}</p>}
    <h1 class="entry-title">{title}</h1>
    {t?.subtitle && <p class="entry-subtitle">{t.subtitle}</p>}
    {t?.intro && <div class="entry-intro"><Markdown text={t.intro} /></div>}
</header>
