---
import type { PageTranslation } from '../../../lib/foundry';
import { formatDate, formatRelativeDate } from '../../../lib/format';
import Markdown from './Markdown.astro';

interface Props {
    translation: PageTranslation | null;
    publishedAt?: string | null;
    fallbackTitle?: string;
}

const { translation: t, publishedAt = null, fallbackTitle } = Astro.props;
const title = t?.title ?? fallbackTitle ?? 'Untitled';
const locale = Astro.locals.locale ?? 'en';
const relative = formatRelativeDate(publishedAt, locale);
const absolute = formatDate(publishedAt, locale);
---

<header class="entry-header">
    {t?.eyebrow && <p class="entry-eyebrow">{t.eyebrow}</p>}
    <h1 class="entry-title">{title}</h1>
    {t?.subtitle && <p class="entry-subtitle">{t.subtitle}</p>}
    {relative && publishedAt && (
        <p class="entry-meta">
            <time class="entry-date entry-date--updated" datetime={publishedAt} title={absolute ?? undefined}>
                {relative}
            </time>
        </p>
    )}
    {t?.intro && <div class="entry-intro"><Markdown text={t.intro} /></div>}
</header>
