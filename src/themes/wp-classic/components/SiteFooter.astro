---
import type { MenuItem } from '../../../lib/foundry';
import { splitLinkBody, useTranslations } from '../../../lib/i18n';
import Menu from './Menu.astro';

interface Props {
    websiteName: string;
    currentLocale: string;
    items: MenuItem[];
}

const { websiteName, currentLocale, items } = Astro.props;
const year = new Date().getUTCFullYear();
const route = Astro.locals.route;

const t = useTranslations(currentLocale, Astro.locals.wording);
const disclosureHref = items
    .map((item) => item.href)
    .find((href): href is string =>
        typeof href === 'string' && /disclos|affilia/i.test(href));
const [disclosureLead, disclosureTrail] = splitLinkBody(
    t('footer.affiliateDisclosure.body'),
);
const disclosureLinkText = t('footer.affiliateDisclosure.linkText');
---

<footer class="wp-site-footer">
    <div class="wp-block-group">
        <p class="wp-site-credit">
            <a href={route('home', {})} class="wp-site-credit__name">{websiteName}</a>
            <span class="wp-site-credit__year">© {year}</span>
        </p>
        {items.length > 0 && (
            <nav class="wp-block-navigation wp-block-navigation--footer" aria-label="Site links">
                <Menu items={items} />
            </nav>
        )}
    </div>
    <p class="wp-block-paragraph wp-site-disclosure">{disclosureLead}{disclosureHref
        ? <a class="wp-block-link" href={disclosureHref}>{disclosureLinkText}</a>
        : disclosureLinkText}{disclosureTrail}</p>
</footer>
