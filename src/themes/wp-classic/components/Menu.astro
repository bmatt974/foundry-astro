---
import type { MenuItem } from '../../../lib/foundry';

interface Props {
    items: MenuItem[];
    class?: string;
    depth?: number;
}

const { items, class: className = '', depth = 0 } = Astro.props;
---

{items.length > 0 && (
    <ul class:list={[className, 'wp-block-navigation__container', depth > 0 && 'wp-block-navigation-submenu']}>
        {items.map((item) => {
            const hasChildren = item.children.length > 0;
            const isHeading = item.type === 'heading';
            const isSubmenuRoot = hasChildren && !isHeading && depth === 0;
            const itemClass = [
                'wp-block-navigation-item',
                `wp-block-navigation-item--${item.type}`,
                isSubmenuRoot && 'has-child',
                item.css_class,
            ].filter(Boolean).join(' ');

            if (item.type === 'divider') {
                return <li class={itemClass}><hr class="wp-block-separator" /></li>;
            }
            if (item.type === 'spacer') {
                return <li class={`${itemClass} wp-block-spacer`} aria-hidden="true">&nbsp;</li>;
            }
            if (isHeading) {
                return (
                    <li class={itemClass}>
                        <span class="wp-block-navigation-item__heading">{item.label}</span>
                        {hasChildren && (
                            <Astro.self items={item.children} depth={depth + 1} />
                        )}
                    </li>
                );
            }

            if (!item.label) {
                return null;
            }
            // Items with children render the whole label as a button —
            // single click target. The parent's href is dropped; the
            // dropdown itself is the destination.
            if (isSubmenuRoot) {
                return (
                    <li class={itemClass}>
                        <button
                            type="button"
                            class="wp-block-navigation-item__content wp-block-navigation__submenu-icon"
                            aria-expanded="false"
                            aria-haspopup="menu"
                        >
                            {item.label}
                            <svg class="wp-block-navigation__submenu-chevron" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                                <path d="M1.5 4.5l4.5 4.5 4.5-4.5z"/>
                            </svg>
                        </button>
                        <Astro.self items={item.children} depth={depth + 1} />
                    </li>
                );
            }
            const href = item.href ?? '#';
            return (
                <li class={itemClass}>
                    <a
                        href={href}
                        title={item.title_attribute ?? undefined}
                        target={item.open_in_new_tab ? '_blank' : undefined}
                        rel={item.open_in_new_tab ? 'noopener noreferrer' : undefined}
                        class="wp-block-navigation-item__content"
                    >
                        {item.label}
                    </a>
                    {hasChildren && (
                        <Astro.self items={item.children} depth={depth + 1} />
                    )}
                </li>
            );
        })}
    </ul>
)}
