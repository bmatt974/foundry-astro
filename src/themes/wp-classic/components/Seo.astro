---
/**
 * SEO head for wp-classic — wraps `SeoCore` with the meta + link tags
 * a real WordPress install leaks into <head>:
 *   <meta name="generator" content="WordPress …">
 *   <link rel="pingback" href="/xmlrpc.php">
 *   <link rel="https://api.w.org/" href="/wp-json/"> — REST API discovery
 *   <link rel="EditURI" type="application/rsd+xml" href="/xmlrpc.php?rsd">
 *
 * Reinforces the WordPress fingerprint at the <head> level so sister
 * sites on this theme look like the same engine as wp-twentyfour /
 * wp-astra / etc. — to the extent we mimic the same WP version string.
 */
import { wpGenerator, wpHeadProfile } from '../../../lib/fingerprint';
import type { AvailableLocale, Page } from '../../../lib/foundry';
import type { SeoExtras } from '../../../lib/seo';
import SeoCore from '../../../components/SeoCore.astro';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
    availableLocales?: AvailableLocale[];
    canonicalUrl?: string;
}

// Pick a WordPress version + identity-link profile per-site so
// the head tags aren't identical across the whole network. Both
// picks are deterministic from the hostname — stable per site,
// varied across sites. The profile mirrors real-world plugin
// coverage: some sites have pingback/wp-json/EditURI all present,
// others have one or more stripped by security plugins.
const hostname = Astro.locals.tenant.website.hostname;
const profile = wpHeadProfile(hostname);
const extraLinks: NonNullable<SeoExtras['extraLinks']> = [];
if (profile.pingback) {
    extraLinks.push({ rel: 'pingback', href: '/xmlrpc.php' });
}
if (profile.wpJson) {
    extraLinks.push({ rel: 'https://api.w.org/', href: '/wp-json/' });
}
if (profile.editURI) {
    extraLinks.push({ rel: 'EditURI', type: 'application/rsd+xml', title: 'RSD', href: '/xmlrpc.php?rsd' });
}

const wpExtras: SeoExtras = {
    extraMeta: [
        { name: 'generator', content: wpGenerator(hostname) },
    ],
    extraLinks,
};
---

<SeoCore {...Astro.props} extras={wpExtras} />
