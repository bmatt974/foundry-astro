---
/**
 * SEO head for wp-classic — wraps `SeoCore` with the meta + link tags
 * a real WordPress install leaks into <head>:
 *   <meta name="generator" content="WordPress …">
 *   <link rel="pingback" href="/xmlrpc.php">
 *   <link rel="https://api.w.org/" href="/wp-json/"> — REST API discovery
 *   <link rel="EditURI" type="application/rsd+xml" href="/xmlrpc.php?rsd">
 *
 * Reinforces the WordPress fingerprint at the <head> level so sister
 * sites on this theme look like the same engine as wp-twentyfour /
 * wp-astra / etc. — to the extent we mimic the same WP version string.
 */
import type { Page } from '../../../lib/foundry';
import type { SeoExtras } from '../../../lib/seo';
import SeoCore from '../../../components/SeoCore.astro';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
}

const wpExtras: SeoExtras = {
    extraMeta: [
        { name: 'generator', content: 'WordPress 6.4.2' },
    ],
    extraLinks: [
        { rel: 'pingback', href: '/xmlrpc.php' },
        { rel: 'https://api.w.org/', href: '/wp-json/' },
        { rel: 'EditURI', type: 'application/rsd+xml', title: 'RSD', href: '/xmlrpc.php?rsd' },
    ],
};
---

<SeoCore {...Astro.props} extras={wpExtras} />
