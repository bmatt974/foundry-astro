---
interface Props {
    websiteName: string;
    currentLocale: string;
}

const { websiteName } = Astro.props;
const route = Astro.locals.route;
---

<header class="wp-site-header">
    <div class="wp-block-group">
        <a href={route('home', {})} class="wp-site-blog-title">{websiteName}</a>
        <slot />
    </div>
</header>
