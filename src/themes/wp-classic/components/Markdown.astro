---
/**
 * Markdown rendering for wp-classic — uses a custom marked Renderer
 * (extracted to `lib/markdown-renderer.ts` so it can be unit-tested
 * without running Astro) that decorates every output element with
 * WordPress block-editor class names.
 */
import { wpMarked } from '../lib/markdown-renderer';

interface Props {
    text: string | null | undefined;
    /** Compat with the basic theme — ignored here, kept so the contract matches. */
    size?: 'sm' | 'base' | 'lg';
    class?: string;
}

const { text, class: className = '' } = Astro.props;
const html = text ? (wpMarked.parse(text, { async: false }) as string) : '';
---

{html && <div class:list={['wp-block-post-content', className]} set:html={html} />}
