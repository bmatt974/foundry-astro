---
import type { Sourceable } from '../../../lib/foundry';
import { buildRows } from '../../../lib/themes/sourceable-rows';

interface Props {
    sourceable: Sourceable | null;
    locale: string;
}

const { sourceable, locale } = Astro.props;
const rows = sourceable ? buildRows(sourceable, locale) : [];
---

{rows.length > 0 && (
    <aside class="wp-block-table-of-facts">
        <table class="wp-block-table">
            <tbody>
                {rows.map((row) => (
                    <tr>
                        <th scope="row">{row.label}</th>
                        <td>
                            {row.href ? (
                                <a href={row.href} class="wp-block-link" target="_blank" rel="noopener noreferrer">
                                    {row.value}
                                </a>
                            ) : (
                                row.value
                            )}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </aside>
)}
