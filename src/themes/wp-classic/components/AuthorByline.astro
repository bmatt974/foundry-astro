---
/**
 * Inline byline using WordPress block-editor class names so the
 * markup reads like a server-rendered WP core "post author" block.
 *
 * Pass `inline=true` to render as a `<span>` so the byline can sit
 * inside another paragraph (next to the entry's date in the page
 * header) ; the default `<p>` wrapper still ships for callers that
 * want it as its own standalone block.
 *
 * Visibility + link behaviour come from `tenant.website.byline` —
 * the editor flips them per-site in the Filament Author display
 * section. `show=false` short-circuits to no output ; `link_author
 * =false` renders the name as plain text ; `nofollow` is the
 * EFFECTIVE boolean (Auto/Always/Never already collapsed by the CMS).
 */
import { type ResolvedAuthor } from '../../../lib/author';
import { useTranslations } from '../../../lib/i18n';

interface Props {
    authors: ResolvedAuthor[];
    locale: string;
    inline?: boolean;
}

const { authors, locale, inline = false } = Astro.props;
const t = useTranslations(locale, Astro.locals.wording);
const route = Astro.locals.route;
const prefix = t('byline.prefix');
const separator = t('byline.separator');
const conjunction = t('byline.conjunction');

const byline = Astro.locals.tenant?.website?.byline ?? {
    show: true,
    link_author: true,
    nofollow: true,
};
const linkRel = byline.nofollow ? 'nofollow' : undefined;
const visible = byline.show && authors.length > 0;
---

{visible && (inline ? (
    <span class="wp-block-post-author wp-block-post-author--byline">
        <span class="wp-block-post-author__prefix">{prefix}{' '}</span>
        {authors.map((author, idx) => (
            <>
                {idx > 0 && (idx === authors.length - 1 ? <span>{' '}{conjunction}{' '}</span> : <span>{separator}</span>)}
                {byline.link_author ? (
                    <a href={route('author', { slug: author.slug })} class="wp-block-link wp-block-post-author__name" rel={linkRel}>{author.name}</a>
                ) : (
                    <span class="wp-block-post-author__name">{author.name}</span>
                )}
            </>
        ))}
    </span>
) : (
    <p class="wp-block-post-author wp-block-post-author--byline">
        <span class="wp-block-post-author__prefix">{prefix}{' '}</span>
        {authors.map((author, idx) => (
            <>
                {idx > 0 && (idx === authors.length - 1 ? <span>{' '}{conjunction}{' '}</span> : <span>{separator}</span>)}
                {byline.link_author ? (
                    <a href={route('author', { slug: author.slug })} class="wp-block-link wp-block-post-author__name" rel={linkRel}>{author.name}</a>
                ) : (
                    <span class="wp-block-post-author__name">{author.name}</span>
                )}
            </>
        ))}
    </p>
))}
