---
import type { PageBlock } from '../../../lib/foundry';
import { extractHeadingsFromBlocks } from '../../../lib/toc';
import Block from './Block.astro';

interface Props {
    blocks: PageBlock[];
}

const { blocks } = Astro.props;

// The page walk that assigns every heading id — page-wide unique,
// remembered per block (`headingIdsFor`). Run HERE, not only in the
// TOC: the TOC is absent on some layouts, the ids never are.
extractHeadingsFromBlocks(blocks);
---

{blocks.length > 0 ? (
    <div class="field field--name-body field--type-text-with-summary field--label-hidden">
        <div class="field__items">
            {blocks.map((block) => <Block block={block} />)}
        </div>
    </div>
) : (
    <p class="field field--name-body field--empty">No blocks on this page.</p>
)}
