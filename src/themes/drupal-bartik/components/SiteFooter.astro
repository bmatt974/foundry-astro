---
import type { MenuItem } from '../../../lib/foundry';
import { splitLinkBody, useTranslations } from '../../../lib/i18n';
import Menu from './Menu.astro';

interface Props {
    websiteName: string;
    currentLocale: string;
    items: MenuItem[];
}

const { websiteName, currentLocale, items } = Astro.props;
const year = new Date().getUTCFullYear();
const route = Astro.locals.route;

const t = useTranslations(currentLocale, Astro.locals.wording);
const disclosureHref = items
    .map((item) => item.href)
    .find((href): href is string =>
        typeof href === 'string' && /disclos|affilia/i.test(href));
const [disclosureLead, disclosureTrail] = splitLinkBody(
    t('footer.affiliateDisclosure.body'),
);
const disclosureLinkText = t('footer.affiliateDisclosure.linkText');
---

<footer class="layout-footer" role="contentinfo">
    <div class="region region--footer">
        <div class="block block--system-powered-by">
            <a href={route('home', {})} class="site-credit__link">{websiteName}</a>
            <span class="site-credit__year">© {year}</span>
        </div>
        {items.length > 0 && (
            <nav class="block block--system-menu-footer" aria-label="Site links">
                <Menu items={items} class="menu--footer" />
            </nav>
        )}
    </div>
    <p class="block block--type-disclosure region--footer-disclosure">{disclosureLead}{disclosureHref
        ? <a href={disclosureHref}>{disclosureLinkText}</a>
        : disclosureLinkText}{disclosureTrail}</p>
</footer>
