---
/**
 * Block dispatcher for drupal-bartik. Routes each `PageBlock` to its
 * dedicated per-type renderer; unknown types fall through to Default
 * which dumps the raw payload for editorial review.
 */
import type { PageBlock } from '../../../lib/foundry';
import Comparison from '../blocks/Comparison.astro';
import Cta from '../blocks/Cta.astro';
import Default from '../blocks/Default.astro';
import Faq from '../blocks/Faq.astro';
import KeyFacts from '../blocks/KeyFacts.astro';
import Section from '../blocks/Section.astro';
import Text from '../blocks/Text.astro';
import TopList from '../blocks/TopList.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;

const blockComponents: Partial<Record<string, any>> = {
    text: Text,
    summary: Text,
    key_facts: KeyFacts,
    faq: Faq,
    cta: Cta,
    section: Section,
    top_list: TopList,
    comparison: Comparison,
};

const Component = blockComponents[block.block_type] ?? Default;
---

<Component block={block} />
