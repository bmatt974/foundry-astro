---
import type { NavNode } from '../../../lib/foundry';

interface Props {
    locale: string;
    breadcrumb: NavNode[];
    currentTitle?: string;
    websiteName?: string;
}

const { breadcrumb, currentTitle, websiteName } = Astro.props;
const route = Astro.locals.route;
---

{breadcrumb.length > 0 && (
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
            {websiteName && (
                <li class="breadcrumb__item">
                    <a href={route('home', {})}>{websiteName}</a>
                </li>
            )}
            {breadcrumb.map((node) => (
                <li class="breadcrumb__item">
                    {node.slug
                        ? <a href={route('page', { slug: node.slug })}>{node.title}</a>
                        : <span>{node.title}</span>}
                </li>
            ))}
            {currentTitle && (
                <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
                    <span>{currentTitle}</span>
                </li>
            )}
        </ol>
    </nav>
)}
