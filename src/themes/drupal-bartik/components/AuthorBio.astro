---
/**
 * Author bio card with Drupal conventions
 * (block--type-author-bio + field-collection-item structure).
 */
import { type ResolvedAuthor } from '../../../lib/author';
import { useTranslations } from '../../../lib/i18n';

interface Props {
    authors: ResolvedAuthor[];
    locale: string;
}

const { authors, locale } = Astro.props;
const t = useTranslations(locale, Astro.locals.wording);
const route = Astro.locals.route;
const aboutLabel = t('author.aboutLabel');
const seeProfile = t('author.seeProfile');

const bioSettings = Astro.locals.tenant?.website?.author_bio ?? {
    show: true,
    page_types: null,
    link_to_profile: true,
    nofollow: true,
};
const ctaRel = bioSettings.nofollow ? 'author nofollow' : 'author';
---

{authors.length > 0 && (
    <aside class="block block--type-author-bio region region--author-bio">
        <h2 class="block__title">{aboutLabel}</h2>
        <div class="field-collection-list">
            {authors.map((author) => (
                <div class="field-collection-item">
                    {author.photoUrl && (
                        <div class="field field--name-field-avatar">
                            <img
                                src={author.photoUrl}
                                alt={author.name}
                                width="80"
                                height="80"
                                loading="lazy"
                            />
                        </div>
                    )}
                    <div class="field-collection-item__content">
                        {/* Name stays plain text — the single profile
                            link lives in the CTA below (when enabled). */}
                        <p class="username">{author.name}</p>
                        {author.title && (
                            <p class="field field--name-field-title">{author.title}</p>
                        )}
                        {(author.bioShort ?? author.title) && (
                            <p class="field field--name-field-bio-short">{author.bioShort ?? author.title}</p>
                        )}
                        {bioSettings.link_to_profile && (
                            <a
                                href={route('author', { slug: author.slug })}
                                class="more-link"
                                rel={ctaRel}
                            >
                                {seeProfile} →
                            </a>
                        )}
                    </div>
                </div>
            ))}
        </div>
    </aside>
)}
