---
import type { NavNode } from '../../../lib/foundry';

interface Props {
    locale: string;
    nav: {
        parent: NavNode | null;
        children: NavNode[];
        siblings: NavNode[];
    };
}

const { nav } = Astro.props;
const route = Astro.locals.route;
const hasContent = nav.parent !== null || nav.children.length > 0 || nav.siblings.length > 0;
const hrefFor = (slug: string | null | undefined) =>
    slug ? route('page', { slug }) : route('home', {});
---

{hasContent && (
    <nav class="block block--system-page-navigation" aria-label="Page navigation">
        {nav.parent && (
            <div class="block--system-page-navigation__group">
                <p class="block--system-page-navigation__heading">↑ Parent</p>
                <p>
                    <a href={hrefFor(nav.parent.slug)}>{nav.parent.title}</a>
                </p>
            </div>
        )}
        {nav.children.length > 0 && (
            <div class="block--system-page-navigation__group">
                <p class="block--system-page-navigation__heading">Sous-pages</p>
                <ul class="block--system-page-navigation__list">
                    {nav.children.map((c) => (
                        <li><a href={hrefFor(c.slug)}>{c.title}</a></li>
                    ))}
                </ul>
            </div>
        )}
        {nav.siblings.length > 0 && (
            <div class="block--system-page-navigation__group">
                <p class="block--system-page-navigation__heading">À voir aussi</p>
                <ul class="block--system-page-navigation__list">
                    {nav.siblings.map((s) => (
                        <li><a href={hrefFor(s.slug)}>{s.title}</a></li>
                    ))}
                </ul>
            </div>
        )}
    </nav>
)}
