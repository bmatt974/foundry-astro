---
/**
 * Auto-generated table of contents. Drupal-styled — wraps in a
 * `region--toc` and uses `field__*` class names so the markup
 * reads like a Drupal block render.
 */
import type { PageBlock } from '../../../lib/foundry';
import { extractHeadingsFromBlocks } from '../../../lib/toc';

interface Props {
    blocks: PageBlock[];
}

const { blocks } = Astro.props;
const headings = extractHeadingsFromBlocks(blocks);
const MIN_HEADINGS = 3;
const locale = Astro.locals.locale ?? 'en';
const tocLabel = locale.startsWith('fr') ? 'Sommaire' : 'Table of contents';
---

{headings.length >= MIN_HEADINGS && (
    <nav class="region region--toc block block--type-toc" aria-label={tocLabel}>
        <h2 class="block__title">{tocLabel}</h2>
        <div class="field field--name-field-toc-items">
            <ol class="menu menu--toc">
                {headings.map((h) => (
                    <li class={h.level === 3 ? 'menu-item menu-item--sub' : 'menu-item'}>
                        <a class="menu-item__link" href={`#${h.slug}`}>{h.text}</a>
                    </li>
                ))}
            </ol>
        </div>
    </nav>
)}
