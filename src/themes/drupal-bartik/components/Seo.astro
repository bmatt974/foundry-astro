---
/**
 * SEO head for drupal-bartik. All Drupal-specific head variance
 * lives in `src/themes/drupal-bartik/anti-footprint.ts` (capital-G
 * Generator string, legacy mobile metas, theme-color, favicon
 * path mode — fresh-install droplet vs custom upload).
 */
import { getAntiFootprint } from '../../../lib/anti-footprint/registry';
import type { AvailableLocale, Page } from '../../../lib/foundry';
import SeoCore from '../../../components/SeoCore.astro';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
    availableLocales?: AvailableLocale[];
    canonicalUrl?: string;
}

const extras = getAntiFootprint('drupal-bartik').seoExtras(
    Astro.locals.tenant.website.slug,
    Astro.locals.tenant.website.fingerprint_preset,
);
---

<SeoCore {...Astro.props} extras={extras} />
