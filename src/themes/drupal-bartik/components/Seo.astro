---
/**
 * SEO head for drupal-bartik. Currently mirrors the basic theme's
 * tag set but lives separately so it can grow Drupal-flavoured
 * signatures later (e.g. shortlink, Drupal generator meta) for
 * stronger fingerprint mimicry.
 */
import type { Page } from '../../../lib/foundry';
import { imageUrl } from '../../../lib/image';
import {
    alternateUrls,
    buildJsonLd,
    pageUrl,
    serializeJsonLd,
    siteUrl,
    type TenantContext,
} from '../../../lib/seo';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
}

const { page, locale, type, title, description, noindex = false } = Astro.props;
const tenant = Astro.locals.tenant as TenantContext;

const t = page?.translation ?? null;
const resolvedTitle = title ?? t?.meta_title ?? t?.title ?? tenant.website.name;
const resolvedDescription = description
    ?? t?.meta_description
    ?? t?.snippet
    ?? null;
const resolvedType = type ?? (page ? 'article' : 'website');

const canonicalSlug = t?.slug ?? null;
const canonicalUrl = page ? pageUrl(tenant, locale, canonicalSlug) : siteUrl(tenant, locale);
const alternates = page ? alternateUrls(tenant, page.available_locales) : [];

const rawImage = page?.cover_image
    ?? (page?.sourceable && 'cover_image' in page.sourceable
        ? page.sourceable.cover_image
        : null);
const socialImage = rawImage ? imageUrl(rawImage, { width: 1200 }) : null;

const robotsContent = (noindex || (page && page.is_indexable === false))
    ? 'noindex, follow'
    : null;

const ogLocale = locale.replace('-', '_');
const websiteLocale = tenant.locales.find((l) => l.locale === locale);

const jsonLd = serializeJsonLd(
    buildJsonLd({
        tenant,
        locale,
        page,
        canonicalUrl,
        imageUrl: socialImage,
    }),
);
---

{resolvedDescription && <meta name="description" content={resolvedDescription} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content={resolvedType} />
<meta property="og:title" content={resolvedTitle} />
{resolvedDescription && <meta property="og:description" content={resolvedDescription} />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:site_name" content={websiteLocale?.site_name ?? tenant.website.name} />
<meta property="og:locale" content={ogLocale} />
{tenant.locales
    .filter((l) => l.enabled && l.locale !== locale)
    .map((l) => <meta property="og:locale:alternate" content={l.locale.replace('-', '_')} />)}
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:width" content="1200" />}
{socialImage && <meta property="og:image:height" content="675" />}

<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={resolvedTitle} />
{resolvedDescription && <meta name="twitter:description" content={resolvedDescription} />}
{socialImage && <meta name="twitter:image" content={socialImage} />}

<script type="application/ld+json" is:inline set:html={jsonLd} />
