---
/**
 * SEO head for drupal-bartik — wraps `SeoCore` with the meta tags a
 * real Drupal install leaks into <head>:
 *   <meta name="Generator" content="Drupal 10 (https://www.drupal.org)">
 *   <meta name="MobileOptimized" content="width">
 *   <meta name="HandheldFriendly" content="true">
 *
 * Capitalised "Generator" (vs WordPress's lowercase "generator") is
 * the canonical Drupal tell — it's a single-byte difference that bots
 * notice and humans miss.
 */
import type { Page } from '../../../lib/foundry';
import type { SeoExtras } from '../../../lib/seo';
import SeoCore from '../../../components/SeoCore.astro';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
}

const drupalExtras: SeoExtras = {
    extraMeta: [
        { name: 'Generator', content: 'Drupal 10 (https://www.drupal.org)' },
        { name: 'MobileOptimized', content: 'width' },
        { name: 'HandheldFriendly', content: 'true' },
    ],
};
---

<SeoCore {...Astro.props} extras={drupalExtras} />
