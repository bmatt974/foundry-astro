---
/**
 * SEO head for drupal-bartik — wraps `SeoCore` with the meta tags a
 * real Drupal install leaks into <head>:
 *   <meta name="Generator" content="Drupal 10 (https://www.drupal.org)">
 *   <meta name="MobileOptimized" content="width">
 *   <meta name="HandheldFriendly" content="true">
 *
 * Capitalised "Generator" (vs WordPress's lowercase "generator") is
 * the canonical Drupal tell — it's a single-byte difference that bots
 * notice and humans miss.
 */
import { drupalGenerator, drupalHeadProfile } from '../../../lib/fingerprint';
import type { AvailableLocale, Page } from '../../../lib/foundry';
import type { SeoExtras } from '../../../lib/seo';
import SeoCore from '../../../components/SeoCore.astro';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
    availableLocales?: AvailableLocale[];
    canonicalUrl?: string;
}

// Pick a Drupal version + legacy-meta profile per-site. Drupal 10
// themes dropped MobileOptimized/HandheldFriendly so sites built
// on D10 don't emit them; older D7/D8 themes still do. Mixing
// both reflects the real-world Drupal version distribution.
const hostname = Astro.locals.tenant.website.hostname;
const profile = drupalHeadProfile(hostname);
const extraMeta: NonNullable<SeoExtras['extraMeta']> = [
    { name: 'Generator', content: drupalGenerator(hostname) },
];
if (profile.mobileOptimized) {
    extraMeta.push({ name: 'MobileOptimized', content: 'width' });
}
if (profile.handheldFriendly) {
    extraMeta.push({ name: 'HandheldFriendly', content: 'true' });
}

const drupalExtras: SeoExtras = { extraMeta };
---

<SeoCore {...Astro.props} extras={drupalExtras} />
