---
/**
 * Inline byline with Drupal conventions
 * (field--name-uid / submitted-by markup like Bartik renders).
 *
 * Pass `inline=true` to render as a `<span>` so the byline can sit
 * inside another paragraph (next to the date in the page header) ;
 * the default `<p>` ships for standalone use.
 *
 * Visibility + link behaviour come from `tenant.website.byline` —
 * editor flips them per-site in the Filament Author display section.
 */
import { type ResolvedAuthor } from '../../../lib/author';
import { useTranslations } from '../../../lib/i18n';

interface Props {
    authors: ResolvedAuthor[];
    locale: string;
    inline?: boolean;
}

const { authors, locale, inline = false } = Astro.props;
const t = useTranslations(locale, Astro.locals.wording);
const route = Astro.locals.route;
const prefix = t('byline.prefix');
const separator = t('byline.separator');
const conjunction = t('byline.conjunction');

const byline = Astro.locals.tenant?.website?.byline ?? {
    show: true,
    link_author: true,
    nofollow: true,
};
// Bartik already shipped `rel="author"` for the username — keep it
// and pair with `nofollow` when needed.
const linkRel = byline.nofollow ? 'author nofollow' : 'author';
const visible = byline.show && authors.length > 0;
---

{visible && (inline ? (
    <span class="field field--name-uid field--label-hidden submitted">
        <span>{prefix}{' '}</span>
        {authors.map((author, idx) => (
            <>
                {idx > 0 && (idx === authors.length - 1 ? <span>{' '}{conjunction}{' '}</span> : <span>{separator}</span>)}
                {byline.link_author ? (
                    <a href={route('author', { slug: author.slug })} class="username" rel={linkRel}>{author.name}</a>
                ) : (
                    <span class="username">{author.name}</span>
                )}
            </>
        ))}
    </span>
) : (
    <p class="field field--name-uid field--label-hidden submitted">
        <span>{prefix}{' '}</span>
        {authors.map((author, idx) => (
            <>
                {idx > 0 && (idx === authors.length - 1 ? <span>{' '}{conjunction}{' '}</span> : <span>{separator}</span>)}
                {byline.link_author ? (
                    <a href={route('author', { slug: author.slug })} class="username" rel={linkRel}>{author.name}</a>
                ) : (
                    <span class="username">{author.name}</span>
                )}
            </>
        ))}
    </p>
))}
