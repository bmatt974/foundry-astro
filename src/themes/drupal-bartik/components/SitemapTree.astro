---
import type { SitemapNode } from '../../../lib/foundry';

interface Props {
    locale: string;
    nodes: SitemapNode[];
    parentId?: number | null;
    depth?: number;
}

const { locale, nodes, parentId = null, depth = 0 } = Astro.props;
const route = Astro.locals.route;

const children = nodes
    .filter((n) => n.parent_id === parentId)
    .sort((a, b) => a.position - b.position);
const hasChildren = (id: number) => nodes.some((n) => n.parent_id === id);
---

{children.length > 0 && (
    <ul class:list={['menu', 'menu--sitemap']}>
        {children.map((node) => (
            <li class="menu-item">
                <div class="menu--sitemap__entry">
                    <a href={node.slug ? route('page', { slug: node.slug }) : route('home', {})} class="menu--sitemap__link">
                        {node.title}
                    </a>
                    <span class="menu--sitemap__type">{node.page_type}</span>
                </div>
                {hasChildren(node.id) && (
                    <Astro.self locale={locale} nodes={nodes} parentId={node.id} depth={depth + 1} />
                )}
            </li>
        ))}
    </ul>
)}
