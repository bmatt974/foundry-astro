---
import type { PageBlock } from '../../../lib/foundry';
import { parseKeyFacts } from '../../../lib/blocks/key-facts';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, facts, freeForm, anchorId } = parseKeyFacts(block);
const hasContent = facts.length > 0 || freeForm.length > 0;
---

{hasContent && (
    <aside class="block block--type-key-facts">
        {title && (
            <h2 id={anchorId} class="block__title">{title}</h2>
        )}
        <ul class="field-collection-list">
            {facts.map((f) => (
                <li class="field-collection-item">
                    <p class="field__label">{f.label}</p>
                    <div class="field__items">{f.value}</div>
                </li>
            ))}
            {freeForm.map((line) => (
                <li class="field-collection-item">
                    <div class="field__items">{line}</div>
                </li>
            ))}
        </ul>
    </aside>
)}
