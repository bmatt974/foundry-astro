---
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as {
    title?: string;
    facts?: Array<{ label: string; value: string } | string>;
};
const facts = content.facts ?? [];
---

<aside class="block block--type-key-facts">
    {content.title && <h2 class="block__title">{content.title}</h2>}
    {facts.length > 0 && (
        <ul class="field-collection-list">
            {facts.map((f) =>
                typeof f === 'string' ? (
                    <li class="field-collection-item">
                        <div class="field__items">{f}</div>
                    </li>
                ) : (
                    <li class="field-collection-item">
                        <p class="field__label">{f.label}</p>
                        <div class="field__items">{f.value}</div>
                    </li>
                ),
            )}
        </ul>
    )}
</aside>
