---
import type { PageBlock } from '../../../lib/foundry';
import { parseText } from '../../../lib/blocks/text';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, body, anchorId } = parseText(block);
---

<div class="block block--type-basic block--field-text">
    {title && (
        <h2 id={anchorId} class="block__title">{title}</h2>
    )}
    <Markdown text={body} />
</div>
