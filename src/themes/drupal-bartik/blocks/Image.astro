---
import type { PageBlock } from '../../../lib/foundry';
import { parseImage } from '../../../lib/blocks/image';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const image = parseImage(block);
---

{image && (
    <div class="block block--type-image field field--type-image">
        <div class="field__item">
            <img
                src={image.src}
                srcset={image.srcset ?? undefined}
                sizes={image.srcset ? '(max-width: 768px) 100vw, 740px' : undefined}
                alt={image.alt}
                width={image.width ?? undefined}
                height={image.height ?? undefined}
                loading="lazy"
                decoding="async"
                typeof="foaf:Image"
            />
        </div>
        {(image.caption || image.credit) && (
            <div class="field__caption">
                {image.caption}
                {image.credit && <span class="field__credit"> ({image.credit})</span>}
            </div>
        )}
    </div>
)}
