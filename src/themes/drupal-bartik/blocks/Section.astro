---
import type { PageBlock } from '../../../lib/foundry';
import { parseSection } from '../../../lib/blocks/section';
import Block from '../components/Block.astro';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, body, anchorId, hasChildren } = parseSection(block);
---

<section class="block block--type-section">
    {title && (
        <h2 id={anchorId} class="block__title">{title}</h2>
    )}
    {body && <Markdown text={body} />}
    {hasChildren && (
        <div class="block--type-section__children">
            {block.children.map((child) => <Block block={child} />)}
        </div>
    )}
</section>
