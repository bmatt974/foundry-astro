---
import type { PageBlock } from '../../../lib/foundry';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const content = (block.content ?? {}) as {
    label?: string;
    url?: string;
    description?: string;
};
---

<div class="block block--type-cta">
    {content.description && (
        <p class="block__description">{content.description}</p>
    )}
    {content.url && content.label && (
        <div class="form-actions">
            <a href={content.url} class="button button--primary">{content.label}</a>
        </div>
    )}
</div>
