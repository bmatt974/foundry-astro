---
import type { PageBlock } from '../../../lib/foundry';
import { parseFaq } from '../../../lib/blocks/faq';
import Markdown from '../components/Markdown.astro';

interface Props {
    block: PageBlock;
}

const { block } = Astro.props;
const { title, items, anchorId } = parseFaq(block);
---

{items.length > 0 && (
    <div class="block block--type-faq">
        {title && (
            <h2 id={anchorId} class="block__title">{title}</h2>
        )}
        <div class="field field--name-field-faq-items">
            {items.map((qa) => (
                <details class="paragraph paragraph--type-faq-item">
                    <summary>{qa.question}</summary>
                    <div class="paragraph__answer">
                        <Markdown text={qa.answer} />
                    </div>
                </details>
            ))}
        </div>
    </div>
)}
