---
/**
 * Shared SEO head — Open Graph + Twitter Card + canonical + hreflang +
 * robots + JSON-LD. Theme-agnostic, but accepts an `extras` prop so
 * each theme can layer engine-specific signatures (WordPress generator
 * + pingback, Drupal capital-G Generator, etc.) without duplicating
 * the common emission.
 *
 * Themes don't import this directly — they expose a thin wrapper as
 * `theme.Seo` (see e.g. `src/themes/wp-classic/components/Seo.astro`)
 * that hard-codes the family-specific extras. Pages keep calling
 * `theme.Seo` and stay theme-agnostic.
 */
import type { AvailableLocale, Page } from '../lib/foundry';
import { imageUrl } from '../lib/image';
import {
    alternateUrls,
    buildJsonLd,
    pageUrl,
    serializeJsonLd,
    siteUrl,
    type SeoExtras,
    type TenantContext,
} from '../lib/seo';
import { computePageTier, tierConfig } from '../lib/seo-tier';

interface Props {
    page: Page | null;
    locale: string;
    type?: 'article' | 'website';
    title?: string;
    description?: string;
    noindex?: boolean;
    extras?: SeoExtras;
    /** Override the hreflang alternates list — useful for synthetic
     *  routes (author profile, future tag/category pages) that
     *  aren't backed by a `Page` row but still need to declare per-
     *  locale alternates. Each entry: { locale, slug } where `slug`
     *  is the path-after-locale (e.g. `auteurs/sophie`). When
     *  provided, takes precedence over `page.available_locales`. */
    availableLocales?: AvailableLocale[];
    /** Override the canonical URL — same rationale as
     *  `availableLocales`. When omitted, defaults to the page's own
     *  canonical (or the locale root when page is null). */
    canonicalUrl?: string;
}

const { page, locale, type, title, description, noindex = false, extras, availableLocales, canonicalUrl: canonicalOverride } = Astro.props;
const tenant = Astro.locals.tenant as TenantContext;

const t = page?.translation ?? null;
const resolvedTitle = title ?? t?.meta_title ?? t?.title ?? tenant.website.name;
const resolvedDescription = description
    ?? t?.meta_description
    ?? t?.snippet
    ?? null;
const resolvedType = type ?? (page ? 'article' : 'website');

const canonicalSlug = t?.slug ?? null;
const canonicalUrl = canonicalOverride
    ?? (page ? pageUrl(tenant, locale, canonicalSlug) : siteUrl(tenant, locale));

// hreflang: prefer an explicit override (used by synthetic routes
// like the author profile), fall back to `page.available_locales`,
// otherwise emit nothing. Locale landing pages have no alternates
// metadata, so they skip this naturally.
const alternates = availableLocales !== undefined
    ? alternateUrls(tenant, availableLocales)
    : (page ? alternateUrls(tenant, page.available_locales) : []);

// Image used for og:image / twitter:image. Same fallback chain as the
// Hero so the social preview matches what shoppers see in the SERP.
const rawImage = page?.cover_image
    ?? (page?.sourceable && 'cover_image' in page.sourceable
        ? page.sourceable.cover_image
        : null);
const socialImage = rawImage ? imageUrl(rawImage, { width: 1200 }) : null;

const robotsContent = (noindex || (page && page.is_indexable === false))
    ? 'noindex, follow'
    : null;

const ogLocale = locale.replace('-', '_');
const websiteLocale = tenant.locales.find((l) => l.locale === locale);

// Per-page SEO tier (anti-footprint): not every page ships the
// full schema + og:image + twitter suite. Seeded from hostname +
// slug so it's stable across rebuilds and varies across pages /
// sites. See `lib/seo-tier.ts`.
const tier = computePageTier(page, tenant);
const cfg = tierConfig(tier);

const jsonLd = cfg.emitSchema
    ? serializeJsonLd(
        buildJsonLd({
            tenant,
            locale,
            page,
            canonicalUrl,
            imageUrl: socialImage,
        }),
    )
    : null;
---

{resolvedDescription && <meta name="description" content={resolvedDescription} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content={resolvedType} />
<meta property="og:title" content={resolvedTitle} />
{resolvedDescription && <meta property="og:description" content={resolvedDescription} />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:site_name" content={websiteLocale?.site_name ?? tenant.website.name} />
<meta property="og:locale" content={ogLocale} />
{tenant.locales
    .filter((l) => l.enabled && l.locale !== locale)
    .map((l) => <meta property="og:locale:alternate" content={l.locale.replace('-', '_')} />)}
{cfg.emitOgImage && socialImage && <meta property="og:image" content={socialImage} />}
{cfg.emitOgImage && socialImage && <meta property="og:image:width" content="1200" />}
{cfg.emitOgImage && socialImage && <meta property="og:image:height" content="675" />}

{cfg.emitTwitter && <meta name="twitter:card" content={cfg.emitTwitterImage && socialImage ? 'summary_large_image' : 'summary'} />}
{cfg.emitTwitter && <meta name="twitter:title" content={resolvedTitle} />}
{cfg.emitTwitter && resolvedDescription && <meta name="twitter:description" content={resolvedDescription} />}
{cfg.emitTwitter && cfg.emitTwitterImage && socialImage && <meta name="twitter:image" content={socialImage} />}

{extras?.extraMeta?.map((m) => (
    <meta name={m.name} property={m.property} content={m.content} />
))}
{extras?.extraLinks?.map((l) => (
    <link rel={l.rel} href={l.href} type={l.type} title={l.title} />
))}

{cfg.emitSchema && jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
