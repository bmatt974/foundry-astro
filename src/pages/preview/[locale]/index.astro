---
/**
 * Dev preview route for the locale landing — SSR mirror of
 * `/[locale]/` so the middleware's `?theme=<name>` override works
 * here too. Same usage as the content preview route.
 */
export const prerender = false;

import { fetchSitemap } from '../../../lib/foundry';
import { getTheme } from '../../../themes/registry';

const { locale } = Astro.params;
if (!locale) {
    return new Response('Missing locale segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const sitemap = await fetchSitemap(locale, tenant.website.hostname);

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, LocaleLanding, Seo } = theme;
---

<Layout title={`${tenant.website.name} — ${locale}`} locale={locale}>
    <Seo slot="head" page={null} locale={locale} type="website" noindex />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
    />
    <LocaleLanding
        websiteName={tenant.website.name}
        locale={locale}
        isDefaultLocale={tenant.defaultLocale === locale}
        sitemap={sitemap}
    />
</Layout>
