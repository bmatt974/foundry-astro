---
/**
 * Dev preview route — mirrors `/[locale]/[...path]` but runs SSR
 * (`prerender = false`), so the middleware's `?theme=<name>` override
 * + cookie persistence works. Compare templates side by side by
 * opening multiple tabs with different `?theme=` values:
 *
 *   /preview/fr/le-colisee?theme=wp-classic
 *   /preview/fr/le-colisee?theme=drupal-bartik
 *   /preview/fr/le-colisee?theme=basic
 *
 * `noindex` is forced in <Seo> so the route can't accidentally be
 * picked up by crawlers if exposed to production.
 */
export const prerender = false;

import { fetchPage } from '../../../lib/foundry';
import { getTheme } from '../../../themes/registry';

const { locale, path } = Astro.params;
if (!locale) {
    return new Response('Missing locale segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const page = await fetchPage(locale, path ?? '', tenant.website.hostname);
if (!page) {
    return new Response('Not found', { status: 404 });
}

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, Seo, Article } = theme;

const t = page.translation;
const title = t?.meta_title ?? t?.title ?? 'Untitled';
const description = t?.meta_description ?? t?.snippet ?? null;
---

<Layout title={title} description={description} locale={locale}>
    <Seo slot="head" page={page} locale={locale} type="article" noindex />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
        pageLocales={page.available_locales}
    />

    <Article page={page} locale={locale} />
</Layout>
