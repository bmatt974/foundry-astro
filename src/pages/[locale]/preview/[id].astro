---
/**
 * Preview-by-ID route. Mirrors the Laravel debug controller's URL pattern
 * (https://foundry-cms.test/debug/websites/{slug}/page/{id}/preview) so an
 * editor can paste a page ID and see the rendered output even when the
 * page-level translation has no slug yet.
 *
 * Requires FOUNDRY_PREVIEW_TOKEN in .env (forwarded as X-Preview-Token).
 */
export const prerender = false;

import { fetchPageById } from '../../../lib/foundry';
import { getTheme } from '../../../themes/registry';

const { locale, id } = Astro.params;
if (!locale || !id) {
    return new Response('Missing locale or id segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const page = await fetchPageById(locale, id, tenant.website.slug);
if (!page) {
    return new Response('Not found', { status: 404 });
}

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, Hero, PageHeader, PageBlocks, PageFooter, PreviewBanner } = theme;

const t = page.translation;
// Page-level translation may be absent on work-in-progress pages (the
// pipeline emits blocks before the meta). Fall back to the source
// entity's name so the preview still has something useful at the top.
const sourceName = page.sourceable && 'name' in page.sourceable ? page.sourceable.name : null;
const title = t?.meta_title ?? t?.title ?? sourceName ?? `Preview #${id}`;
const description = t?.meta_description ?? t?.snippet ?? null;
const fallbackTitle = sourceName ?? `Preview #${id}`;

const heroImage = page.cover_image
    ?? (page.sourceable && 'cover_image' in page.sourceable
        ? page.sourceable.cover_image
        : null);
const heroAlt = t?.title ?? sourceName ?? '';
---

<Layout title={title} description={description} locale={locale}>
    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
        pageLocales={page.available_locales}
    />

    <PreviewBanner id={id} liveSlug={t?.slug ?? null} locale={locale} />
    <Hero image={heroImage} alt={heroAlt} />
    <PageHeader translation={t} fallbackTitle={fallbackTitle} />
    <PageBlocks blocks={page.blocks} />
    {t && <PageFooter translation={t} />}
</Layout>
