---
/**
 * Locale landing page. Hands the sitemap to the active theme's
 * LocaleLanding component — no markup or class names live in the
 * page itself.
 *
 * Prerendered at build time when `WEBSITE_BUILD_HOSTNAME` is set —
 * one HTML file per enabled locale. In `astro dev` we keep SSR
 * (prerender = false) so the middleware resolves the tenant from
 * the Host header.
 */
export const prerender = true;

import {
    buildLocalesFilter,
    buildPathsFilter,
    fetchSitemap,
    fetchWebsite,
    localesWithPathPrefix,
} from '../../lib/foundry';
import { getTheme } from '../../themes/registry';

export async function getStaticPaths() {
    const hostname = import.meta.env.WEBSITE_BUILD_HOSTNAME;
    if (!hostname) {
        return [];
    }

    const website = await fetchWebsite(hostname);
    if (!website) {
        throw new Error(`Unknown WEBSITE_BUILD_HOSTNAME: ${hostname}`);
    }

    const localesFilter = buildLocalesFilter();
    const pathsFilter = buildPathsFilter();

    // Locales rendering at root (no path_prefix) ship their landing
    // from `src/pages/index.astro` — keep this route to the prefixed
    // set so the two never compete for the same URL.
    return localesWithPathPrefix(website.locales)
        .filter((l) => !localesFilter || localesFilter.has(l.locale))
        .filter((l) => !pathsFilter || pathsFilter.has(`${l.locale}/`))
        .map((l) => ({ params: { locale: l.locale } }));
}

const { locale } = Astro.params;
if (!locale) {
    return new Response('Missing locale segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const sitemap = await fetchSitemap(locale, tenant.website.hostname);

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, LocaleLanding, Seo } = theme;
---

<Layout title={`${tenant.website.name} — ${locale}`} locale={locale}>
    <Seo slot="head" page={null} locale={locale} type="website" />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
    />
    <LocaleLanding
        websiteName={tenant.website.name}
        locale={locale}
        isDefaultLocale={tenant.defaultLocale === locale}
        sitemap={sitemap}
    />
</Layout>
