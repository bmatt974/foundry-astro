---
/**
 * Public author profile route — localised path segment via the i18n
 * dictionary's `routes.authorsPrefix` so French sites render
 * `/fr/auteurs/{slug}`, English sites `/en/authors/{slug}`, etc. The
 * dynamic `[authorsPrefix]` segment in the filename is the
 * mechanism, but only locale-matching combinations are emitted by
 * getStaticPaths — all other 3-segment URLs fall through to the
 * `[...path]` catch-all.
 *
 * Article list comes from the dedicated author-detail endpoint
 * (not from /resolve) so the tenant cache stays lean and the page
 * gets both the full bio + ordered articles in one fetch.
 *
 * Prerendered at build time when `WEBSITE_BUILD_HOSTNAME` is set —
 * one HTML file per (enabled locale × enabled author) pair on the
 * pinned site.
 */
export const prerender = true;

import { authorUrl, pickAuthorTranslation } from '../../../lib/author';
import {
    buildLocalesFilter,
    fetchAuthorDetail,
    fetchWebsiteByHost,
} from '../../../lib/foundry';
import { __ } from '../../../lib/i18n';
import { getTheme } from '../../../themes/registry';

export async function getStaticPaths() {
    const hostname = import.meta.env.WEBSITE_BUILD_HOSTNAME;
    if (!hostname) {
        return [];
    }

    const resolved = await fetchWebsiteByHost(hostname);
    if (!resolved) {
        throw new Error(`Unknown WEBSITE_BUILD_HOSTNAME: ${hostname}`);
    }

    const localesFilter = buildLocalesFilter();
    const paths: Array<{ params: { locale: string; authorsPrefix: string; slug: string } }> = [];

    for (const localeRow of resolved.locales) {
        if (!localeRow.enabled) {
            continue;
        }
        if (localesFilter && !localesFilter.has(localeRow.locale)) {
            continue;
        }
        const authorsPrefix = __('routes.authorsPrefix', localeRow.locale);
        for (const author of resolved.team) {
            // Skip authors with no usable translation in this locale —
            // mirrors what the route's render path does so no broken
            // entry ships in the static dist.
            if (pickAuthorTranslation(author, localeRow.locale) === null) {
                continue;
            }
            paths.push({
                params: {
                    locale: localeRow.locale,
                    authorsPrefix,
                    slug: author.slug,
                },
            });
        }
    }

    return paths;
}

const { locale, authorsPrefix, slug } = Astro.params;
if (!locale || !authorsPrefix || !slug) {
    return new Response('Missing route segments.', { status: 400 });
}

// Runtime guard: the dynamic [authorsPrefix] segment also matches
// random 3-segment URLs that landed here via dev SSR. Reject anything
// that doesn't match the expected prefix for this locale so unrelated
// paths return 404 instead of leaking the route.
const expectedPrefix = __('routes.authorsPrefix', locale);
if (authorsPrefix !== expectedPrefix) {
    return new Response('Not found.', { status: 404 });
}

const tenant = Astro.locals.tenant;
const detail = await fetchAuthorDetail(locale, slug, tenant.website.hostname);
if (!detail) {
    return new Response('Author not found.', { status: 404 });
}

const author = {
    slug: detail.slug,
    name: detail.identity?.name ?? detail.slug,
    title: detail.identity?.title ?? null,
    bioShort: detail.identity?.bio_short ?? null,
    bio: detail.identity?.bio ?? null,
    photoUrl: detail.photo_url,
    externalUrl: detail.external_url,
    twitterHandle: detail.twitter_handle,
};

const theme = getTheme(tenant.template);
const { Layout, AuthorPage, LocaleSwitcher, Seo } = theme;
---

<Layout
    title={`${author.name} — ${tenant.website.name}`}
    description={author.title ?? author.bioShort ?? null}
    locale={locale}
>
    <Seo slot="head" page={null} locale={locale} type="website" title={author.name} description={author.bioShort ?? author.title ?? null} />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
    />

    <AuthorPage
        author={author}
        articles={detail.articles}
        locale={locale}
        canonicalUrl={authorUrl(locale, author.slug)}
    />
</Layout>
