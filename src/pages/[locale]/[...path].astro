---
/**
 * Catch-all page route. Hits the Foundry headless API for the
 * (website, locale, path) tuple and hands the result off to the
 * active theme's Article dispatcher, which decides per-page-type
 * which chrome sections to render.
 */
export const prerender = false;

import { fetchPage } from '../../lib/foundry';
import { getTheme } from '../../themes/registry';

const { locale, path } = Astro.params;
if (!locale) {
    return new Response('Missing locale segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const page = await fetchPage(locale, path ?? '', tenant.website.slug);
if (!page) {
    return new Response('Not found', { status: 404 });
}

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, Seo, Article } = theme;

const t = page.translation;
const title = t?.meta_title ?? t?.title ?? 'Untitled';
const description = t?.meta_description ?? t?.snippet ?? null;
---

<Layout title={title} description={description} locale={locale}>
    <Seo slot="head" page={page} locale={locale} type="article" />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
        pageLocales={page.available_locales}
    />

    <Article page={page} locale={locale} />
</Layout>
