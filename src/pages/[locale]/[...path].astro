---
/**
 * Catch-all page route. Hits the Foundry headless API for the
 * (website, locale, path) tuple and renders the returned blocks
 * through the active theme.
 *
 * Rendered on each request (no prerendering) because content is
 * authored in the Laravel CMS and may change between deploys.
 */
export const prerender = false;

import { fetchPage } from '../../lib/foundry';
import { getTheme } from '../../themes/registry';

const { locale, path } = Astro.params;
if (!locale) {
    return new Response('Missing locale segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const page = await fetchPage(locale, path ?? '', tenant.website.slug);
if (!page) {
    return new Response('Not found', { status: 404 });
}

const theme = getTheme(tenant.template);
const { Layout, Block, LocaleSwitcher, Markdown } = theme;

const t = page.translation;
const title = t?.meta_title ?? t?.title ?? 'Untitled';
const description = t?.meta_description ?? t?.snippet ?? null;
---

<Layout title={title} description={description} locale={locale}>
    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
        pageLocales={page.available_locales}
    />

    <header class="mb-10 border-b border-gray-200 pb-6">
        {t?.eyebrow && (
            <p class="mb-2 text-sm font-medium uppercase tracking-wide text-indigo-600">
                {t.eyebrow}
            </p>
        )}
        <h1 class="text-4xl font-bold tracking-tight text-gray-900">
            {t?.title ?? 'Untitled'}
        </h1>
        {t?.subtitle && <p class="mt-3 text-xl text-gray-600">{t.subtitle}</p>}
        {t?.intro && <Markdown text={t.intro} size="lg" class="mt-6 text-gray-700" />}
    </header>

    {page.blocks.length > 0 ? (
        <div class="space-y-2">
            {page.blocks.map((block) => <Block block={block} />)}
        </div>
    ) : (
        <p class="text-sm italic text-gray-500">No blocks on this page.</p>
    )}

    {t?.conclusion && (
        <footer class="mt-12 border-t border-gray-200 pt-6">
            <Markdown text={t.conclusion} class="text-gray-700" />
        </footer>
    )}

    {(page.nav.parent || page.nav.children.length > 0 || page.nav.siblings.length > 0) && (
        <nav class="mt-16 border-t border-gray-200 pt-6 text-sm text-gray-600">
            {page.nav.parent && (
                <p class="mb-2">
                    ↑ <a href={`/${locale}/${page.nav.parent.slug ?? ''}`} class="text-indigo-600 hover:underline">
                        {page.nav.parent.title}
                    </a>
                </p>
            )}
            {page.nav.children.length > 0 && (
                <div class="mb-4">
                    <p class="mb-2 font-medium text-gray-900">Sous-pages</p>
                    <ul class="list-disc pl-5">
                        {page.nav.children.map((c) => (
                            <li>
                                <a href={`/${locale}/${c.slug ?? ''}`} class="text-indigo-600 hover:underline">
                                    {c.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
            {page.nav.siblings.length > 0 && (
                <div>
                    <p class="mb-2 font-medium text-gray-900">À voir aussi</p>
                    <ul class="list-disc pl-5">
                        {page.nav.siblings.map((s) => (
                            <li>
                                <a href={`/${locale}/${s.slug ?? ''}`} class="text-indigo-600 hover:underline">
                                    {s.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </nav>
    )}
</Layout>
