---
/**
 * Catch-all page route. Hits the Foundry headless API for the
 * (website, locale, path) tuple and hands the result off to the
 * active theme's Article dispatcher, which decides per-page-type
 * which chrome sections to render.
 *
 * Prerendered at build time when `WEBSITE_BUILD_HOSTNAME` is set —
 * each (locale, path) tuple becomes a static HTML file. In `astro dev`
 * we keep SSR (prerender = false) so the middleware resolves the
 * tenant from the Host header — otherwise getStaticPaths would return
 * an empty list and every URL would 404 during local development.
 */
export const prerender = true;

import { buildLocalesFilter, buildPathsFilter, fetchPage, fetchSitemap, fetchWebsite } from '../../lib/foundry';
import { getTheme } from '../../themes/registry';

export async function getStaticPaths() {
    const hostname = import.meta.env.WEBSITE_BUILD_HOSTNAME;
    if (!hostname) {
        // No build-time tenant pin: nothing to enumerate. Routes
        // are unreachable in static mode, but `astro dev` falls
        // through to SSR via the middleware.
        return [];
    }

    const website = await fetchWebsite(hostname);
    if (!website) {
        throw new Error(`Unknown WEBSITE_BUILD_HOSTNAME: ${hostname}`);
    }

    const localesFilter = buildLocalesFilter();
    const enabledLocales = website.locales
        .filter((l) => l.enabled)
        .filter((l) => !localesFilter || localesFilter.has(l.locale));
    const filter = buildPathsFilter();

    const paths: Array<{ params: { locale: string; path: string } }> = [];

    for (const locale of enabledLocales) {
        // PageTranslation.slug is the full URL path (the backend
        // resolves pages by exact `slug` match, ignoring the parent
        // chain — see WebsitePageController::resolvePage). Two pages
        // can share the same leaf slug; Astro warns on duplicates so
        // we dedupe per-locale.
        const sitemap = await fetchSitemap(locale.locale, hostname);
        const seen = new Set<string>();
        for (const node of sitemap) {
            const path = node.slug;
            if (!path || seen.has(path)) continue;
            if (filter && !filter.has(`${locale.locale}/${path}`)) continue;
            seen.add(path);
            paths.push({ params: { locale: locale.locale, path } });
        }
    }

    return paths;
}

const { locale, path } = Astro.params;
if (!locale) {
    return new Response('Missing locale segment.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const page = await fetchPage(locale, path ?? '', tenant.website.hostname);
if (!page) {
    return new Response('Not found', { status: 404 });
}
Astro.locals.pagePublishedAt = page.published_at ?? page.translation?.published_at ?? null;

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, Seo, Article } = theme;

const t = page.translation;
const title = t?.meta_title ?? t?.title ?? 'Untitled';
const description = t?.meta_description ?? t?.snippet ?? null;
---

<Layout title={title} description={description} locale={locale}>
    <Seo slot="head" page={page} locale={locale} type="article" />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
        pageLocales={page.available_locales}
    />

    <Article page={page} locale={locale} />
</Layout>
