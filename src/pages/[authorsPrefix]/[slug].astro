---
/**
 * Root-level author profile route for locales served without a URL
 * prefix (sub-directory default-at-root, sub-domain, different TLD).
 *
 * Mirrors `src/pages/[locale]/[authorsPrefix]/[slug].astro` but
 * filters the getStaticPaths emit list to `localesAtRoot` only —
 * the two routes share no URL space, so Astro's specificity rules
 * resolve each request to exactly one of them.
 *
 * The `[authorsPrefix]` segment is dynamic so each locale can use
 * its native term: "authors" (en), "auteurs" (fr), "autores" (es).
 * Runtime guard 404s mismatched prefixes; getStaticPaths emits only
 * locale-correct combinations.
 */
export const prerender = true;

import { authorPath, pickAuthorTranslation } from '../../lib/author';
import {
    buildLocalesFilter,
    fetchAuthorDetail,
    fetchWebsiteByHost,
    localesAtRoot,
    type AvailableLocale,
} from '../../lib/foundry';
import { __ } from '../../lib/i18n';
import { pageUrl } from '../../lib/seo';
import { getTheme } from '../../themes/registry';

export async function getStaticPaths() {
    const hostname = import.meta.env.WEBSITE_BUILD_HOSTNAME;
    if (!hostname) {
        return [];
    }

    const resolved = await fetchWebsiteByHost(hostname);
    if (!resolved) {
        throw new Error(`Unknown WEBSITE_BUILD_HOSTNAME: ${hostname}`);
    }

    const localesFilter = buildLocalesFilter();
    const paths: Array<{ params: { authorsPrefix: string; slug: string } }> = [];

    for (const localeRow of localesAtRoot(resolved.locales)) {
        if (localesFilter && !localesFilter.has(localeRow.locale)) {
            continue;
        }
        const authorsPrefix = __('routes.authorsPrefix', localeRow.locale);
        for (const author of resolved.team) {
            if (pickAuthorTranslation(author, localeRow.locale) === null) {
                continue;
            }
            paths.push({
                params: {
                    authorsPrefix,
                    slug: author.slug,
                },
            });
        }
    }

    return paths;
}

const { authorsPrefix, slug } = Astro.params;
if (!authorsPrefix || !slug) {
    return new Response('Missing route segments.', { status: 400 });
}

const tenant = Astro.locals.tenant;
const locale = Astro.locals.locale;

const expectedPrefix = __('routes.authorsPrefix', locale);
if (authorsPrefix !== expectedPrefix) {
    return new Response('Not found.', { status: 404 });
}

const detail = await fetchAuthorDetail(locale, slug, tenant.website.hostname);
if (!detail) {
    return new Response('Author not found.', { status: 404 });
}

const teamEntry = tenant.team.find((author) => author.slug === slug);
const availableLocales: AvailableLocale[] = teamEntry
    ? Object.keys(teamEntry.translations).map((translationLocale) => ({
        locale: translationLocale,
        slug: authorPath(translationLocale, slug),
    }))
    : [];

const author = {
    slug: detail.slug,
    name: detail.identity?.name ?? detail.slug,
    title: detail.identity?.title ?? null,
    bioShort: detail.identity?.bio_short ?? null,
    bio: detail.identity?.bio ?? null,
    photoUrl: detail.photo_url,
    externalUrl: detail.external_url,
    twitterHandle: detail.twitter_handle,
};

const theme = getTheme(tenant.template);
const { Layout, AuthorPage, LocaleSwitcher, Seo } = theme;
---

<Layout
    title={`${author.name} — ${tenant.website.name}`}
    description={author.title ?? author.bioShort ?? null}
    locale={locale}
>
    <Seo
        slot="head"
        page={null}
        locale={locale}
        type="website"
        title={author.name}
        description={author.bioShort ?? author.title ?? null}
        availableLocales={availableLocales}
        canonicalUrl={pageUrl(tenant, locale, authorPath(locale, slug)) ?? undefined}
    />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={locale}
        websiteLocales={tenant.locales}
        pageLocales={availableLocales}
    />

    <AuthorPage
        author={author}
        articles={detail.articles}
        locale={locale}
    />
</Layout>
