---
/**
 * Inner frame of the dev theme preview. Renders a SYNTHETIC FULL
 * PAGE through the active theme's `Layout` + `Article` chrome —
 * site header, breadcrumb, hero image, page header, byline, the
 * five block samples, page footer, site footer.
 *
 * Meant to be embedded in the `/dev/preview` outer shell's iframe.
 * Direct visits also work for sharable URLs.
 *
 * Only available in dev mode.
 */
export const prerender = false;

import type { Author, AvailableLocale, BlockType, MenuItem, MenuItemType, Page, PageBlock, Sourceable } from '../../../lib/foundry';
import { getTheme, listThemes } from '../../../themes/registry';
// Pull every theme's stylesheet so any active theme renders fully.
// Theme stylesheets use disjoint class namespaces (wp-block-*,
// block--*, Bootstrap, basic .brand-*) so they coexist without
// collisions.
import '../../../themes/basic/styles.css';
import '../../../themes/bootstrap-classic/styles.css';
import '../../../themes/drupal-bartik/styles.css';
import '../../../themes/wp-classic/styles.css';

if (import.meta.env.PROD) {
    return new Response('Not found', { status: 404 });
}

const requestedTheme = Astro.url.searchParams.get('theme');
const themes = listThemes();
const themeName = requestedTheme && themes.includes(requestedTheme)
    ? requestedTheme
    : (Astro.locals.tenant?.website.template ?? 'basic');
const theme = getTheme(themeName);

const locale = Astro.locals.locale ?? 'en';

const blockType = (value: string) => value as BlockType;

function fakeBlock(
    id: number,
    type: BlockType,
    content: Record<string, unknown>,
): PageBlock {
    return {
        id,
        block_type: type,
        variant: null,
        cluster_block_key: null,
        related_page_id: null,
        position: id,
        settings: null,
        media: null,
        content,
        children: [],
    };
}

const RICH_MARKDOWN_BODY = `## A short history

Construction began under emperor **Vespasian** in 72 CE and finished under his son *Titus* around 80 CE. Inaugurated with 100 days of games. At peak capacity, the arena seated about \`50,000\` spectators.

### What you'll see today

The structure that survives is the result of two millennia of earthquakes, looting and partial restoration. Highlights of a typical visit:

- **The Hypogeum** — the underground tunnel network where gladiators and animals waited before entering the arena
- **The upper tiers** — accessible via timed-entry tickets, offering panoramic views over the Forum
- **The Arena Floor** — a partial reconstruction lets you stand where the combatants fought

> "If the Colosseum stands, Rome stands; when the Colosseum falls, Rome will fall; when Rome falls, the world will fall."
> — *the Venerable Bede, 8th century*

#### Visiting tips

1. Book a [timed-entry ticket](https://example.com/book) at least 48 hours ahead — slots fill fast in peak season
2. Combine your visit with the **Roman Forum** + **Palatine Hill** (same ticket)
3. Arrive 15 minutes before your slot — the security check takes time
`;

const blocks: PageBlock[] = [
    fakeBlock(1, blockType('text'), {
        title: 'About the Colosseum',
        body: RICH_MARKDOWN_BODY,
    }),
    fakeBlock(2, blockType('cta'), {
        label: 'Book your visit',
        url: 'https://example.com/book',
        description: 'Skip the lines and reserve your timed-entry ticket online — limited slots each hour.',
    }),
    fakeBlock(3, blockType('key_facts'), {
        title: 'At a glance',
        facts: [
            { label: 'Built', value: '72 CE' },
            { label: 'Capacity', value: '50,000 spectators' },
            { label: 'UNESCO listing', value: '1980' },
            { label: 'Annual visitors', value: '7.6 million' },
        ],
    }),
    fakeBlock(4, blockType('faq'), {
        items: [
            { question: 'When was the Colosseum built?', answer: 'Construction began under Emperor Vespasian in 72 CE and finished under Titus in 80 CE.' },
            { question: 'How long does a visit take?', answer: 'Most visitors spend 1.5 to 2 hours. With the arena floor and underground, count on 3+ hours.' },
            { question: 'Are tickets refundable?', answer: 'Standard tickets are non-refundable; some operators offer flexible cancellation for an extra fee.' },
        ],
    }),
    fakeBlock(5, blockType('top_list'), {
        heading: 'Nearby attractions',
        items: [
            { place_id: 1, name: 'Roman Forum', type: 'archaeological_site', image: 'https://picsum.photos/seed/forum-rome/640/480', description: 'The political and religious heart of ancient Rome.' },
            { place_id: 2, name: 'Palatine Hill', type: 'archaeological_site', image: 'https://picsum.photos/seed/palatine-rome/640/480', description: 'Where imperial palaces rose above the Forum.' },
            { place_id: 3, name: 'Arch of Constantine', type: 'monument', image: 'https://picsum.photos/seed/arch-constantine/640/480', description: 'Triumphal arch dedicated in 315 CE.' },
        ],
    }),
];

const fakeAuthor: Author = {
    slug: 'sophie-berthier',
    photo_url: 'https://picsum.photos/seed/sophie-berthier/240/240',
    external_url: null,
    twitter_handle: null,
    position: 0,
    translations: {
        [locale]: {
            name: 'Sophie Berthier',
            title: 'Travel writer based in Rome',
            bio_short: 'Five years in Rome, writing about food and working-class neighborhoods.',
            bio: null,
        },
    },
};

const fakeSourceable: Sourceable = {
    type: 'place',
    id: 100,
    name: 'Colosseum',
    canonical_name: 'Colosseum, Rome',
    place_type: 'amphitheatre',
    coordinates: { lat: 41.8902, lon: 12.4922 },
    country_code: 'IT',
    website: 'https://colosseo.it',
    cover_image: 'https://picsum.photos/seed/colosseum-hero/1600/900',
};

const availableLocales: AvailableLocale[] = [
    { locale: 'en', slug: 'colosseum' },
    { locale: 'fr', slug: 'colisee' },
];

// Synthetic menus — the preview is a theme-rendering Storybook,
// not a snapshot of any real site's CMS data. Each menu item ships
// every field the MenuItem contract carries so deep components
// don't break on missing fields.
function fakeMenuItem(id: number, label: string, href: string): MenuItem {
    return {
        id,
        type: 'external' as MenuItemType,
        parent_id: null,
        position: id,
        label,
        href,
        title_attribute: null,
        css_class: null,
        icon: null,
        open_in_new_tab: false,
        visibility_rules: null,
        children: [],
    };
}

const fakeHeaderItems: MenuItem[] = [
    fakeMenuItem(1, 'Home', '/'),
    fakeMenuItem(2, 'Rome', '/rome'),
    fakeMenuItem(3, 'Must-See', '/must-see-rome'),
    fakeMenuItem(4, 'Hotels', '/where-to-stay-in-rome'),
    fakeMenuItem(5, 'About', '/about'),
];

const fakeFooterItems: MenuItem[] = [
    fakeMenuItem(101, 'About', '/about'),
    fakeMenuItem(102, 'Contact', '/contact'),
    fakeMenuItem(103, 'Legal notice', '/legal-notice'),
    fakeMenuItem(104, 'Privacy policy', '/privacy-policy'),
    fakeMenuItem(105, 'Affiliate disclosure', '/affiliate-disclosure'),
];

const fakePage: Page = {
    id: 999,
    website_id: Astro.locals.tenant?.website.id ?? 0,
    page_type: 'guide',
    template: themeName,
    is_indexable: true,
    seo_tier: 'featured',
    cover_image: 'https://picsum.photos/seed/colosseum-hero/1600/900',
    position: 0,
    published_at: '2026-05-12T10:00:00+00:00',
    seo: null,
    settings: null,
    translation: {
        locale,
        slug: 'colosseum',
        eyebrow: 'GUIDE 2026',
        title: 'Visiting the Colosseum: tickets, history, and what to skip',
        subtitle: 'A practical guide to Rome\'s most iconic monument — what to book, when to go, and how long it takes.',
        intro: 'The Colosseum is the most-visited single monument in Italy. With 7.6 million arrivals a year, the line for tickets is the visit. Book ahead, and you save two hours.',
        body: null,
        conclusion: null,
        highlights: null,
        snippet: null,
        meta_title: null,
        meta_description: null,
        published_at: '2026-05-12T10:00:00+00:00',
    },
    blocks,
    sourceable: fakeSourceable,
    nav: {
        parent: { id: 1, slug: 'rome', title: 'Rome', page_type: 'hub', position: 0 },
        breadcrumb: [
            { id: 0, slug: null, title: 'Italy', page_type: null, position: 0 },
            { id: 1, slug: 'rome', title: 'Rome', page_type: 'hub', position: 0 },
        ],
        children: [],
        siblings: [
            { id: 2, slug: 'pantheon', title: 'Pantheon', page_type: 'guide', position: 1 },
            { id: 3, slug: 'roman-forum', title: 'Roman Forum', page_type: 'guide', position: 2 },
        ],
    },
    authors: [fakeAuthor],
    available_locales: availableLocales,
    injections: [],
};

// Wire locale into Astro.locals so any deep component that reads it
// (Markdown links, formatters, etc.) sees the same value Article does.
Astro.locals.locale = locale;

// bootstrap-classic emits Bootstrap class names; without the CDN
// sheet `.row` / `.col-md-*` / `.btn` stay unstyled.
const externalStylesheets = themeName === 'bootstrap-classic'
    ? ['https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css']
    : [];

const { Layout, Article, LocaleSwitcher } = theme;
const pageTitle = fakePage.translation?.title ?? 'Preview';
const pageDescription = fakePage.translation?.intro ?? null;
---

<Layout
    title={pageTitle}
    description={pageDescription}
    locale={locale}
    headerItems={fakeHeaderItems}
    footerItems={fakeFooterItems}
>
    <Fragment slot="head">
        <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%234f46e5'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='system-ui,sans-serif' font-size='20' font-weight='700' fill='white'%3EP%3C/text%3E%3C/svg%3E" />
        {externalStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    </Fragment>
    {Astro.locals.tenant && (
        <LocaleSwitcher
            slot="locale-switcher"
            currentLocale={locale}
            websiteLocales={Astro.locals.tenant.locales}
            pageLocales={availableLocales}
        />
    )}
    <Article page={fakePage} locale={locale} />
</Layout>
