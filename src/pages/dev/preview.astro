---
/**
 * Dev-only theme preview / Storybook for blocks. Renders each
 * registered block_type with fake lorem-ipsum data so a theme
 * author can see the rendered markup for every block type without
 * having to navigate the live CMS pages.
 *
 * URL: `/dev/preview?theme=<name>`
 *   - Default = the tenant's active theme (from middleware), or
 *     `basic` when no tenant is resolved.
 *   - Switch via the links in the header.
 *
 * Only available in dev mode (`npm run dev`). In production builds
 * the registry only contains ONE theme via DCE so the switch is
 * meaningless — the route 404s.
 */
export const prerender = false;

import type { BlockType, PageBlock } from '../../lib/foundry';
import { getTheme, listThemes } from '../../themes/registry';
// Pull every theme's stylesheet into the preview bundle so the
// dispatched blocks render with their full styling. Without this,
// `theme.Block` ships its markup but Tailwind / hand-written CSS
// for each theme stays unloaded and the cards look bare. Theme
// stylesheets use disjoint class namespaces (wp-block-*, block--*,
// Bootstrap, basic .brand-*) so they coexist without collisions.
import '../../themes/basic/styles.css';
import '../../themes/bootstrap-classic/styles.css';
import '../../themes/drupal-bartik/styles.css';
import '../../themes/wp-classic/styles.css';

if (import.meta.env.PROD) {
    return new Response('Not found', { status: 404 });
}

const requestedTheme = Astro.url.searchParams.get('theme');
const themes = listThemes();
const themeName = requestedTheme && themes.includes(requestedTheme)
    ? requestedTheme
    : (Astro.locals.tenant?.website.template ?? 'basic');
const theme = getTheme(themeName);

const blockType = (value: string) => value as BlockType;

function fakeBlock(
    id: number,
    type: BlockType,
    content: Record<string, unknown>,
    overrides: Partial<PageBlock> = {},
): PageBlock {
    return {
        id,
        block_type: type,
        variant: null,
        cluster_block_key: null,
        related_page_id: null,
        position: id,
        settings: null,
        media: null,
        content,
        children: [],
        ...overrides,
    };
}

const RICH_MARKDOWN_BODY = `## A short history

Construction began under emperor **Vespasian** in 72 CE and finished under his son *Titus* around 80 CE. Inaugurated with 100 days of games. At peak capacity, the arena seated about \`50,000\` spectators.

### What you'll see today

The structure that survives is the result of two millennia of earthquakes, looting and partial restoration. Highlights of a typical visit:

- **The Hypogeum** — the underground tunnel network where gladiators and animals waited before entering the arena
- **The upper tiers** — accessible via timed-entry tickets, offering panoramic views over the Forum
- **The Arena Floor** — a partial reconstruction lets you stand where the combatants fought

> "If the Colosseum stands, Rome stands; when the Colosseum falls, Rome will fall; when Rome falls, the world will fall."
> — *the Venerable Bede, 8th century*

#### Visiting tips

1. Book a [timed-entry ticket](https://example.com/book) at least 48 hours ahead — slots fill fast in peak season
2. Combine your visit with the **Roman Forum** + **Palatine Hill** (same ticket)
3. Arrive 15 minutes before your slot — the security check takes time
`;

const samples: { label: string; block: PageBlock }[] = [
    {
        label: 'Text',
        block: fakeBlock(1, blockType('text'), {
            title: 'About the Colosseum',
            body: RICH_MARKDOWN_BODY,
        }),
    },
    {
        label: 'CTA',
        block: fakeBlock(2, blockType('cta'), {
            label: 'Book your visit',
            url: 'https://example.com/book',
            description: 'Skip the lines and reserve your timed-entry ticket online — limited slots each hour.',
        }),
    },
    {
        label: 'Key Facts',
        block: fakeBlock(3, blockType('key_facts'), {
            title: 'At a glance',
            facts: [
                { label: 'Built', value: '72 CE' },
                { label: 'Capacity', value: '50,000 spectators' },
                { label: 'UNESCO listing', value: '1980' },
                { label: 'Annual visitors', value: '7.6 million' },
            ],
        }),
    },
    {
        label: 'FAQ',
        block: fakeBlock(4, blockType('faq'), {
            items: [
                { question: 'When was the Colosseum built?', answer: 'Construction began under Emperor Vespasian in 72 CE and finished under Titus in 80 CE.' },
                { question: 'How long does a visit take?', answer: 'Most visitors spend 1.5 to 2 hours. With the arena floor and underground, count on 3+ hours.' },
                { question: 'Are tickets refundable?', answer: 'Standard tickets are non-refundable; some operators offer flexible cancellation for an extra fee.' },
            ],
        }),
    },
    {
        label: 'TopList',
        block: fakeBlock(5, blockType('top_list'), {
            heading: 'Top 4 attractions in Rome',
            items: [
                { place_id: 1, name: 'Colosseum', type: 'amphitheatre', image: 'https://picsum.photos/seed/colosseum-rome/640/480', description: 'Iconic Flavian amphitheatre, the largest of its kind in the Roman Empire.' },
                { place_id: 2, name: 'Pantheon', type: 'temple', image: 'https://picsum.photos/seed/pantheon-rome/640/480', description: 'Best-preserved Roman building, completed under Hadrian around 125 CE.' },
                { place_id: 3, name: 'Roman Forum', type: 'archaeological_site', image: 'https://picsum.photos/seed/forum-rome/640/480', description: 'The political and religious heart of ancient Rome.' },
                { place_id: 4, name: 'Vatican Museums', type: 'museum_gallery', image: 'https://picsum.photos/seed/vatican-museums/640/480', description: 'Seven kilometres of corridors of art, ending in the Sistine Chapel.' },
            ],
        }),
    },
];

// Each theme may need framework-specific CSS loaded for the preview
// to render faithfully. bootstrap-classic's components emit Bootstrap
// class names; without the CDN sheet `.row` / `.col-md-*` / `.btn`
// stay unstyled. Other themes ship their own self-contained CSS via
// the static imports above, so this is the only special case.
const externalStylesheets = themeName === 'bootstrap-classic'
    ? ['https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css']
    : [];

// Uniform preview width across themes so visual diffs across themes
// stay meaningful — 1200px is wide enough to trigger every theme's
// `lg` breakpoint (TopList 3-column grid on basic / bootstrap).
const bodyMaxWidth = '1200px';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Block preview — {themeName}</title>
        {externalStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
        <style is:inline set:html={`
            body { font-family: ui-sans-serif, system-ui, sans-serif; max-width: ${bodyMaxWidth}; margin: 2rem auto; padding: 1rem; color: #1f2937; }
            .controls { background: #f3f4f6; padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 2rem; display: flex; gap: 1rem; align-items: center; }
            .controls strong { font-size: 0.875rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
            .controls a { color: #4f46e5; text-decoration: none; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.875rem; }
            .controls a.active { background: #4f46e5; color: white; }
            .preview { border: 1px solid #e5e7eb; padding: 1.5rem; margin: 1.5rem 0; border-radius: 8px; }
            .preview-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #9ca3af; margin-bottom: 1rem; font-weight: 600; }
            .preview-body { background: white; padding: 1.5rem; border-radius: 4px; }
        `} />
    </head>
    <body>
        <h1>Block preview — {themeName}</h1>
        <p>Dev-only — every block_type rendered with synthetic content.</p>

        <div class="controls">
            <strong>Theme:</strong>
            {themes.map((name) => (
                <a href={`/dev/preview?theme=${name}`} class={name === themeName ? 'active' : ''}>{name}</a>
            ))}
        </div>

        {samples.map(({ label, block }) => (
            <div class="preview">
                <div class="preview-label">{label} — block_type={block.block_type}</div>
                <div class="preview-body">
                    <theme.Block block={block} />
                </div>
            </div>
        ))}
    </body>
</html>
