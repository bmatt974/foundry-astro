---
/**
 * Tenant root. Two distinct roles depending on routing mode:
 *
 *   - Sub-directory with default locale at root, sub-domain, or
 *     different-TLD modes — `/` is the canonical homepage of the
 *     default locale. Renders the LocaleLanding component directly.
 *
 *   - Sub-directory with prefix on EVERY locale — `/` has no real
 *     page; the canonical homepage lives at `/{default_locale}/`.
 *     Falls back to a `<meta http-equiv="refresh">` to that URL so
 *     visitors landing at the bare host don't see a 404 (the SEO
 *     impact is acceptable: this URL has no inbound links from
 *     within the site, and search engines see the proper canonical
 *     on the locale landing).
 *
 * Prerendered at build time so the bare-host URL renders as a static
 * HTML file (CDN-friendly). In dev the same code runs via SSR,
 * so the middleware's tenant + locale resolution is exercised on
 * every hit.
 */
export const prerender = true;

import { fetchSitemap, normalisedPathPrefix } from '../lib/foundry';
import { getTheme } from '../themes/registry';

export async function getStaticPaths() {
    const hostname = import.meta.env.WEBSITE_BUILD_HOSTNAME;
    if (!hostname) {
        return [];
    }

    // `index.astro` has no dynamic segments — getStaticPaths returns
    // a single empty-params entry to keep the prerender pipeline
    // happy. The render logic below decides what to do based on the
    // tenant's default-locale path_prefix.
    return [{ params: {} }];
}

const tenant = Astro.locals.tenant;
const defaultLocale = tenant.defaultLocale ?? tenant.locales[0]?.locale ?? 'en';
const defaultLocaleRow = tenant.locales.find((l) => l.locale === defaultLocale);
const defaultPrefix = defaultLocaleRow ? normalisedPathPrefix(defaultLocaleRow) : '';

// All-prefixed mode: the bare host has no real homepage. Serve a
// soft redirect to `/{default_locale}/` so the visitor lands on the
// canonical URL without seeing a 404. Static-friendly (meta-refresh
// works on a CDN; no worker needed).
if (defaultPrefix !== '') {
    return new Response(
        `<!doctype html>\n<meta charset="utf-8">\n<meta http-equiv="refresh" content="0; url=/${defaultPrefix}/">\n<title>Redirecting…</title>\n<link rel="canonical" href="/${defaultPrefix}/">\n`,
        { status: 200, headers: { 'content-type': 'text/html; charset=utf-8' } },
    );
}

// Default-at-root mode: this URL IS the canonical homepage of the
// default locale. Render the LocaleLanding component normally.
const sitemap = await fetchSitemap(defaultLocale, tenant.website.hostname);

const theme = getTheme(tenant.template);
const { Layout, LocaleSwitcher, LocaleLanding, Seo } = theme;
---

<Layout title={`${tenant.website.name} — ${defaultLocale}`} locale={defaultLocale}>
    <Seo slot="head" page={null} locale={defaultLocale} type="website" />

    <LocaleSwitcher
        slot="locale-switcher"
        currentLocale={defaultLocale}
        websiteLocales={tenant.locales}
    />
    <LocaleLanding
        websiteName={tenant.website.name}
        locale={defaultLocale}
        isDefaultLocale={true}
        sitemap={sitemap}
    />
</Layout>
