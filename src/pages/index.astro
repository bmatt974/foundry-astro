---
/**
 * Tenant root. By default redirects to `/{default_locale}/`. Append
 * `?debug=1` to render a small inspector showing the resolved tenant
 * context — useful when seeding a new site to confirm the middleware
 * matched the expected website + theme.
 */
export const prerender = false;

import { getTheme, listThemes } from '../themes/registry';

const tenant = Astro.locals.tenant;
const defaultLocale = tenant.defaultLocale ?? tenant.locales[0]?.locale ?? 'en';

if (Astro.url.searchParams.get('debug') !== '1') {
    return Astro.redirect(`/${defaultLocale}/`, 302);
}

const theme = getTheme(tenant.template);
const { Layout } = theme;
const registeredThemes = listThemes();
---

<Layout title={`${tenant.website.name} — debug`} locale={defaultLocale}>
    <h1 class="text-3xl font-bold mb-6">Foundry frontend — debug</h1>

    <section class="space-y-2 text-sm">
        <p>
            Resolved website: <code class="rounded bg-gray-100 px-1.5 py-0.5">{tenant.website.hostname}</code>
            <span class="ml-2 text-xs text-gray-500">(slug: <code class="rounded bg-gray-100 px-1.5 py-0.5">{tenant.website.slug}</code>)</span> —
            <strong>{tenant.website.name}</strong>
        </p>
        <p>
            Active template: <code class="rounded bg-gray-100 px-1.5 py-0.5">{tenant.template}</code>
            {!tenant.website.template && (
                <span class="ml-2 text-xs text-gray-500">(fallback — `Website.template` is null)</span>
            )}
        </p>
        <p>
            Registered themes: {registeredThemes.map((t) => <code class="mr-2 rounded bg-gray-100 px-1.5 py-0.5">{t}</code>)}
        </p>
        <p>
            Default locale: <code class="rounded bg-gray-100 px-1.5 py-0.5">{defaultLocale}</code>
        </p>
    </section>

    <h2 class="mt-8 text-lg font-semibold">Locales</h2>
    <ul class="list-disc pl-5 text-sm">
        {tenant.locales.map((l) => (
            <li>
                <a href={`/${l.locale}/`} class="brand-link">
                    {l.locale}
                </a>
                {l.is_default && <span class="ml-2 text-xs text-gray-500">(default)</span>}
                <span class="ml-2 text-xs text-gray-500">— {l.base_url}</span>
            </li>
        ))}
    </ul>
</Layout>
