---
/**
 * Single catch-all route. The Foundry CMS owns the URL → entity
 * map (via `sitemap-urls`) and tells Astro at build time what each
 * URL should render. Astro stays purely a dispatcher — no locale
 * resolution, no path parsing, no routing-mode logic.
 *
 * Trade-offs (see corresponding CMS commit + strategy doc): anti-
 * footprint wins (routing mode invisible from Astro), zero per-
 * entity-type Astro code (adding `/tags/` or `/categories/` becomes
 * API-only), at the cost of one extra round-trip for getStaticPaths
 * and a less-explicit mapping from URL to handler.
 *
 * Matches every URL the website serves including `/` (Astro's rest
 * segment captures empty path → `params.path` is `''`).
 */
export const prerender = true;

import {
    buildPathsGlobFilter,
    buildRefsFilter,
    fetchAuthorDetail,
    fetchPage,
    fetchSitemap,
    fetchSitemapUrls,
    type SitemapUrl,
} from '../lib/foundry';
import { useRoutes } from '../lib/routes';
import { pageUrl } from '../lib/seo';
import { getTheme } from '../themes/registry';

interface RouteProps {
    kind: Exclude<SitemapUrl['kind'], 'redirect'>;
    locale: string;
    ref: string;
}

export async function getStaticPaths() {
    const hostname = import.meta.env.WEBSITE_BUILD_HOSTNAME;
    if (!hostname) {
        return [];
    }

    const urls = await fetchSitemapUrls(hostname, {
        refs: buildRefsFilter(),
        pathsGlob: buildPathsGlobFilter(),
    });

    // `kind === 'redirect'` rows are owned by `astro.config.mjs`
    // `redirects:` field — the adapter emits provider-native rules
    // (Cloudflare `_redirects`, Vercel `vercel.json`, Netlify
    // `_redirects`) at HTTP level. Skipping them here avoids a
    // duplicate route conflict and a useless prerender pass.
    return urls
        .filter((url) => url.kind !== 'redirect')
        .map((url) => ({
            // Strip leading and trailing slashes — Astro's rest param
            // wants the relative path, so `/fr/colisee` → `'fr/colisee'`
            // and `/` → `''`.
            params: { path: url.path.replace(/^\/+/, '').replace(/\/+$/, '') },
            props: {
                kind: url.kind as Exclude<SitemapUrl['kind'], 'redirect'>,
                locale: url.locale,
                ref: url.ref,
            } satisfies RouteProps,
        }));
}

// In production builds the catch-all is prerendered and props come
// from `getStaticPaths` above. In `npm run dev` (SSR) those props
// are undefined, so we fall back to a runtime lookup against the
// same `sitemap-urls` endpoint — one extra round-trip per request,
// fine for local development and keeps the URL → (kind, ref, locale)
// resolution as ONE source of truth (the PHP controller).
const tenant = Astro.locals.tenant;
async function resolveRouteProps(): Promise<RouteProps | null> {
    const fromBuild = Astro.props as Partial<RouteProps>;
    if (fromBuild.kind) {
        return fromBuild as RouteProps;
    }
    const urls = await fetchSitemapUrls(tenant.website.hostname, {});
    const requestedPath = Astro.url.pathname;
    const match = urls.find((u) => u.path === requestedPath || u.path === `${requestedPath}/`);
    if (!match || match.kind === 'redirect') {
        return null;
    }
    return {
        kind: match.kind as Exclude<SitemapUrl['kind'], 'redirect'>,
        locale: match.locale,
        ref: match.ref,
    };
}
const resolved = await resolveRouteProps();
if (resolved === null) {
    // Internally route to the themed 404 page — the catch-all
    // matches every URL via `[...path]` so unmatched routes never
    // reach Astro's own 404 fallback. Rewriting hands rendering
    // off to `src/pages/404.astro` which keeps tenant + locale
    // context and sets `Astro.response.status = 404`.
    return Astro.rewrite('/404');
}
const { kind, locale, ref } = resolved;

// Mirror the props-driven locale on `Astro.locals` so deep
// components (Comparison block, formatters, byline) keep reading
// from the same handle they already use.
Astro.locals.locale = locale;

const theme = await getTheme(tenant.template);
const { Layout, LocaleSwitcher, LocaleLanding, Seo, Article, AuthorPage } = theme;

let pageData: Awaited<ReturnType<typeof fetchPage>> = null;
let authorDetail: Awaited<ReturnType<typeof fetchAuthorDetail>> = null;
let sitemap: Awaited<ReturnType<typeof fetchSitemap>> = [];

if (kind === 'page') {
    // The slug we hand to the API is the URL path WITHOUT the
    // locale's path_prefix segment. Strip it explicitly so the API
    // resolves against `page_translations.slug`, which doesn't
    // carry the prefix.
    const localeRow = tenant.locales.find((l) => l.locale === locale);
    const prefix = localeRow?.path_prefix?.replace(/^\/+/, '').replace(/\/+$/, '') ?? '';
    const fullPath = Astro.params.path ?? '';
    const slug = prefix !== '' && fullPath.startsWith(`${prefix}/`)
        ? fullPath.slice(prefix.length + 1)
        : fullPath;
    pageData = await fetchPage(locale, slug, tenant.website.hostname);
    if (!pageData) {
        return Astro.rewrite('/404');
    }
    Astro.locals.pagePublishedAt = pageData.published_at ?? pageData.translation?.published_at ?? null;
    // Hub / page / pattern-scoped injections live on the page
    // response; the Layout merges them with `tenant.injections`
    // (website-scope) at render time.
    Astro.locals.pageInjections = pageData.injections ?? [];
} else if (kind === 'author') {
    const slug = ref.startsWith('author:') ? ref.slice('author:'.length) : null;
    if (!slug) {
        return new Response('Bad author ref', { status: 500 });
    }
    authorDetail = await fetchAuthorDetail(locale, slug, tenant.website.hostname);
    if (!authorDetail) {
        return Astro.rewrite('/404');
    }
} else if (kind === 'landing') {
    sitemap = await fetchSitemap(locale, tenant.website.hostname);
}

const pageTitle = pageData?.translation?.meta_title
    ?? pageData?.translation?.title
    ?? authorDetail?.identity?.name
    ?? `${tenant.website.name} — ${locale}`;
const pageDescription = pageData?.translation?.meta_description
    ?? pageData?.translation?.snippet
    ?? authorDetail?.identity?.bio_short
    ?? authorDetail?.identity?.title
    ?? null;

// hreflang + canonical overrides for the author kind. Pages defer
// to Seo's default logic (reads `page.available_locales`); the
// landing kind has no per-locale alternate map (would need a
// network-wide sitemap to compute correctly — future work).
let authorAvailableLocales: { locale: string; slug: string }[] | undefined;
let authorCanonical: string | undefined;
if (kind === 'author' && authorDetail !== null) {
    const teamEntry = tenant.team.find((author) => author.slug === authorDetail!.slug);
    if (teamEntry) {
        authorAvailableLocales = Object.keys(teamEntry.translations).map((translationLocale) => {
            const localeRow = tenant.locales.find((l) => l.locale === translationLocale);
            return {
                locale: translationLocale,
                slug: useRoutes(localeRow).path('author', { slug: authorDetail!.slug }),
            };
        });
    }
    authorCanonical = pageUrl(tenant, locale, Astro.locals.route.path('author', { slug: authorDetail.slug })) ?? undefined;
}
---

<Layout title={pageTitle} description={pageDescription} locale={locale}>
    {/* Flat structure so the slot= directives reach Layout directly.
        Astro doesn't propagate slot= through Fragment wrappers, so
        nesting these per-kind blocks inside <> </> drops the head. */}

    {kind === 'page' && pageData && (
        <Seo slot="head" page={pageData} locale={locale} type="article" />
    )}
    {kind === 'author' && authorDetail && (
        <Seo
            slot="head"
            page={null}
            locale={locale}
            type="website"
            title={authorDetail.identity?.name ?? authorDetail.slug}
            description={pageDescription ?? undefined}
            availableLocales={authorAvailableLocales}
            canonicalUrl={authorCanonical}
        />
    )}
    {kind === 'landing' && (
        <Seo slot="head" page={null} locale={locale} type="website" />
    )}

    {kind === 'page' && pageData && (
        <LocaleSwitcher
            slot="locale-switcher"
            currentLocale={locale}
            websiteLocales={tenant.locales}
            pageLocales={pageData.available_locales}
        />
    )}
    {kind === 'author' && (
        <LocaleSwitcher
            slot="locale-switcher"
            currentLocale={locale}
            websiteLocales={tenant.locales}
            pageLocales={authorAvailableLocales}
        />
    )}
    {kind === 'landing' && (
        <LocaleSwitcher
            slot="locale-switcher"
            currentLocale={locale}
            websiteLocales={tenant.locales}
        />
    )}

    {kind === 'page' && pageData && <Article page={pageData} locale={locale} />}
    {kind === 'author' && authorDetail && (
        <AuthorPage
            author={{
                slug: authorDetail.slug,
                name: authorDetail.identity?.name ?? authorDetail.slug,
                title: authorDetail.identity?.title ?? null,
                bioShort: authorDetail.identity?.bio_short ?? null,
                bio: authorDetail.identity?.bio ?? null,
                photoUrl: authorDetail.photo_url,
                externalUrl: authorDetail.external_url,
                twitterHandle: authorDetail.twitter_handle,
            }}
            articles={authorDetail.articles}
            locale={locale}
        />
    )}
    {kind === 'landing' && (
        <LocaleLanding
            websiteName={tenant.website.name}
            locale={locale}
            isDefaultLocale={tenant.defaultLocale === locale}
            sitemap={sitemap}
        />
    )}
</Layout>
